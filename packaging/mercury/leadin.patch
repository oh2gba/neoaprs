+/* --- TX lead-in tone (ms) played ahead of the preamble; 0 = none. */
+static _Atomic int g_tx_leadin_ms = 0;
+
+void modem_set_tx_leadin_ms(int leadin_ms)
+{
+    if (leadin_ms < 0)    leadin_ms = 0;
+    if (leadin_ms > 1000) leadin_ms = 1000;
+    atomic_store(&g_tx_leadin_ms, leadin_ms);
+}
+
+int modem_get_tx_leadin_ms(void)
+{
+    return atomic_load(&g_tx_leadin_ms);
+}

+#define TX_LEADIN_TONE_HZ  1000.0   /* the tuning tone's pitch: inside every SSB filter */
+#define TX_LEADIN_RAMP_MS  5        /* raised-cosine ramp at each end: no click */
+
+/* Fill `n` samples with the lead-in tone: a sine at the RMS level of the
+ * `burst_n` samples of burst audio that follow it, so the radio is driven as
+ * hard for the tone as for the frame. */
+static void fill_leadin(int32_t *dst, int n, const int32_t *burst, size_t burst_n)
+{
+    static const double PI = 3.14159265358979323846;
+    double sum = 0.0;
+    for (size_t i = 0; i < burst_n; i++)
+        sum += (double)burst[i] * (double)burst[i];
+    double amp = burst_n ? sqrt(2.0 * sum / (double)burst_n) : 0.0;
+    if (amp > 2147483647.0) amp = 2147483647.0;
+    int ramp = FREEDV_FS_8000 * TX_LEADIN_RAMP_MS / 1000;
+    if (ramp > n / 2) ramp = n / 2;
+    for (int i = 0; i < n; i++)
+    {
+        double env = 1.0;
+        if (i < ramp)          env = 0.5 - 0.5 * cos(PI * i / ramp);
+        else if (i >= n - ramp) env = 0.5 - 0.5 * cos(PI * (n - 1 - i) / ramp);
+        dst[i] = (int32_t)(amp * env * sin(2.0 * PI * TX_LEADIN_TONE_HZ * i / FREEDV_FS_8000));
+    }
+}

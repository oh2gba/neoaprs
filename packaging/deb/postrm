#!/bin/sh
# The files of the package go with it, and so does what Python made beside them. The data of the users (~/.local/share/neoaprs) and the service units in their homes are not ours to remove.
set -e

case "$1" in
    remove|purge|disappear)
        rm -rf "${DPKG_ROOT:-}/opt/neoaprs"
        ;;
esac
case "$1" in
    remove)
        cat <<'TEXT'
neoaprs: your data in ~/.local/share/neoaprs is left. A service made by `neoaprs service install` is left too and can no longer start; to take it away:
    systemctl --user disable --now neoaprs && rm ~/.config/systemd/user/neoaprs.service
TEXT
        ;;
esac

exit 0

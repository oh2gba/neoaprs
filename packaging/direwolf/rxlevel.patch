  *----------------------------------------------------------------*/
 
 
+/*
+ * NeoAPRS: -R ms, the receive level of channel 0 every ms milliseconds of audio read, as "RXLEVEL 0 = N" on a line of its own
+ * (packaging/direwolf/rxlevel.patch).  The samples read are counted, so no timer of the system is needed and it is the same on
+ * every system; the level is demod_get_audio_level's, the one of the statistics line, which no transmit level (-G) scales.
+ */
+
+static int level_ms = 0;
+static struct audio_s *level_audio = NULL;
+static long level_count = 0;
+
+void audio_stats_level_init (int ms, struct audio_s *pa)
+{
+	level_ms = ms;
+	level_audio = pa;
+	level_count = 0;
+}
+
+static void audio_stats_level (int adev, int nsamp)
+{
+	long every;
+
+	if (level_ms <= 0 || level_audio == NULL || adev != 0 || nsamp <= 0) {
+	  return;
+	}
+	every = (long) level_audio->adev[0].samples_per_sec * level_ms / 1000;
+	if (every < 1) {
+	  every = 1;
+	}
+	level_count += nsamp;
+	if (level_count >= every) {
+	  alevel_t alevel0 = demod_get_audio_level (ADEVFIRSTCHAN(0), 0);
+
+	  level_count %= every;
+	  text_color_set(DW_COLOR_DEBUG);
+	  dw_printf ("RXLEVEL 0 = %d\n", alevel0.rec);
+	}
+}
+
+
 void audio_stats (int adev, int nchan, int nsamp, int interval)
 {
+	audio_stats_level (adev, nsamp);	/* NeoAPRS: -R (rxlevel.patch), whether or not -a is given */
+
 
 	/* Gather numbers for read from audio device. */
 

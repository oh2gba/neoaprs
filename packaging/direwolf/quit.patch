 	xmit_init (&audio_config, d_p_opt);
 
 /*
+ * NeoAPRS: -Q.  The thread that watches standard input starts once the keying is set up (ptt_init, in xmit_init), so that its cleanup can set
+ * every output to 0, and before the -x calibration run and before any network port opens.  Audio read from standard input ends the program
+ * at its own end of file already.
+ */
+	if (Q_opt && strcmp(audio_config.adev[0].adevice_in, "stdin") != 0) {
+#if __WIN32__
+	  if (_beginthreadex (NULL, 0, quit_at_end_of_input, NULL, 0, NULL) == 0) {
+#else
+	  pthread_t quit_tid;
+	  if (pthread_create (&quit_tid, NULL, quit_at_end_of_input, NULL) != 0) {
+#endif
+	    text_color_set(DW_COLOR_ERROR);
+	    dw_printf ("Could not start the thread that watches standard input (-Q).\n");
+	    exit (1);
+	  }
+	}

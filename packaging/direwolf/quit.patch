@@ -143,6 +143,33 @@
 
 static void usage (void);
 
+
+/* NeoAPRS: -Q, the end of standard input ends the program as a Ctrl-C does: QRT, every keying output set to 0, a second, exit 0 (packaging/direwolf/quit.patch). */
+/* The program that started Direwolf closes the pipe to stop it, and a program that dies closes it too, so the radio is never left keyed. */
+
+static int Q_opt = 0;
+
+#if __WIN32__
+#include <process.h>
+static unsigned __stdcall quit_at_end_of_input (void *arg)
+#else
+static void * quit_at_end_of_input (void *arg)
+#endif
+{
+	char buffer[256];
+
+	(void)arg;
+	while (fread (buffer, 1, sizeof(buffer), stdin) > 0) {
+	}
+#if __WIN32__
+	cleanup_win (CTRL_C_EVENT);
+	return (0);
+#else
+	cleanup_linux (0);
+	return (NULL);
+#endif
+}
+

# Text is stored and checked out with LF on every system (a Windows checkout with CRLF would break the tests that compare bytes and the page build);
# what is binary is never converted.
* text=auto eol=lf
*.png binary
*.bin binary
*.pbf binary
*.pmtiles binary
*.sqlite binary
*.kiss binary
# what a TNC or a radio prints of the packets it hears, kept byte for byte with its own line ends (CR, CR LF, LF): tests/test_tnc2text.py
tests/fixtures/text/*.txt binary

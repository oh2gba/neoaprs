#!/usr/bin/env python3
"""Print the layer table and the allowed-exceptions lists of tests/test_architecture.py.
scripts/doc-arch            print every block
scripts/doc-arch --write    rewrite the blocks of docs/ARCHITECTURE.md
scripts/doc-arch --check    exit 1 and name the blocks that are out of date"""

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

DOCUMENT = ROOT / "docs" / "ARCHITECTURE.md"


def main() -> int:
    parser = argparse.ArgumentParser(
        description="the tables of docs/ARCHITECTURE.md, made from tests/test_architecture.py"
    )
    parser.add_argument("--write", action="store_true", help="make the blocks of docs/ARCHITECTURE.md again")
    parser.add_argument(
        "--check", action="store_true", help="exit 1 when a block of docs/ARCHITECTURE.md is out of date"
    )
    args = parser.parse_args()
    # This imports the test, which needs pytest; --help does not.
    from tests.support import archdoc

    text = DOCUMENT.read_text()
    if args.write:
        DOCUMENT.write_text(archdoc.refreshed(text))
        return 0
    if args.check:
        stale = archdoc.stale_blocks(text)
        if stale:
            print(f"docs/ARCHITECTURE.md: out of date: {', '.join(stale)} (scripts/doc-arch --write)", file=sys.stderr)
        return 1 if stale else 0
    for name, make in archdoc.MAKERS.items():
        print(f"<!-- doc-arch:{name} -->\n{make()}<!-- /doc-arch -->\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())

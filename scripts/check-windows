#!/usr/bin/env python3
"""Run the CI's two Windows jobs on a real Windows in a VirtualBox machine, over SSH.

What fails on GitHub's windows-2025 then fails here first.

  scripts/check-windows                    sync, lock, ruff, pytest and smoke, each with its result
                                           line
  scripts/check-windows --only NAME        only the named steps (repeatable); ruff and pytest need
                                           sync
  scripts/check-windows -- ARGS...         ARGS go to pytest, which is then the one step that runs
  scripts/check-windows --snapshot NAME    restore snapshot NAME first (machine must be powered off)
  scripts/check-windows --tty              run the pytest step in a console session straight away
  scripts/check-windows --install SETUP --snapshot NAME
                                           install proof: run the installer silently on the clean
                                           machine, then check the app's pieces and the uninstall
  scripts/check-windows --upgrade OLD NEW --snapshot NAME
                                           upgrade proof: install OLD, make a station, update to NEW

The machine comes from the environment; nothing is guessed (CONVENTIONS.md has the table):
  NEOAPRS_WINVM              VirtualBox name of the machine; unset means "not set up here" (exit 2)
  NEOAPRS_WINVM_SSH_PORT     local port forwarded to the machine's SSH (reached at 127.0.0.1)
  NEOAPRS_WINVM_SSH_KEY      private key path, passed to ssh and never read
  NEOAPRS_WINVM_KNOWN_HOSTS  known_hosts file with the machine's host key (no trust on first use)
  NEOAPRS_WINVM_USER         user on the machine, default John (profile C:\\Users\\USER)
This is never a stage of scripts/check: it needs a machine that only some developers have.

The machine. A powered-off machine is started headless and the script waits until its SSH answers
and it has been up for two minutes (Windows restarts its SSH service in the first minute). A machine
this run started is shut down at the end from inside over SSH, then by the ACPI power button; never a
hard power-off. A machine that was already running is left running. One run at a time per machine
(a lock file in $NEOAPRS_BUILD_CACHE, default ~/.cache/neoaprs-build).

The tree. It is packed as it is on disk by scripts/check-in-container, copied with scp and unpacked
with Windows's tar.exe into C:\\Users\\USER\\neoaprs-check\\RUN-<UTC time>\\neoaprs; older runs but the
newest two are removed. There the tree is a git repository of one commit made of the tracked files.
uv lives in C:\\Users\\USER\\neotest\\uv and is replaced when it is not the pinned version (UV, checked
against its SHA-256); it fetches its own Python of the version ci.yml names (UV_PYTHON).

The steps are the CI's commands in the order of ci.yml, written in PowerShell, each with the
environment NEOAPRS_NO_DEVICES=1, NEOAPRS_UPDATE_CHECK=0, UV_PYTHON_PREFERENCE=only-managed. Each
prints a line as scripts/check does; under a failed step comes the end of its output, and every
step's whole log is kept on this computer. Commands go over as one PowerShell script in
-EncodedCommand form, so no name or path is read by two shells.

Console. Some tests end a child with Ctrl+Break (tests/support/proc.py), which Windows delivers only
inside a console. Before the pytest step a probe tries that in a plain `ssh HOST COMMAND` session;
if it fails, the step runs through `ssh -tt` (a pseudo console) and its output is stripped of escape
sequences. --tty skips the plain try.

The install proof (--install) is the scripted part of the clean install that every Windows trim must
pass (docs/development.md). Steps: install, defender, daemon, commands, app, map, direwolf, smoke,
mercury and uninstall. Nothing follows a failed install.

The upgrade proof (--upgrade OLD NEW) shows that a station of the release before comes through the
update. Steps, each needing the one before: old, station, update, migrate, data, daemon and
uninstall. The data folder is the run's own (data-upgrade), never the default one. The version in
OLD's file name decides how the station is made and what is held afterwards (RADIOS_FROM): before
0.20.0 a radio's settings are flat keys; from 0.20.0 on there are radios and no flat key of one.

What only a person can see (the wizard, the tray, Update now) is in docs/development.md.

Exit code: 0 all steps passed, 1 a step failed, 2 not set up (a variable, a file, a program, a tree
that cannot be packed, a machine in no state to be used, a second run, no answer from the machine).
Needs Linux, ssh, scp, VBoxManage and git."""

import argparse
import base64
import contextlib
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import os
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
from collections.abc import Callable, Iterator, Mapping, Sequence
from dataclasses import dataclass
from pathlib import Path
from types import FrameType, ModuleType
from typing import NamedTuple

SCRIPTS = Path(__file__).resolve().parent
ROOT = SCRIPTS.parent
NOT_SET_UP = 2
LOOPBACK = "127.0.0.1"
KEEP_RUNS = 2  # runs kept on the machine: this one and the one before
TAIL_LINES = 40  # lines of a failed step's output shown under its line
SSH_PATIENCE_SEC = 300.0  # a powered-off Windows answers SSH after a minute or two
# Time a machine this run started must be up before the steps begin (its SSH service restarts in its
# first minute).
SETTLED_SEC = 120.0
UPTIME_SCRIPT = "[int]((Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime).TotalSeconds; exit 0"
OFF_PATIENCE_SEC = 300.0  # and shuts down in about as long
# cmd.exe, which may be the SSH shell, takes 8191 characters per line
REMOTE_LINE_MAX = 8000
NEVER_STOPS = float("inf")
SHUTDOWN_SCRIPT = "shutdown.exe /s /t 0 /f; exit 0"  # at once, closing programs that would hold it


class Pin(NamedTuple):
    version: str
    url: str
    sha256: str
    file: str


# uv for Windows, taken only when its SHA-256 is this one (the pin is the trust, not the server).
UV = Pin(
    "0.11.26",
    "https://github.com/astral-sh/uv/releases/download/0.11.26/uv-x86_64-pc-windows-msvc.zip",
    "4e1278ede866be6c0bf32d2f466cc6de7a9fb399ecf20c9ce2d186e52424be47",
    "uv-x86_64-pc-windows-msvc.zip",
)

VARIABLES = ("NEOAPRS_WINVM_SSH_PORT", "NEOAPRS_WINVM_SSH_KEY", "NEOAPRS_WINVM_KNOWN_HOSTS")
# Steps use the Python that ci.yml names (UV_PYTHON); left to uv, a clean machine takes the newest
# one the project allows.
PYTHON = "3.13"
STEP_ENVIRONMENT = {
    "NEOAPRS_NO_DEVICES": "1",
    "NEOAPRS_UPDATE_CHECK": "0",
    "UV_PYTHON_PREFERENCE": "only-managed",
    "UV_PYTHON": PYTHON,
}
NEEDS_THE_ENVIRONMENT = ("ruff", "pytest")  # steps that run in the .venv that sync makes


def say(text: str) -> None:
    print(f"check-windows: {text}", file=sys.stderr, flush=True)


class NotSetUp(Exception):
    """Why the check cannot run, as the sentence the user is told (exit code 2)."""


def load_script(name: str) -> ModuleType:
    """Load a tool of this folder that has no .py suffix as a module."""
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(SCRIPTS / name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# ---- where the machine is ----


@dataclass(frozen=True)
class Settings:
    vm: str
    port: int
    key: Path
    known_hosts: Path
    user: str


def read_settings(env: Mapping[str, str]) -> Settings:
    """Return the machine named by the environment, or raise NotSetUp; only the user has a
    default."""
    vm = env.get("NEOAPRS_WINVM", "").strip()
    if not vm:
        raise NotSetUp(
            "the Windows check is not set up on this machine: it needs NEOAPRS_WINVM (the VirtualBox name of the Windows machine), NEOAPRS_WINVM_SSH_PORT, NEOAPRS_WINVM_SSH_KEY and "
            "NEOAPRS_WINVM_KNOWN_HOSTS, and NEOAPRS_WINVM_USER when the user there is not John"
        )
    if vm.startswith("-"):
        raise NotSetUp(
            f"NEOAPRS_WINVM is {vm!r}, which VBoxManage would read as an option: the name of the machine does not begin with a dash"
        )
    missing = [name for name in VARIABLES if not env.get(name, "").strip()]
    if missing:
        raise NotSetUp(f"NEOAPRS_WINVM is set, and {' and '.join(missing)} {'is' if len(missing) == 1 else 'are'} not")
    port_text = env["NEOAPRS_WINVM_SSH_PORT"].strip()
    if not port_text.isascii() or not port_text.isdigit() or not 0 < int(port_text) < 65536:
        raise NotSetUp(f"NEOAPRS_WINVM_SSH_PORT is {port_text!r}, which is not a port number")
    user = env.get("NEOAPRS_WINVM_USER", "").strip() or "John"
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", user):
        raise NotSetUp(
            f"NEOAPRS_WINVM_USER is {user!r}: a user name here is letters, digits, dots, dashes and underscores"
        )
    known_hosts = env["NEOAPRS_WINVM_KNOWN_HOSTS"].strip()
    if '"' in known_hosts:
        raise NotSetUp("NEOAPRS_WINVM_KNOWN_HOSTS has a double quote in it, which ssh cannot be given in an option")
    return Settings(vm, int(port_text), Path(env["NEOAPRS_WINVM_SSH_KEY"].strip()), Path(known_hosts), user)


def missing_files(settings: Settings) -> list[str]:
    """The sentences for the files that are not there: the key and the known_hosts file."""
    return [
        f"{name} is {path}, which is not a file"
        for name, path in (("NEOAPRS_WINVM_SSH_KEY", settings.key), ("NEOAPRS_WINVM_KNOWN_HOSTS", settings.known_hosts))
        if not path.is_file()
    ]


def build_cache(env: Mapping[str, str]) -> Path:
    """Return the build cache, where scripts/security-tools keeps its programs."""
    base = env.get("NEOAPRS_BUILD_CACHE") or Path(env.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "neoaprs-build"
    return Path(base) / "check-windows"


# ---- command lines ----


def option_value(path: Path) -> str:
    """Return a path as an ssh option value, in double quotes when it has a space."""
    text = str(path)
    return f'"{text}"' if any(char.isspace() for char in text) else text


def ssh_options(settings: Settings) -> list[str]:
    """Return the options ssh and scp share: the key only, no prompt, no unknown host key, a connect
    timeout."""
    return [
        "-i",
        str(settings.key),
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        "BatchMode=yes",
        "-o",
        f"UserKnownHostsFile={option_value(settings.known_hosts)}",
        "-o",
        "ConnectTimeout=10",
        "-o",
        "ServerAliveInterval=15",
    ]


def ssh_command(settings: Settings, remote: str, tty: bool = False) -> list[str]:
    """Return ssh with the command line for the machine's shell; `tty` (-tt) gives it a console."""
    return [
        "ssh",
        *ssh_options(settings),
        "-p",
        str(settings.port),
        *(["-tt"] if tty else []),
        f"{settings.user}@{LOOPBACK}",
        remote,
    ]


def scp_command(settings: Settings, local: Path, remote_path: str) -> list[str]:
    """Return scp of one file to a path on the machine, written with forward slashes."""
    return [
        "scp",
        *ssh_options(settings),
        "-P",
        str(settings.port),
        str(local),
        f"{settings.user}@{LOOPBACK}:{remote_path}",
    ]


def ps_quote(text: str) -> str:
    """Return a PowerShell single-quoted string; typographic quotes count as quotes there, so double
    them too."""
    return "'" + "".join(char * 2 if char in "'\u2018\u2019\u201a\u201b" else char for char in text) + "'"


class Raw(str):
    """A piece of a PowerShell command that is an expression and is not quoted."""


def encode_powershell(script: str) -> str:
    return base64.b64encode(script.encode("utf-16-le")).decode("ascii")


def powershell_line(script: str) -> str:
    """Return a command line that runs a script in any shell sshd starts: Base64, so no quoting.

    The execution policy is bypassed for this line only."""
    return f"powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -OutputFormat Text -EncodedCommand {encode_powershell(script)}"


def ssh_script(settings: Settings, script: str, tty: bool = False) -> list[str]:
    return ssh_command(settings, powershell_line(script), tty)


class Paths(NamedTuple):
    """Where things are on the machine, Windows paths (the profile folder is C:\\Users\\USER)."""

    home: str
    root: str  # the folders of the runs
    run: str
    tree: str  # the tree, a repository when git is there
    tar: str
    uv_dir: str
    uv_zip: str


def windows_paths(user: str, run_name: str) -> Paths:
    home = f"C:\\Users\\{user}"
    root = f"{home}\\neoaprs-check"
    run = f"{root}\\{run_name}"
    return Paths(home, root, run, f"{run}\\neoaprs", f"{run}-tree.tar", f"{home}\\neotest\\uv", f"{root}\\{UV.file}")


def scp_path(windows_path: str) -> str:
    return windows_path.replace("\\", "/")


def run_name(now: float) -> str:
    """The folder of a run: its UTC time, which sorts as time does."""
    return time.strftime("RUN-%Y%m%dT%H%M%S", time.gmtime(now))


RUN_NAME = re.compile(r"RUN-\d{8}T\d{6}")


def runs_to_remove(names: Sequence[str], keep: int = KEEP_RUNS) -> list[str]:
    """Return the names of runs but the newest `keep`, oldest first; other folders are left
    alone."""
    runs = sorted(name.strip() for name in names if RUN_NAME.fullmatch(name.strip()))
    return runs[: max(0, len(runs) - keep)]


def native(program: str, *arguments: str) -> list[str]:
    """Return lines that run a program, pass its output on as text and exit with its code if not 0.

    The error stream is merged: PowerShell 5.1 turns what a program writes there into errors."""
    call = "& " + " ".join(
        argument if isinstance(argument, Raw) else ps_quote(argument) for argument in (program, *arguments)
    )
    return [f'{call} 2>&1 | ForEach-Object {{ "$_" }}', "if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }"]


# GitHub's Windows runner has sh and bash of Git for Windows on its PATH and tests start them. An
# SSH session gets only Git\cmd, so the folder of sh and bash is added where it exists.
GIT_TOOLS_ON_THE_PATH = "$gitBin = Join-Path $env:ProgramFiles 'Git\\bin'; if (Test-Path -LiteralPath $gitBin) { $env:Path = $env:Path + ';' + $gitBin }"


def preamble(paths: Paths, frozen: bool = True, folder: str | None = None) -> list[str]:
    """Return the start of a step's script: the environment, uv first on the PATH, the tree's
    folder."""
    lines = ["$ErrorActionPreference = 'Stop'", "$ProgressPreference = 'SilentlyContinue'"]
    lines += [f"$env:{name} = {ps_quote(value)}" for name, value in STEP_ENVIRONMENT.items()]
    lines.append("$env:UV_FROZEN = '1'" if frozen else "Remove-Item Env:UV_FROZEN -ErrorAction SilentlyContinue")
    lines += [
        f"$env:Path = {ps_quote(paths.uv_dir + ';')} + $env:Path",
        GIT_TOOLS_ON_THE_PATH,
        f"Set-Location -LiteralPath {ps_quote(folder or paths.tree)}",
        "$ErrorActionPreference = 'Continue'",
    ]
    return lines


@dataclass(frozen=True)
class Step:
    name: str
    # each a program and its arguments, run in turn until one fails
    commands: tuple[tuple[str, ...], ...]
    frozen: bool = True  # UV_FROZEN=1, as the workflow has it
    timeout_sec: float = 900.0


def steps(paths: Paths, pytest_args: Sequence[str] = ()) -> list[Step]:
    """Return the steps in order: the commands of ci.yml's jobs `python` (without mypy) and
    `smoke`."""
    venv = f"{paths.run}\\smoke-venv"
    python, command = f"{venv}\\Scripts\\python.exe", f"{venv}\\Scripts\\neoaprs.exe"
    wheel = Raw("(Get-ChildItem -LiteralPath 'dist' -Filter '*.whl').FullName")
    return [
        Step("sync", (("uv", "sync", "--frozen", "--extra", "app", "--extra", "ble"),)),
        Step("lock", (("uv", "lock", "--check"),), frozen=False, timeout_sec=300.0),
        Step("ruff", (("uv", "run", "ruff", "check", "."),), timeout_sec=300.0),
        Step(
            "pytest",
            (("uv", "run", "pytest", "-n", "auto", "-p", "no:cacheprovider", *pytest_args),),
            timeout_sec=2400.0,
        ),
        Step(
            "smoke",
            (
                ("uv", "build", "--wheel"),
                ("uv", "venv", venv),
                ("uv", "pip", "install", "--python", python, wheel),
                (python, "scripts\\smoke.py", "--command", command),
            ),
        ),
    ]


def step_script(paths: Paths, step: Step) -> str:
    lines = preamble(paths, step.frozen)
    for command in step.commands:
        lines += native(*command)
    return "\n".join([*lines, "exit 0"])


def chosen_steps(only: Sequence[str]) -> list[str]:
    """Return the names to run in CI order: all when none is chosen; sync joins ruff and pytest."""
    names = list(only) or [step.name for step in steps(windows_paths("x", "x"))]
    if any(name in names for name in NEEDS_THE_ENVIRONMENT) and "sync" not in names:
        names.append("sync")
    return [step.name for step in steps(windows_paths("x", "x")) if step.name in names]


# Probe of the console: a child in its own process group must end on Ctrl+Break (as
# tests/support/proc.py does).
CONSOLE_PROBE = (
    "import signal,subprocess,sys,time; p=subprocess.Popen([sys.executable,'-c','import time; time.sleep(60)'],creationflags=subprocess.CREATE_NEW_PROCESS_GROUP); time.sleep(1); "
    "p.send_signal(signal.CTRL_BREAK_EVENT); time.sleep(3); code=p.poll(); p.kill(); print('Ctrl+Break ended the child:', code is not None); sys.exit(0 if code is not None else 1)"
)


def probe_script(paths: Paths) -> str:
    python = f"{paths.tree}\\.venv\\Scripts\\python.exe"
    return "\n".join([*preamble(paths), *native(python, "-c", CONSOLE_PROBE), "exit 0"])


def stop_script(folder: str) -> str:
    """End every process whose command line names the run's folder, what a given-up step left
    behind."""
    return (
        "Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like ('*' + "
        + ps_quote(folder)
        + " + '*') -and $_.ProcessId -ne $PID } | "
        "ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; exit 0"
    )


def prepare_script(paths: Paths) -> str:
    """Unpack the tar into the run's folder and, where git exists, make the tree a one-commit
    repository (never fails the run)."""
    tar = "$env:SystemRoot + '\\System32\\tar.exe'"
    git_lines = [
        "$git = Get-Command git.exe -ErrorAction SilentlyContinue",
        "if ($git) { try {",
        f"  Set-Location -LiteralPath {ps_quote(paths.tree)}",
        "  & git.exe -c core.autocrlf=false init --quiet --initial-branch=master . 2>&1 | Out-Null",
        f"  & git.exe -c core.autocrlf=false add --force --pathspec-from-file={ps_quote(paths.run + chr(92) + 'tracked')} --pathspec-file-nul 2>&1 | Out-Null",
        "  & git.exe -c user.name=runner -c user.email=runner@localhost -c commit.gpgsign=false commit --quiet --allow-empty --message='The tree as it was on disk' 2>&1 | Out-Null",
        "} catch { } }",
    ]
    return "\n".join(
        [
            "$ErrorActionPreference = 'Stop'",
            "$ProgressPreference = 'SilentlyContinue'",
            f"New-Item -ItemType Directory -Force -Path {ps_quote(paths.root)} | Out-Null",
            f"New-Item -ItemType Directory -Path {ps_quote(paths.run)} | Out-Null",
            f"& ({tar}) -xf {ps_quote(paths.tar)} -C {ps_quote(paths.run)}",
            "if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
            f"Remove-Item -LiteralPath {ps_quote(paths.tar)}",
            "$ErrorActionPreference = 'Continue'",
            *git_lines,
            "exit 0",
        ]
    )


def uv_version_script(paths: Paths) -> str:
    return "\n".join(
        [
            "$ErrorActionPreference = 'SilentlyContinue'",
            f'& {ps_quote(paths.uv_dir + chr(92) + "uv.exe")} --version 2>&1 | ForEach-Object {{ "$_" }}',
            "exit 0",
        ]
    )


def uv_unpack_script(paths: Paths) -> str:
    tar = "$env:SystemRoot + '\\System32\\tar.exe'"
    return "\n".join(
        [
            "$ErrorActionPreference = 'Stop'",
            f"New-Item -ItemType Directory -Force -Path {ps_quote(paths.uv_dir)} | Out-Null",
            f"& ({tar}) -xf {ps_quote(paths.uv_zip)} -C {ps_quote(paths.uv_dir)}",
            "if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
            f"Remove-Item -LiteralPath {ps_quote(paths.uv_zip)}",
            "exit 0",
        ]
    )


def listing_script(paths: Paths) -> str:
    return f"Get-ChildItem -LiteralPath {ps_quote(paths.root)} -Directory -Name -ErrorAction SilentlyContinue; exit 0"


def removal_script(paths: Paths, names: Sequence[str]) -> str:
    """Remove the folders of old runs; a folder that cannot be removed is left."""
    return "\n".join(
        [
            f"Remove-Item -LiteralPath {ps_quote(paths.root + chr(92) + name)} -Recurse -Force -ErrorAction SilentlyContinue"
            for name in names
            if RUN_NAME.fullmatch(name)
        ]
        + ["exit 0"]
    )


def uv_version_ok(output: str, pin: Pin = UV) -> bool:
    """Whether what `uv --version` printed names the pinned version."""
    found = re.match(r"uv (\S+)", output.strip())
    return found is not None and found.group(1) == pin.version


# ---- the output and the result lines ----

ESCAPES = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[()][A-Za-z0-9]|\x1b[=>]")


def clean_output(text: str) -> str:
    """Strip what a console session adds: escape sequences, carriage returns, text a bare CR
    overwrote."""
    lines = ESCAPES.sub("", text).replace("\r\n", "\n").split("\n")
    return "\n".join(line.rsplit("\r", 1)[-1] for line in lines)


@dataclass(frozen=True)
class StepResult:
    name: str
    code: int
    seconds: float
    log: Path
    tail: tuple[str, ...] = ()


def result_line(result: StepResult) -> str:
    """The line of scripts/check: `ok` or `FAIL`, the name, the seconds in tenths."""
    tenths = int(result.seconds * 10 + 0.5)
    return f"{'ok' if result.code == 0 else 'FAIL':<5} {result.name:<12} {tenths // 10:4d}.{tenths % 10}s"


def report_lines(result: StepResult) -> list[str]:
    """The result line, and under a failed step the end of its output and where the whole is."""
    if result.code == 0:
        return [result_line(result)]
    return [result_line(result), *(f"      | {line}" for line in result.tail), f"      (the whole log: {result.log})"]


def exit_code(results: Sequence[StepResult]) -> int:
    return 1 if any(result.code != 0 for result in results) else 0


def summary(results: Sequence[StepResult], seconds: float) -> str:
    failed = [result.name for result in results if result.code != 0]
    return f"failed in {int(seconds)}s: {' '.join(failed)}" if failed else f"all green in {int(seconds)}s"


# ---- power and the lock ----


class Refused(Exception):
    """The machine cannot be used as asked: the sentence for the user (exit code 2)."""


class Busy(Exception):
    """Another run holds the lock."""


START_FROM = ("poweroff", "aborted", "saved", "aborted-saved")


@dataclass(frozen=True)
class PowerPlan:
    restore: bool  # the snapshot is put back before the start
    # this run starts the machine, and so shuts it down at the end
    start: bool


def plan_power(state: str, snapshot: str, vm: str = "the machine") -> PowerPlan:
    """What a run does about power. A running machine is used and left running and never restored to
    a snapshot; a machine that is off is started and shut down by the run that started it; one in
    between is not touched."""
    if state == "running":
        if snapshot:
            raise Refused(
                f"--snapshot puts a machine back only while it is powered off, and {vm} is running: shut it down first"
            )
        return PowerPlan(restore=False, start=False)
    if state in START_FROM:
        return PowerPlan(restore=bool(snapshot), start=True)
    raise Refused(
        f"{vm} is {state or 'in a state VBoxManage did not tell'}: it is used when it is running or powered off, so wait or finish what it does and run again"
    )


def parse_vm_state(output: str) -> str:
    """The state from `VBoxManage showvminfo --machinereadable`: the line `VMState="running"`."""
    found = re.search(r'^VMState="([^"]*)"', output, re.MULTILINE)
    return found.group(1) if found else ""


def lock_path(env: Mapping[str, str], vm: str) -> Path:
    """Return the machine's lock file in the build cache, named with non-alphanumerics made
    dashes."""
    return build_cache(env) / "locks" / (re.sub(r"[^A-Za-z0-9._]", "-", vm) + ".lock")


@contextlib.contextmanager
def run_lock(path: Path) -> Iterator[None]:
    """Hold the lock of a machine for the run; it goes when the run ends."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise Busy(f"another run of this script holds {path}: one run at a time on a machine") from None
        yield


def wait_for(
    done: Callable[[], bool],
    patience_sec: float,
    interval_sec: float = 5.0,
    sleep: Callable[[float], None] = time.sleep,
    clock: Callable[[], float] = time.monotonic,
) -> bool:
    """Asks `done` until it says yes (True) or the patience is over (False)."""
    deadline = clock() + patience_sec
    while not done():
        if clock() >= deadline:
            return False
        sleep(interval_sec)
    return True


def vboxmanage(*arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["VBoxManage", *arguments], capture_output=True, text=True)


def vm_state(vm: str) -> str:
    return parse_vm_state(vboxmanage("showvminfo", vm, "--machinereadable").stdout)


def last_line(text: str) -> str:
    return (text.strip().splitlines() or ["it said nothing"])[-1]


def start_vm(settings: Settings, plan: PowerPlan, snapshot: str) -> None:
    """Restore the snapshot if asked, start the machine headless and wait until its SSH answers."""
    if plan.restore:
        say(f"putting {settings.vm} back to the snapshot {snapshot}")
        done = vboxmanage("snapshot", settings.vm, "restore", snapshot)
        if done.returncode != 0:
            raise Refused(f"the snapshot {snapshot} could not be put back ({last_line(done.stderr or done.stdout)})")
    say(f"starting {settings.vm} without a window")
    done = vboxmanage("startvm", settings.vm, "--type", "headless")
    if done.returncode != 0:
        raise Refused(f"{settings.vm} could not be started ({last_line(done.stderr or done.stdout)})")


def ssh_answers(settings: Settings) -> bool:
    return subprocess.run(ssh_script(settings, "exit 0"), stdin=subprocess.DEVNULL, capture_output=True).returncode == 0


def wait_for_ssh(settings: Settings, patience_sec: float = SSH_PATIENCE_SEC, interval_sec: float = 5.0) -> None:
    say(f"waiting for the SSH of {settings.vm} to answer (up to {int(patience_sec)} s)")
    if not wait_for(lambda: ssh_answers(settings), patience_sec, interval_sec):
        raise Refused(
            f"the SSH of {settings.vm} did not answer within {int(patience_sec)} s (port {settings.port}, user {settings.user}): is the machine's forward and its sshd right? try the ssh line by hand"
        )


def uptime_sec(settings: Settings) -> float | None:
    """Return seconds the machine has been up; None if it cannot be asked, infinity if its answer is
    no number."""
    done = ssh_run(settings, UPTIME_SCRIPT, timeout_sec=60.0)
    if done.returncode != 0:
        return None
    words = done.stdout.split()
    return float(words[-1]) if words and words[-1].isdigit() else NEVER_STOPS


def wait_until_settled(settings: Settings, patience_sec: float = SSH_PATIENCE_SEC, interval_sec: float = 5.0) -> None:
    """Wait until a machine this run started has been up for SETTLED_SEC.

    Otherwise the first step can meet the restart of its SSH service ("closed by remote host")."""

    def settled() -> bool:
        up = uptime_sec(settings)
        return up is not None and up >= SETTLED_SEC

    first = uptime_sec(settings)
    if first is not None and first >= SETTLED_SEC:
        return
    say(f"{settings.vm} has just started: waiting until it has been up for {int(SETTLED_SEC)} s")
    if not wait_for(settled, patience_sec, interval_sec):
        raise Refused(
            f"{settings.vm} did not say how long it has been up within {int(patience_sec)} s: its SSH comes and goes"
        )


def power_off(settings: Settings, patience_sec: float = OFF_PATIENCE_SEC, interval_sec: float = 5.0) -> None:
    """Shut the machine down with Windows's shutdown, then the ACPI button if needed, and wait.

    The button alone does nothing on an unattended Windows. Never a hard power-off."""
    say(f"shutting {settings.vm} down")
    ssh_run(settings, SHUTDOWN_SCRIPT, timeout_sec=60.0)
    if wait_for(lambda: vm_state(settings.vm) == "poweroff", patience_sec, interval_sec):
        return
    vboxmanage("controlvm", settings.vm, "acpipowerbutton")
    if wait_for(lambda: vm_state(settings.vm) == "poweroff", patience_sec, interval_sec):
        return
    say(f"{settings.vm} is not powered off after {int(patience_sec)} s: left as it is, shut it down by hand")


# ---- the machine ----


def ssh_run(settings: Settings, script: str, timeout_sec: float = 300.0) -> subprocess.CompletedProcess[str]:
    """Run a short script on the machine and return its output; no answer counts as failure."""
    try:
        return subprocess.run(
            ssh_script(settings, script),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            errors="replace",
            timeout=timeout_sec,
        )
    except subprocess.TimeoutExpired as error:
        return subprocess.CompletedProcess(error.cmd, 124, "", f"no answer within {int(timeout_sec)} s")


def ensure_uv_zip(cache: Path, pin: Pin = UV, download: Callable[[str, Path, str], None] | None = None) -> Path:
    """Return the uv zip in the build cache, fetched from GitHub when its digest is not the
    pin's."""
    target = cache / f"uv-{pin.version}" / pin.file
    with contextlib.suppress(OSError):
        if hashlib.sha256(target.read_bytes()).hexdigest() == pin.sha256:
            return target
    fetch = download or load_script("security-tools").download
    target.parent.mkdir(parents=True, exist_ok=True)
    part = target.with_name(target.name + ".part")
    try:
        fetch(pin.url, part, pin.sha256)
        part.replace(target)
    finally:
        part.unlink(missing_ok=True)
    return target


def copy_to(settings: Settings, local: Path, remote_windows_path: str) -> None:
    done = subprocess.run(
        scp_command(settings, local, scp_path(remote_windows_path)),
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        errors="replace",
    )
    if done.returncode != 0:
        raise Refused(f"{local.name} could not be copied to the machine ({last_line(done.stderr)})")


def remote_must(settings: Settings, script: str, failure: str) -> None:
    done = ssh_run(settings, script)
    if done.returncode != 0:
        raise Refused(f"{failure} ({last_line(done.stdout + done.stderr)})")


def make_root(settings: Settings, paths: Paths) -> None:
    """Make the runs folder on the machine if missing (scp makes none)."""
    remote_must(
        settings,
        f"$ErrorActionPreference = 'Stop'; New-Item -ItemType Directory -Force -Path {ps_quote(paths.root)} | Out-Null; exit 0",
        "the folder for the runs could not be made",
    )


def put_uv_there(settings: Settings, paths: Paths, cache: Path) -> None:
    """Make uv of the pinned version available in its folder: copy and unpack the zip unless it is
    there."""
    if uv_version_ok(ssh_run(settings, uv_version_script(paths)).stdout):
        return
    say(f"putting uv {UV.version} on the machine")
    try:
        zip_file = ensure_uv_zip(cache)
    # the download's own message: the pin, the network or the disk
    except Exception as error:
        raise Refused(f"uv {UV.version} could not be fetched ({error})") from None
    make_root(settings, paths)
    copy_to(settings, zip_file, paths.uv_zip)
    remote_must(settings, uv_unpack_script(paths), "uv could not be unpacked on the machine")
    if not uv_version_ok(ssh_run(settings, uv_version_script(paths)).stdout):
        raise Refused(f"uv {UV.version} is not what runs from {paths.uv_dir} after it was put there")


def prepare(settings: Settings, paths: Paths, tar: Path, cache: Path) -> None:
    """The machine made ready for the steps: uv, then the tree in the folder of the run."""
    put_uv_there(settings, paths, cache)
    say(f"copying the tree to {paths.run}")
    make_root(settings, paths)
    copy_to(settings, tar, paths.tar)
    remote_must(settings, prepare_script(paths), "the tree could not be unpacked on the machine")


def remove_old_runs(settings: Settings, paths: Paths) -> None:
    """Remove the folders of older runs but the newest two; failures are only logged."""
    names = runs_to_remove(ssh_run(settings, listing_script(paths)).stdout.splitlines())
    if names:
        say(f"removing the older runs on the machine: {' '.join(names)}")
        ssh_run(settings, removal_script(paths, names), timeout_sec=900.0)


def run_step(settings: Settings, paths: Paths, step: Step, log_dir: Path, tty: bool = False) -> StepResult:
    """Run one step on the machine with its whole output in a log here; a step over its time is
    ended and fails with 124."""
    return run_script(settings, paths, step.name, step_script(paths, step), step.timeout_sec, log_dir, tty)


def run_script(
    settings: Settings, paths: Paths, name: str, script: str, timeout_sec: float, log_dir: Path, tty: bool = False
) -> StepResult:
    """A step's script on the machine: what run_step does, for any script."""
    log = log_dir / f"{name}.log"
    say(f"running {name}")
    started = time.monotonic()
    code, note = 0, ""
    with log.open("wb") as out:
        proc = subprocess.Popen(
            ssh_script(settings, script, tty),
            stdin=subprocess.PIPE if tty else subprocess.DEVNULL,
            stdout=out,
            stderr=subprocess.STDOUT,
        )
        try:
            code = proc.wait(timeout=timeout_sec)
        except subprocess.TimeoutExpired:
            code, note = 124, f"(stopped: the step did not end in {int(timeout_sec)} s)"
            proc.kill()
            proc.wait()
            ssh_run(settings, stop_script(paths.run), timeout_sec=60.0)
        except BaseException:
            proc.kill()
            proc.wait()
            ssh_run(settings, stop_script(paths.run), timeout_sec=60.0)
            raise
        finally:
            if proc.stdin is not None:
                proc.stdin.close()
    text = clean_output(log.read_bytes().decode("utf-8", errors="replace"))
    log.write_text(text + (note and "\n" + note) + "\n", encoding="utf-8")
    tail = [*text.rstrip("\n").splitlines()[-TAIL_LINES:], *([note] if note else [])]
    return StepResult(name, code, time.monotonic() - started, log, tuple(tail))


def console_works(settings: Settings, paths: Paths, tty: bool) -> bool:
    """Whether the probe ends its child with Ctrl+Break in a session of this kind."""
    with subprocess.Popen(
        ssh_script(settings, probe_script(paths), tty),
        stdin=subprocess.PIPE if tty else subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    ) as proc:
        try:
            return proc.wait(timeout=120) == 0
        finally:
            # a hanging probe has failed; its input closes with the with block
            proc.kill()


def choose_console(settings: Settings, paths: Paths, force_tty: bool) -> bool:
    """Return whether pytest runs through `ssh -tt`: when asked, or when only a console session can
    send Ctrl+Break."""
    if force_tty:
        return True
    try:
        if console_works(settings, paths, tty=False):
            say("Ctrl+Break reaches a child in a plain SSH session: pytest runs in one")
            return False
        if console_works(settings, paths, tty=True):
            say(
                "Ctrl+Break does not reach a child in a plain SSH session, and does in one with a console: pytest runs through ssh -tt"
            )
            return True
    except subprocess.TimeoutExpired:
        pass
    say(
        "the probe of Ctrl+Break did not pass in either kind of session: pytest runs in a plain one, and the tests that end a child that way will fail"
    )
    return False


def execute(
    settings: Settings, names: Sequence[str], pytest_args: Sequence[str], tar: Path, cache: Path, force_tty: bool
) -> int:
    """Run the steps on a machine that answers; all run to the end except that none follows a failed
    sync."""
    paths = windows_paths(settings.user, run_name(time.time()))
    log_dir = Path(tempfile.mkdtemp(prefix="neoaprs-check-windows-"))
    say(f"the logs are in {log_dir}")
    prepare(settings, paths, tar, cache)
    results: list[StepResult] = []
    total = time.monotonic()
    tty = False
    try:
        for step in steps(paths, pytest_args):
            if step.name not in names:
                continue
            if step.name == "sync" or "sync" not in [result.name for result in results if result.code != 0]:
                if step.name == "pytest":
                    tty = choose_console(settings, paths, force_tty)
                result = run_step(settings, paths, step, log_dir, tty and step.name == "pytest")
                results.append(result)
                print("\n".join(report_lines(result)), flush=True)
    finally:
        remove_old_runs(settings, paths)
    print(summary(results, time.monotonic() - total), flush=True)
    return exit_code(results)


# ---- the install proof (--install) ----

# The scripted install proof (docs/development.md): the installer runs silently on the clean
# machine, then the pieces that pull modules and DLLs, the uninstall last. uv and its Python are
# installed only for the two smoke scripts, never on the app's PATH.
INSTALLER_NAME = re.compile(r"NeoAPRS-Setup-(\d+\.\d+\.\d+(?:-[0-9A-Za-z]+)?)\.exe")
INSTALL_STEP_NAMES = (
    "install",
    "defender",
    "daemon",
    "commands",
    "app",
    "map",
    "direwolf",
    "smoke",
    "mercury",
    "uninstall",
)
NEEDS_PYTHON = ("smoke", "mercury")
# FileDescription of each program, as Task Manager shows it (packaging/windows/neoaprs.spec).
DESCRIPTIONS = {
    "neoaprsw": "NeoAPRS, the APRS client that runs in the background",
    "neoaprs-app": "NeoAPRS, the window and the tray icon",
}
# Files the smoke steps run, at their places in the tree.
KIT = ("scripts/smoke.py", "tests/fixtures/kiss/thd7-2026-10-21.bin", "packaging/windows/smoke_mercury.py")
APP_FOLDER = "$app = Join-Path $env:LOCALAPPDATA 'Programs\\NeoAPRS'"
DATA_FOLDER = "$data = Join-Path $env:LOCALAPPDATA 'NeoAPRS'"
# PowerShell function: the page address from a log once the daemon wrote it, or nothing if the
# process ended or time ran out.
WAIT_PAGE = """function Wait-Page([string]$log, $process, [int]$seconds) {
  foreach ($i in 1..$seconds) {
    $m = if (Test-Path -LiteralPath $log) { Select-String -LiteralPath $log -Pattern 'web page at (http://\\S+/)' | Select-Object -Last 1 }
    if ($m) { return $m.Matches[0].Groups[1].Value }
    if ($process.HasExited) { return $null }
    Start-Sleep 1
  }
  return $null
}"""


class InstallPaths(NamedTuple):
    """Where the install proof keeps things on the machine, all in the folder of the run."""

    setup: str
    install_log: str
    uninstall_log: str
    kit: str
    kit_tar: str
    data_app: str
    data_map: str
    data_direwolf: str
    support: str


def install_paths(paths: Paths, installer_name: str) -> InstallPaths:
    run = paths.run
    return InstallPaths(
        f"{run}\\{installer_name}",
        f"{run}\\install.log",
        f"{run}\\uninstall.log",
        f"{run}\\kit",
        f"{run}-kit.tar",
        f"{run}\\data-app",
        f"{run}\\data-map",
        f"{run}\\data-direwolf",
        f"{run}\\support",
    )


def installer_version(installer: Path, option: str = "--install") -> str:
    """Return the version in the installer's name (NeoAPRS-Setup-0.20.0.exe), or raise NotSetUp."""
    found = INSTALLER_NAME.fullmatch(installer.name)
    if not installer.is_file() or found is None:
        raise NotSetUp(
            f"{option} takes the installer the release workflow makes, NeoAPRS-Setup-VERSION.exe, and {installer} is not one"
        )
    return found.group(1)


def tornado_pin(pyproject: str) -> str:
    """The Tornado the project pins: scripts/smoke.py's WebSocket client is run with it."""
    found = re.search(r'"tornado==([^"]+)"', pyproject)
    if found is None:
        raise NotSetUp("pyproject.toml pins no tornado, which scripts/smoke.py runs with")
    return found.group(1)


def direwolf_banner(module: str) -> str:
    """Return the first line the shipped Direwolf prints (neoaprs/direwolf.py BANNER with
    VERSION)."""
    version, banner = re.search(r'^VERSION = "([^"]+)"', module, re.M), re.search(r'^BANNER = "([^"]+)"', module, re.M)
    if version is None or banner is None or banner.group(1).count("%d") != 3:
        raise NotSetUp("neoaprs/direwolf.py names no VERSION and BANNER of the Direwolf NeoAPRS ships")
    return banner.group(1).replace("%d.%d.%d", version.group(1))


def pack_kit(root: Path, out: Path) -> None:
    """The tar of the files the smoke steps run, under the names they have in the tree."""
    with tarfile.open(out, "w") as tar:
        for name in KIT:
            tar.add(root / name, arcname=name, recursive=False)


def install_script(name: str, *lines: str) -> str:
    """Return the start of a step script: its name line, no developer variable, the app's folder in
    $app."""
    return "\n".join(
        [
            f"# step: {name}",
            "$ErrorActionPreference = 'Continue'",
            "$ProgressPreference = 'SilentlyContinue'",
            APP_FOLDER,
            *lines,
            "exit 0",
        ]
    )


def fail_unless(condition: str, why: str, *before: str) -> str:
    """Return the PowerShell line that ends the step with 1 and says why when the condition
    fails."""
    return f"if (-not ({condition})) {{ {'; '.join([*before, ps_quote(why)])}; exit 1 }}"


NATIVE_OK = "$LASTEXITCODE -eq 0"
# Files of the program folder that the proofs look for after an install.
INSTALLED_FILES = (
    "neoaprs.exe",
    "neoaprsw.exe",
    "neoaprs-app.exe",
    "bin\\mercury\\mercury.exe",
    "bin\\direwolf\\direwolf.exe",
    "bin\\direwolf\\data\\tocalls.yaml",
    "_internal\\neoaprs\\maps\\basemap-world.pmtiles",
    "_internal\\neoaprs\\desktop\\icon.ico",
    "LICENSE.txt",
    "unins000.exe",
)
START_MENU = "Join-Path $env:APPDATA 'Microsoft\\Windows\\Start Menu\\Programs\\NeoAPRS'"


def setup_lines(setup: str, log: str) -> list[str]:
    """Run the installer silently, as users and Update now do; a setup that ends with non-zero ends
    the step with its log."""
    return [
        f"$setup = {ps_quote(setup)}",
        f"$p = Start-Process -FilePath $setup -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', {ps_quote('/LOG=' + log)} -PassThru",
        "$p.WaitForExit()",
        fail_unless(
            "$p.ExitCode -eq 0",
            "setup did not end with 0",
            f"Get-Content -LiteralPath {ps_quote(log)} -Tail 40",
            '"setup ended with $($p.ExitCode)"',
        ),
    ]


def files_lines(files: Sequence[str]) -> list[str]:
    return [
        fail_unless(f"Test-Path -LiteralPath (Join-Path $app {ps_quote(f)})", f"{f} is not in the program folder")
        for f in files
    ]


def version_lines(version: str) -> list[str]:
    """`neoaprs.exe --version` of the program folder, which must say this version."""
    return [
        "$said = (& (Join-Path $app 'neoaprs.exe') --version 2>&1 | ForEach-Object { \"$_\" } | Out-String).Trim()",
        '"neoaprs.exe --version: $said"',
        fail_unless(f"$said -eq {ps_quote('NeoAPRS ' + version)}", f"neoaprs.exe is not NeoAPRS {version}"),
    ]


def uninstall_script(log: str) -> str:
    """Uninstall with the app running: program folder gone, start at sign-in and processes gone,
    data folder kept."""
    return install_script(
        "uninstall",
        DATA_FOLDER,
        "$log = Join-Path $data 'neoaprs.log'",
        "$before = @(Select-String -LiteralPath $log -Pattern 'NeoAPRS is running' -ErrorAction SilentlyContinue).Count",
        "$running = Start-Process -FilePath (Join-Path $app 'neoaprs-app.exe') -ArgumentList '--tray' -PassThru",
        "foreach ($i in 1..120) { if (@(Select-String -LiteralPath $log -Pattern 'NeoAPRS is running' -ErrorAction SilentlyContinue).Count -gt $before) { break }; Start-Sleep 1 }",
        fail_unless("-not $running.HasExited", "the app did not stay up before the uninstall"),
        f"$u = Start-Process -FilePath (Join-Path $app 'unins000.exe') -ArgumentList '/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', {ps_quote('/LOG=' + log)} -PassThru",
        "$u.WaitForExit()",
        "foreach ($i in 1..120) { if (-not (Test-Path -LiteralPath (Join-Path $app 'neoaprs.exe'))) { break }; Start-Sleep 1 }",
        fail_unless(
            "-not (Test-Path -LiteralPath (Join-Path $app 'neoaprs.exe'))",
            "neoaprs.exe is still in the program folder",
            f"Get-Content -LiteralPath {ps_quote(log)} -Tail 40",
        ),
        "foreach ($i in 1..30) { if (-not (Test-Path -LiteralPath $app)) { break }; Start-Sleep 1 }",
        "$left = if (Test-Path -LiteralPath $app) { @(Get-ChildItem -LiteralPath $app -Recurse -Force | ForEach-Object { $_.FullName }) } else { @() }",
        fail_unless("$left.Count -eq 0", "the uninstall left files in the program folder", "$left"),
        fail_unless(
            "-not (Get-ItemProperty 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -ErrorAction SilentlyContinue).NeoAPRS",
            "the start at sign-in is still set",
        ),
        fail_unless(
            "-not (Get-Process -Name neoaprs, neoaprsw, neoaprs-app -ErrorAction SilentlyContinue)",
            "a NeoAPRS process is still running",
        ),
        fail_unless("Test-Path -LiteralPath (Join-Path $data 'neoaprs.sqlite')", "the data folder was touched"),
        fail_unless(
            f"-not (Test-Path -LiteralPath (Join-Path ({START_MENU}) 'NeoAPRS.lnk'))",
            "the Start menu entry is still there",
        ),
        "'uninstalled: the program folder is gone, the data folder is still there'",
    )


def install_steps(
    paths: Paths, installer_name: str, version: str, tornado: str, direwolf: str
) -> list[tuple[str, str, float]]:
    """The steps of the proof in order, each its name, its script and its time."""
    ip = install_paths(paths, installer_name)
    native_ok = NATIVE_OK
    entries = ("NeoAPRS", "Stop NeoAPRS", "NeoAPRS support logs")
    menu = START_MENU
    install = install_script(
        "install",
        *setup_lines(ip.setup, ip.install_log),
        *files_lines(INSTALLED_FILES),
        f"$menu = {menu}",
        *(
            fail_unless(
                f"Test-Path -LiteralPath (Join-Path $menu {ps_quote(e + '.lnk')})", f"the Start menu has no entry {e}"
            )
            for e in entries
        ),
        "$size = (Get-ChildItem -LiteralPath $app -Recurse -File | Measure-Object -Property Length -Sum).Sum",
        "$count = @(Get-ChildItem -LiteralPath $app -Recurse -File).Count",
        "'installed: {0:N1} MB in {1} files ({2} bytes)' -f ($size / 1000000), $count, $size",
    )
    defender = install_script(
        "defender",
        "$status = Get-MpComputerStatus -ErrorAction SilentlyContinue",
        fail_unless("$status", "Defender's state could not be read: the proof needs its real-time protection on"),
        '"Defender: real-time protection $($status.RealTimeProtectionEnabled), signatures of $($status.AntivirusSignatureLastUpdated)"',
        fail_unless(
            "$status.RealTimeProtectionEnabled", "Defender's real-time protection is off: the proof needs it on"
        ),
        "$admin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)",
        "if (-not $admin) { 'the scan of the folder needs an administrator, and this account is none: not run (the first start under real-time protection, next, is the proof)'; exit 0 }",
        "$scanner = Join-Path $env:ProgramFiles 'Windows Defender\\MpCmdRun.exe'",
        '& $scanner -Scan -ScanType 3 -File $app 2>&1 | ForEach-Object { "$_" }',
        fail_unless(
            native_ok,
            "Defender's scan of the program folder found something or could not run",
            '"MpCmdRun ended with $LASTEXITCODE"',
        ),
    )
    stop_entry = "$stop = Start-Process -FilePath (Join-Path $app 'neoaprsw.exe') -ArgumentList 'stop' -PassThru; $stop.WaitForExit()"
    daemon = install_script(
        "daemon",
        DATA_FOLDER,
        WAIT_PAGE,
        "$log = Join-Path $data 'neoaprs.log'",
        stop_entry,
        fail_unless(
            "$stop.ExitCode -eq 0", "the Start menu's Stop NeoAPRS (neoaprsw.exe stop) failed with nothing running"
        ),
        "$clock = [Diagnostics.Stopwatch]::StartNew()",
        "$p = Start-Process -FilePath (Join-Path $app 'neoaprsw.exe') -ArgumentList 'run' -PassThru",
        "$url = Wait-Page $log $p 180",
        fail_unless(
            "$url",
            "neoaprsw.exe run served no page",
            "Get-Content -LiteralPath $log -Tail 30 -ErrorAction SilentlyContinue",
        ),
        "$code = (Invoke-WebRequest $url -UseBasicParsing).StatusCode",
        '"the page $url answered $code, $([int]$clock.Elapsed.TotalSeconds) s after the first start of the daemon"',
        fail_unless("$code -eq 200", "the page does not answer"),
        "$request = [Net.HttpWebRequest]::Create($url + 'basemap-world.pmtiles'); $request.AddRange(0, 126)",
        "$answer = $request.GetResponse(); $head = New-Object byte[] 7; $null = $answer.GetResponseStream().Read($head, 0, 7); $status = [int]$answer.StatusCode; $answer.Close()",
        fail_unless(
            "$status -eq 206 -and [Text.Encoding]::ASCII.GetString($head) -eq 'PMTiles'",
            "the world map that ships with the app is not served",
        ),
        "'the world map is served'",
        "$description = (Get-Process -Id $p.Id).Description",
        '"Task Manager: neoaprsw.exe, $description"',
        fail_unless(f"$description -eq {ps_quote(DESCRIPTIONS['neoaprsw'])}", "neoaprsw.exe does not say what it is"),
        stop_entry,
        fail_unless("$p.WaitForExit(60000)", "the daemon did not end after Stop NeoAPRS"),
        fail_unless(
            "(Get-Content -LiteralPath $log -Tail 1) -like '*NeoAPRS ended'",
            "the daemon did not end cleanly",
            "Get-Content -LiteralPath $log -Tail 10",
        ),
    )
    support_out = ps_quote(ip.support)
    commands = install_script(
        "commands",
        "$exe = Join-Path $app 'neoaprs.exe'",
        *version_lines(version),
        '$doctor = & $exe doctor 2>&1 | ForEach-Object { "$_" } | Out-String',
        "$doctor",
        fail_unless(
            "$doctor -notmatch 'Traceback' -and $doctor -match 'serial port'",
            "neoaprs.exe doctor did not run to its end (it lists the serial ports)",
        ),
        f'& $exe support --out {support_out} 2>&1 | ForEach-Object {{ "$_" }}',
        fail_unless(native_ok, "neoaprs.exe support failed"),
        f"$zips = @(Get-ChildItem -LiteralPath {support_out} -Filter 'neoaprs-support-*.zip')",
        fail_unless("$zips.Count -eq 1", "the support logs made no file"),
        "Add-Type -AssemblyName System.IO.Compression.FileSystem",
        "$zip = [IO.Compression.ZipFile]::OpenRead($zips[0].FullName); try { $names = @($zip.Entries | ForEach-Object { $_.FullName }) } finally { $zip.Dispose() }",
        *(
            fail_unless(f"$names -contains {ps_quote(n)}", f"{n} is not in the support file")
            for n in (
                "README.txt",
                "summary.txt",
                "settings.json",
                "doctor.txt",
                "database.txt",
                "packets.txt",
                "logs/neoaprs.log",
            )
        ),
        '"support file: $($zips[0].Name), $($names.Count) files"',
        # the frozen programs start the daemon's asker of a modem on --winask (winchild.asker_argv); an id
        # that is no number is its exit 2, so the asker runs and asks nothing
        "$asker = Start-Process -FilePath (Join-Path $app 'neoaprsw.exe') -ArgumentList '--winask','none' -Wait -PassThru -WindowStyle Hidden",
        fail_unless("$asker.ExitCode -eq 2", "neoaprsw.exe --winask did not start the asker (exit $($asker.ExitCode))"),
        '"neoaprsw.exe --winask: the asker answers"',
    )
    app = install_script(
        "app",
        WAIT_PAGE,
        f"$data = {ps_quote(ip.data_app)}",
        "New-Item -ItemType Directory -Force -Path $data | Out-Null",
        "$log = Join-Path $data 'neoaprs.log'",
        "$clock = [Diagnostics.Stopwatch]::StartNew()",
        "$p = Start-Process -FilePath (Join-Path $app 'neoaprs-app.exe') -ArgumentList '--tray', '--data', $data -PassThru",
        "$url = Wait-Page $log $p 180",
        fail_unless(
            "$url",
            "the app did not start its daemon",
            "Get-Content -LiteralPath (Join-Path $data 'neoaprs-app.log'), $log -Tail 30 -ErrorAction SilentlyContinue",
        ),
        "$code = (Invoke-WebRequest $url -UseBasicParsing).StatusCode",
        "\"the app's daemon: the page $url answered $code, $([int]$clock.Elapsed.TotalSeconds) s after the app's first start\"",
        fail_unless("$code -eq 200", "the page does not answer"),
        # the tray icon is shown by pystray's thread, whose failure only reaches the app's log
        "Start-Sleep 5",
        fail_unless(
            "-not $p.HasExited",
            "the app ended by itself",
            "Get-Content -LiteralPath (Join-Path $data 'neoaprs-app.log') -Tail 30",
        ),
        "$applog = Join-Path $data 'neoaprs-app.log'",
        fail_unless(
            "(Test-Path -LiteralPath $applog) -and -not (Select-String -LiteralPath $applog -Pattern 'uncaught exception|Traceback' -Quiet)",
            "the app logged an uncaught exception (its tray icon or its window failed)",
            "Get-Content -LiteralPath $applog -Tail 40 -ErrorAction SilentlyContinue",
        ),
        "$description = (Get-Process -Id $p.Id).Description",
        '"Task Manager: neoaprs-app.exe, $description"',
        fail_unless(
            f"$description -eq {ps_quote(DESCRIPTIONS['neoaprs-app'])}", "neoaprs-app.exe does not say what it is"
        ),
        "& (Join-Path $app 'neoaprs.exe') stop --data $data 2>&1 | ForEach-Object { \"$_\" }",
        fail_unless(native_ok, "neoaprs.exe stop failed"),
        fail_unless(
            "$p.WaitForExit(30000)",
            "the app did not end with its daemon",
            "Get-Content -LiteralPath (Join-Path $data 'neoaprs-app.log') -Tail 30",
        ),
    )
    map_cut = install_script(
        "map",
        f"& (Join-Path $app 'neoaprs.exe') map --data {ps_quote(ip.data_map)} --lat 60.17 --lon 24.94 --radius 10 --maxzoom 8 --dry-run 2>&1 | ForEach-Object {{ \"$_\" }}",
        fail_unless(native_ok, "the map cut (a dry run) failed"),
    )
    sound_card = install_script(  # a type whose program is missing is not offered
        "direwolf",
        f"& (Join-Path $app 'neoaprs.exe') db --data {ps_quote(ip.data_direwolf)} radios add direwolf 2>&1 | ForEach-Object {{ \"$_\" }}",
        fail_unless(native_ok, "the installed app does not find its own Direwolf: the type Sound card is not offered"),
        "$said = (& (Join-Path $app 'bin\\direwolf\\direwolf.exe') -h 2>&1 | ForEach-Object { \"$_\" } | Out-String)",
        "$said",
        fail_unless(
            f"$said.Contains({ps_quote(direwolf)})",
            "the installed direwolf.exe does not run as the Direwolf NeoAPRS ships",
        ),
    )
    python_env = [
        f"$env:Path = {ps_quote(paths.uv_dir + ';')} + $env:Path",
        *(
            f"$env:{name} = {ps_quote(value)}"
            for name, value in STEP_ENVIRONMENT.items()
            if name != "NEOAPRS_NO_DEVICES"
        ),
        f"Set-Location -LiteralPath {ps_quote(ip.kit)}",
    ]
    smoke = install_script(
        "smoke",
        *python_env,
        f"& uv run --no-project --with {ps_quote('tornado==' + tornado)} scripts\\smoke.py --command (Join-Path $app 'neoaprs.exe') 2>&1 | ForEach-Object {{ \"$_\" }}",
        fail_unless(native_ok, "scripts/smoke.py failed against the installed neoaprs.exe"),
    )
    mercury = install_script(
        "mercury",
        *python_env,
        "& uv run --no-project packaging\\windows\\smoke_mercury.py (Join-Path $app 'bin\\mercury\\mercury.exe') 2>&1 | ForEach-Object { \"$_\" }",
        fail_unless(native_ok, "the installed Mercury does not listen on this computer alone"),
    )
    uninstall = uninstall_script(ip.uninstall_log)
    times = {"install": 600.0, "defender": 1800.0, "smoke": 900.0, "uninstall": 600.0}
    scripts = dict(
        zip(
            INSTALL_STEP_NAMES,
            (install, defender, daemon, commands, app, map_cut, sound_card, smoke, mercury, uninstall),
        )
    )
    return [(name, scripts[name], times.get(name, 300.0)) for name in INSTALL_STEP_NAMES]


def kit_script(paths: Paths, ip: InstallPaths) -> str:
    tar = "$env:SystemRoot + '\\System32\\tar.exe'"
    return "\n".join(
        [
            "$ErrorActionPreference = 'Stop'",
            f"New-Item -ItemType Directory -Force -Path {ps_quote(ip.kit)} | Out-Null",
            f"& ({tar}) -xf {ps_quote(ip.kit_tar)} -C {ps_quote(ip.kit)}",
            "if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }",
            f"Remove-Item -LiteralPath {ps_quote(ip.kit_tar)}",
            "exit 0",
        ]
    )


def put_python_kit(settings: Settings, paths: Paths, ip: InstallPaths, kit: Path, cache: Path) -> None:
    """Install uv and the kit for the two steps that need Python, only now, so earlier steps ran on
    a bare machine."""
    put_uv_there(settings, paths, cache)
    copy_to(settings, kit, ip.kit_tar)
    remote_must(settings, kit_script(paths, ip), "the smoke scripts could not be unpacked on the machine")


def execute_install(
    settings: Settings, installer: Path, version: str, tornado: str, direwolf: str, kit: Path, cache: Path
) -> int:
    """Run the install proof; nothing follows a failed install, every other step runs to the end."""
    paths = windows_paths(settings.user, run_name(time.time()))
    ip = install_paths(paths, installer.name)
    log_dir = Path(tempfile.mkdtemp(prefix="neoaprs-check-windows-install-"))
    say(f"the logs are in {log_dir}")
    make_root(settings, paths)
    remote_must(
        settings,
        f"$ErrorActionPreference = 'Stop'; New-Item -ItemType Directory -Force -Path {ps_quote(paths.run)} | Out-Null; exit 0",
        "the folder of the run could not be made",
    )
    say(f"copying {installer.name} to {paths.run}")
    copy_to(settings, installer, ip.setup)
    results: list[StepResult] = []
    total = time.monotonic()
    python_ready: bool | None = None
    try:
        for name, script, timeout_sec in install_steps(paths, installer.name, version, tornado, direwolf):
            if results and results[0].code != 0:
                break
            if name in NEEDS_PYTHON:
                if python_ready is None:
                    try:
                        put_python_kit(settings, paths, ip, kit, cache)
                        python_ready = True
                    except Refused as error:
                        python_ready = False
                        log = log_dir / "python.log"
                        log.write_text(f"{error}\n", encoding="utf-8")
                        results.append(StepResult("python", 1, 0.0, log, (str(error),)))
                        print("\n".join(report_lines(results[-1])), flush=True)
                if not python_ready:
                    continue
            result = run_script(settings, paths, name, script, timeout_sec, log_dir)
            results.append(result)
            print("\n".join(report_lines(result)), flush=True)
    finally:
        remove_old_runs(settings, paths)
    print(summary(results, time.monotonic() - total), flush=True)
    return exit_code(results)


# ---- the upgrade proof (--upgrade) ----

# The upgrade proof: the old installer, a station made with that release's own command line, the
# new installer over it, then the new release on the same data folder. Each step needs the one
# before; the new release must report the same radios and settings.
UPGRADE_STEP_NAMES = ("old", "station", "update", "migrate", "data", "daemon", "uninstall")
# files every release has in its program folder
OLD_FILES = ("neoaprs.exe", "neoaprsw.exe", "neoaprs-app.exe", "unins000.exe")
# First release whose station has radios and no flat key of a radio.
RADIOS_FROM = (0, 20, 0)
# The station's and beacon's own values, by keys that every release has.
STATION_OWN = (
    ("station/call", "OH2GBA-9"),
    ("station/lat", "60.1699"),
    ("station/lon", "24.9384"),
    ("station/comment", "NeoAPRS upgrade proof"),
    ("beacon/interval_min", "30"),
    ("beacon/power_w", "5"),
)
# The station by the flat keys of a release before RADIOS_FROM, using the Dummy radios so that no
# device or sound card is needed.
STATION = (
    *STATION_OWN,
    ("beacon/path", "WIDE1-1"),
    ("tnc/profile", "dummy"),
    ("hf/profile", "dummy-hf"),
    ("hf/enabled", "true"),
)
KEPT_KEYS = tuple(key for key, _ in STATION_OWN)  # keys of the station that keep their names
# Flat keys that became a radio's (neoaprs/configradios.py FLAT_HOMES): the radio, and its column in
# `db radios` or its key.
MOVED = {
    "tnc/profile": (1, "type"),
    "fm/enabled": (1, "on"),
    "beacon/path": (1, "radio/1/path"),
    "hf/profile": (2, "type"),
    "hf/enabled": (2, "on"),
}
RADIO_KINDS = {1: "fm", 2: "hf"}


class Added(NamedTuple):
    """A radio added to the station of a release with radios: `db radios add TYPE [NAME]`, then `db
    set radio/N/KEY VALUE`."""

    type: str
    # kind key the release gives a radio of this type (printed after the name)
    kind: str
    # name typed, at most 8 characters and no kind's word; "" for none
    name: str
    settings: tuple[tuple[str, str], ...]  # its own settings, by their own keys


# Radios of that station in the order they are added: a fresh database numbers them 1 and 2. Dummy
# types need no device; the first has a name, the second none (the release's own word for its kind
# then names it) and a stored beacon setting, so each radio has a setting of its own to carry over.
RADIOS = (Added("dummy", "fm", "Proof", (("path", "WIDE1-1"),)), Added("dummy-hf", "hf", "", (("beacon", "true"),)))
# daemon run time; the Dummy radios make a station heard every few seconds
RUN_SEC = 40
APP_ID = "{5AE53960-2902-4F1B-99E1-03E486EA7B36}"  # AppId of packaging/windows/neoaprs.iss
UNINSTALL_KEY = f"HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{APP_ID}_is1"
# log lines of a start that migrates
MIGRATED = "brought up to date now|is now version [0-9]+ [(]was [0-9]+[)]|a copy of it is in"
LOG_TROUBLE = "Z  (ERROR|CRITICAL)  |Traceback"


class UpgradePaths(NamedTuple):
    old_setup: str
    new_setup: str
    old_log: str
    new_log: str
    uninstall_log: str
    data: str  # the station's data folder
    old_list: str  # what the old release's command line said of it
    old_stations: str
    old_radios: str  # a release with radios only
    old_doctor: str


def upgrade_paths(paths: Paths, old_name: str, new_name: str) -> UpgradePaths:
    run = paths.run
    return UpgradePaths(
        f"{run}\\{old_name}",
        f"{run}\\{new_name}",
        f"{run}\\install-old.log",
        f"{run}\\install-new.log",
        f"{run}\\uninstall.log",
        f"{run}\\data-upgrade",
        f"{run}\\old-db-list.txt",
        f"{run}\\old-db-stations.txt",
        f"{run}\\old-db-radios.txt",
        f"{run}\\old-doctor.txt",
    )


def version_key(version: str) -> tuple[int, ...]:
    return tuple(int(part) for part in version.split("-")[0].split("."))


def has_radios(old_version: str) -> bool:
    """Return whether the release before has radios, by the version in its installer's name."""
    return version_key(old_version) >= RADIOS_FROM


def upgrade_versions(old: Path, new: Path) -> tuple[str, str]:
    """Return the versions of the old and new installers, or raise NotSetUp."""
    old_version, new_version = installer_version(old, "--upgrade"), installer_version(new, "--upgrade")
    if old_version == new_version or version_key(old_version) > version_key(new_version):
        raise NotSetUp(
            f"--upgrade takes the installer of the release before, then the new one: {old.name} is not older than {new.name}"
        )
    return old_version, new_version


def section(title: str, command: str, why: str, keep: str = "") -> list[str]:
    """Run an installed neoaprs.exe command under a `### TITLE` line, also keeping output in `keep`.

    With `why` a failure ends the step."""
    lines = [
        f"'### {title}'",
        f'$out = @(& $exe {command} 2>&1 | ForEach-Object {{ "$_" }}); $code = $LASTEXITCODE',
        "$out",
    ]
    if keep:
        lines.append(f"$out | Set-Content -LiteralPath {ps_quote(keep)} -Encoding UTF8")
    return [*lines, *([fail_unless("$code -eq 0", why, '"it ended with $code"')] if why else [])]


def old_db(*arguments: str) -> list[str]:
    """Run one `db` command of the release before on the station's folder; a refusal ends the
    step."""
    words = " ".join(ps_quote(argument) for argument in arguments)
    return [
        f'& $exe db --data $data {words} 2>&1 | ForEach-Object {{ "$_" }}',
        fail_unless(NATIVE_OK, f"the old release's command line refused db {' '.join(arguments)}"),
    ]


def set_lines(pairs: Sequence[tuple[str, str]]) -> list[str]:
    """Run `db set KEY VALUE` of the release before for each pair; the first refusal ends the
    step."""
    listed = ", ".join(f"@({ps_quote(key)}, {ps_quote(value)})" for key, value in pairs)
    return [
        f"$pairs = @({listed})",
        'foreach ($kv in $pairs) { & $exe db --data $data set $kv[0] $kv[1] 2>&1 | ForEach-Object { "$_" }; if ($LASTEXITCODE -ne 0) { "the old release\'s command line refused $($kv[0]) $($kv[1])"; exit 1 } }',
    ]


def radio_lines(added: Sequence[Added]) -> list[str]:
    """Return the commands that add each radio and set its settings (`db radios add`, `db set`).

    A fresh database numbers the radios 1 and up in the order added."""
    adds = [
        line for radio in added for line in old_db("radios", "add", radio.type, *([radio.name] if radio.name else []))
    ]
    sets = [
        line
        for number, radio in enumerate(added, 1)
        for key, value in radio.settings
        for line in old_db("set", f"radio/{number}/{key}", value)
    ]
    return [*adds, *sets]


def daemon_lines(no_devices: bool) -> list[str]:
    """Run the installed daemon on the station's folder for RUN_SEC with the update check off.

    Its page must answer; `neoaprs.exe stop` then ends it. Its log lines are in $new."""
    return [
        "$env:NEOAPRS_UPDATE_CHECK = '0'",
        *(["$env:NEOAPRS_NO_DEVICES = '1'"] if no_devices else []),
        "$log = Join-Path $data 'neoaprs.log'",
        "$skip = if (Test-Path -LiteralPath $log) { @(Get-Content -LiteralPath $log).Count } else { 0 }",
        "$clock = [Diagnostics.Stopwatch]::StartNew()",
        "$p = Start-Process -FilePath (Join-Path $app 'neoaprsw.exe') -ArgumentList 'run', '--data', $data, '--web-port', '0' -PassThru",
        "$url = $null; foreach ($i in 1..180) { $m = Get-Content -LiteralPath $log -ErrorAction SilentlyContinue | Select-Object -Skip $skip | Select-String 'web page at (http://\\S+/)' | Select-Object -Last 1; "
        "if ($m) { $url = $m.Matches[0].Groups[1].Value; break }; if ($p.HasExited) { break }; Start-Sleep 1 }",
        fail_unless(
            "$url",
            "neoaprsw.exe run served no page",
            "Get-Content -LiteralPath $log -Tail 30 -ErrorAction SilentlyContinue",
        ),
        "$code = (Invoke-WebRequest $url -UseBasicParsing).StatusCode",
        '"the page $url answered $code, $([int]$clock.Elapsed.TotalSeconds) s after the start"',
        fail_unless("$code -eq 200", "the page does not answer"),
        f"$wait = {RUN_SEC} - [int]$clock.Elapsed.TotalSeconds; if ($wait -gt 0) {{ Start-Sleep $wait }}",
        fail_unless("-not $p.HasExited", "the daemon ended by itself", "Get-Content -LiteralPath $log -Tail 30"),
        '& $exe stop --data $data 2>&1 | ForEach-Object { "$_" }',
        fail_unless(NATIVE_OK, "neoaprs.exe stop failed"),
        fail_unless("$p.WaitForExit(60000)", "the daemon did not end after neoaprs.exe stop"),
        fail_unless(
            "(Get-Content -LiteralPath $log -Tail 1) -like '*NeoAPRS ended'",
            "the daemon did not end cleanly",
            "Get-Content -LiteralPath $log -Tail 10",
        ),
        "$new = @(Get-Content -LiteralPath $log | Select-Object -Skip $skip)",
        '"the daemon ran $([int]$clock.Elapsed.TotalSeconds) s and wrote $($new.Count) lines to its log"',
    ]


# calls of the packets the daemon logged
HEARD_LINES = [
    "'### heard'",
    "$new | ForEach-Object { if ($_ -match '  INFO  ([A-Z0-9]+(-[0-9]+)?)>') { $Matches[1] } } | Sort-Object -Unique",
]


def clean_log_lines() -> list[str]:
    return [
        "$trouble = @($new | Where-Object { $_ -match " + ps_quote(LOG_TROUBLE) + " })",
        fail_unless(
            "$trouble.Count -eq 0",
            "the daemon's log has an ERROR or a Traceback since this start",
            "$trouble | Select-Object -First 30",
        ),
    ]


def upgrade_steps(
    paths: Paths, old_name: str, old_version: str, new_name: str, new_version: str
) -> list[tuple[str, tuple[str, ...], float]]:
    """Return the steps of the upgrade proof: name, scripts (one after another) and time.

    What the new release must say of a migration follows from the old version (has_radios)."""
    up = upgrade_paths(paths, old_name, new_name)
    with_radios = has_radios(old_version)
    station_folder = [f"$data = {ps_quote(up.data)}", "$exe = Join-Path $app 'neoaprs.exe'"]
    old = install_script(
        "old", *setup_lines(up.old_setup, up.old_log), *files_lines(OLD_FILES), *version_lines(old_version)
    )
    listed = [
        *section("old db list", "db --data $data list", "the old release's db list failed", up.old_list),
        *section(
            "old db stations", "db --data $data stations", "the old release's db stations failed", up.old_stations
        ),
    ]
    station: tuple[str, ...]
    if with_radios:
        station = (
            install_script("station", *station_folder, *set_lines(STATION_OWN), *radio_lines(RADIOS)),
            install_script("station", *station_folder, *daemon_lines(no_devices=True)),
            install_script(
                "station",
                *station_folder,
                *section(
                    "old db radios", "db --data $data radios", "the old release's db radios failed", up.old_radios
                ),
                *listed,
                # the doctor is read only for the database version
                *section("old doctor", "doctor --data $data", "", up.old_doctor),
            ),
        )
    else:
        station = (
            install_script("station", *station_folder, *set_lines(STATION), *daemon_lines(no_devices=False)),
            install_script("station", *station_folder, *listed),
        )
    moved = f"$moved = @($new | Where-Object {{ $_ -match {ps_quote(MIGRATED)} }})"
    migration = (
        ["'### migrated'", "$moved"]
        if with_radios
        # read by check_migrate and check_radio_data
        else [
            "$moved",
            fail_unless(
                "@($moved | Where-Object { $_ -match 'brought up to date now' }).Count -eq 1",
                "the first start of the new release did not migrate the database",
            ),
            fail_unless(
                "@($moved | Where-Object { $_ -match 'a copy of it is in .*premigrate-v[0-9]+' }).Count -eq 1",
                "the migration took no copy of the database before it",
            ),
        ]
    )
    update = install_script(
        "update",
        *setup_lines(up.new_setup, up.new_log),
        *files_lines(INSTALLED_FILES),
        *version_lines(new_version),
        fail_unless(
            "-not (Test-Path -LiteralPath (Join-Path $app 'bin\\pmtiles.exe'))",
            "the update left bin\\pmtiles.exe of an earlier release",
        ),
        f"$entry = Get-ItemProperty -LiteralPath {ps_quote(UNINSTALL_KEY)} -ErrorAction SilentlyContinue",
        '"the Apps list: $($entry.DisplayName) $($entry.DisplayVersion)"',
        fail_unless(
            f"$entry.DisplayVersion -eq {ps_quote(new_version)}", f"the Apps list does not say NeoAPRS {new_version}"
        ),
    )
    migrate = install_script(
        "migrate", *station_folder, *daemon_lines(no_devices=True), *clean_log_lines(), moved, *migration
    )
    data = install_script(
        "data",
        *station_folder,
        *section("db radios", "db --data $data radios", "neoaprs.exe db radios failed on the updated station"),
        *section("db list", "db --data $data list", "neoaprs.exe db list failed on the updated station"),
        *section("db restore", "db --data $data restore", "neoaprs.exe db restore (the list of the copies) failed"),
        *section("db stations", "db --data $data stations", "neoaprs.exe db stations failed on the updated station"),
        *section("doctor", "doctor --data $data", "neoaprs.exe doctor found something to fix on the updated station"),
    )
    daemon = install_script(
        "daemon",
        *station_folder,
        *daemon_lines(no_devices=True),
        *clean_log_lines(),
        *HEARD_LINES,
        moved,
        fail_unless("$moved.Count -eq 0", "the second start of the new release migrated again", "$moved"),
        "'the second start migrated nothing'",
    )
    times = {"old": 600.0, "update": 600.0, "uninstall": 600.0}
    scripts = dict(
        zip(UPGRADE_STEP_NAMES, (old, station, update, migrate, data, daemon, uninstall_script(up.uninstall_log)))
    )
    return [
        (name, script if isinstance(script, tuple) else (script,), times.get(name, 300.0))
        for name, script in scripts.items()
    ]


def sections(text: str) -> dict[str, list[str]]:
    """A step's output cut at its lines `### TITLE`: the lines under each title."""
    found: dict[str, list[str]] = {}
    lines: list[str] | None = None
    for line in text.splitlines():
        if line.startswith("### "):
            lines = found.setdefault(line[4:].strip(), [])
        elif lines is not None:
            lines.append(line.rstrip())
    return found


LISTED = re.compile(r"(\S+) +(.*?) {2,}(\S.*)$")  # a line of `db list`: key, value, stored or default
SETTING = re.compile(r"(\S+) +(.*?) {2,}(stored|default)$")  # a setting line of `db list` or `db radios`
# a radio of `db radios`
RADIO = re.compile(r"radio (\d+)  (.+?)  (\S+)  (\S+)  (on|off|removed .+?)  \(position (\d+)\)$")
STATION_ROW = re.compile(r"(\S+) +\S+ +\d{4}-\d\d-\d\d \d\d:\d\d:\d\dZ ")  # a row of `db stations`
# The copy the first start of the new release takes is named by the schema version of the release
# before; any number is accepted.
COPY = re.compile(r"premigrate-v(\d+)\S*")
DATABASE = re.compile(r"ok +database \S+, version (\d+) ")  # doctor line of a usable database: its schema version
DOCTOR_RADIO = re.compile(r"ok +radio (.+?) \((\S+)\): ")  # doctor line of a radio: name and type key
# log line of a migrating start: from and to which version
MIGRATES = re.compile(r"is of version (\d+), this NeoAPRS needs (\d+): it is brought up to date now")


def listing(lines: Sequence[str]) -> dict[str, str]:
    """The keys of `db list` (or of a radio in `db radios`) and their values as they are shown."""
    found = {}
    for line in lines:
        matched = LISTED.match(line.strip())
        if matched and "/" in matched.group(1):
            found[matched.group(1)] = matched.group(2)
    return found


def settings_listed(lines: Sequence[str]) -> dict[str, tuple[str, str]]:
    """Return the settings in `db list` or `db radios` lines: key to (value, stored or default).

    A row the daemon keeps itself (when a beacon last went out) is not a setting."""
    found = {}
    for line in lines:
        matched = SETTING.match(line.strip())
        if matched and "/" in matched.group(1):
            found[matched.group(1)] = (matched.group(2), matched.group(3))
    return found


@dataclass(frozen=True)
class Radio:
    kind: str
    type: str
    state: str
    settings: dict[str, str]
    # what the release calls it: the name typed, else its word for the kind
    name: str = ""
    position: int = 0


def radios(lines: Sequence[str]) -> dict[int, Radio]:
    found: dict[int, Radio] = {}
    current: Radio | None = None
    for line in lines:
        matched = RADIO.match(line)
        if matched:
            current = found[int(matched.group(1))] = Radio(
                matched.group(3), matched.group(4), matched.group(5), {}, matched.group(2), int(matched.group(6))
            )
        elif current is not None and line.startswith("  "):
            current.settings.update(listing([line]))
    return found


def database_version(doctor: Sequence[str]) -> int | None:
    """Return the database version a release's doctor names, or None when it names none."""
    return next((int(matched.group(1)) for line in doctor if (matched := DATABASE.match(line))), None)


def station_calls(lines: Sequence[str]) -> list[str]:
    return [matched.group(1) for line in lines if (matched := STATION_ROW.match(line)) and matched.group(1) != "call"]


Checked = tuple[list[str], list[str]]  # what is wrong, and what is said when nothing is


def check_station(outputs: Mapping[str, str]) -> Checked:
    """Return the station as the old release keeps it: every value given and the stations its daemon
    heard."""
    old = sections(outputs.get("station", ""))
    kept = listing(old.get("old db list", []))
    problems = [
        f"the old release's db list has {key} as {kept.get(key)!r}, not {value!r}"
        for key, value in STATION
        if kept.get(key) != value
    ]
    call = dict(STATION)["station/call"]
    heard = [c for c in station_calls(old.get("old db stations", [])) if c != call]
    if not heard:
        problems.append("the old release's daemon heard no station of its Dummy radios (db stations lists none)")
    return problems, [
        f"the station of the release before: {len(kept)} rows in its db list, {len(heard)} stations heard besides its own"
    ] if not problems else []


def check_data(outputs: Mapping[str, str]) -> Checked:
    """Compare the updated station with the old: kept settings, radios made of flat keys, one copy,
    stations, doctor."""
    old, new = sections(outputs.get("station", "")), sections(outputs.get("data", ""))
    was, now = listing(old.get("old db list", [])), listing(new.get("db list", []))
    problems = [
        f"{key} was {was.get(key)!r} and is {now.get(key)!r} after the update"
        for key in KEPT_KEYS
        if now.get(key) != was.get(key)
    ]
    found = radios(new.get("db radios", []))
    for number, kind in RADIO_KINDS.items():
        keys = [key for key, (radio, _) in MOVED.items() if radio == number]
        wanted = number == 1 or was.get("hf/enabled") == "true"
        radio = found.get(number)
        if radio is None or radio.kind != kind:
            if wanted:
                problems.append(
                    f"db radios has no radio {number}, the {kind.upper()} radio that {' and '.join(keys)} made"
                )
            continue
        for key in keys:
            column = MOVED[key][1]
            shown = (
                radio.type
                if column == "type"
                else ("true" if radio.state == "on" else "false")
                if column == "on"
                else radio.settings.get(column)
            )
            if shown != was.get(key):
                problems.append(f"radio {number} has {column} {shown!r}, and the old {key} was {was.get(key)!r}")
    copy_problems, notes = check_copy(new.get("db restore", []))
    problems += [*copy_problems, *doctor_fails(new.get("doctor", [])), *lost_stations(old, new)]
    return problems, notes if not problems else []


def check_copy(restore: Sequence[str]) -> Checked:
    """Check that `db restore` lists exactly one premigrate-v... copy, marked as taken before the
    update."""
    copies = [line for line in restore if COPY.match(line)]
    if not copies:
        return [
            "db restore lists no copy premigrate-v...: the migration left no copy of the database from before it"
        ], []
    if len(copies) > 1:
        return [
            f"db restore lists {len(copies)} copies premigrate-v...: one is kept, the latest ({'; '.join(copy.split()[0] for copy in copies)})"
        ], []
    name = copies[0].split()[0]
    if "taken before the update" not in copies[0]:
        return [f"db restore does not mark {name} as taken before the update"], []
    return [], [
        f"the copy taken before the update: {name} (schema version {name.removeprefix('premigrate-v').split('-')[0]} of the release before)"
    ]


def doctor_fails(doctor: Sequence[str]) -> list[str]:
    return [f"doctor: {line.strip()}" for line in doctor if line.startswith("FAIL")]


def lost_stations(old: Mapping[str, list[str]], new: Mapping[str, list[str]]) -> list[str]:
    """Return one problem naming the stations the old release listed that the new one does not."""
    calls = set(station_calls(new.get("db stations", [])))
    lost = list(dict.fromkeys(c for c in station_calls(old.get("old db stations", [])) if c not in calls))
    return (
        [f"db stations has lost {len(lost)} of the stations the old release knew: {' '.join(lost[:10])}"]
        if lost
        else []
    )


def shown(setting: tuple[str, str] | None) -> str:
    """Return a setting as a problem names it: value and stored or default, or not listed."""
    return "not listed" if setting is None else f"{setting[0]!r} ({setting[1]})"


def named(radio: Radio) -> str:
    return f"{radio.name} ({radio.kind}, {radio.type}, {radio.state})"


def check_radio_station(outputs: Mapping[str, str]) -> Checked:
    """Return the station as a release with radios keeps it: stored values, the added radios and no
    other, versions, stations."""
    old = sections(outputs.get("station", ""))
    kept = settings_listed(old.get("old db list", []))
    problems = [
        f"the old release's db list has {key} as {shown(kept.get(key))}, not {value!r} (stored)"
        for key, value in STATION_OWN
        if kept.get(key) != (value, "stored")
    ]
    found, own = radios(old.get("old db radios", [])), settings_listed(old.get("old db radios", []))
    for number, added in enumerate(RADIOS, 1):
        radio = found.get(number)
        if radio is None or (radio.kind, radio.type, radio.state) != (added.kind, added.type, "on"):
            problems.append(
                f"the old release's db radios has no radio {number} of the type {added.type} (kind {added.kind}) that is on"
                + (f": it has {named(radio)}" if radio is not None else "")
            )
            continue
        if added.name and radio.name != added.name:
            problems.append(
                f"the old release's db radios calls radio {number} {radio.name!r}, and it was added with the name {added.name!r}"
            )
        for key, value in added.settings:
            if own.get(f"radio/{number}/{key}") != (value, "stored"):
                problems.append(
                    f"the old release's db radios has radio/{number}/{key} as {shown(own.get(f'radio/{number}/{key}'))}, not {value!r} (stored)"
                )
    if others := sorted(set(found) - set(range(1, len(RADIOS) + 1))):
        problems.append(
            f"the old release's db radios lists radio {', '.join(str(number) for number in others)} too, which nothing added"
        )
    version = database_version(old.get("old doctor", []))
    if version is None:
        problems.append(
            "the old release's doctor names no version of the database (its line `ok    database neoaprs.sqlite, version N`): whether the update has anything to migrate cannot be told"
        )
    call = dict(STATION_OWN)["station/call"]
    heard = list(dict.fromkeys(c for c in station_calls(old.get("old db stations", [])) if c != call))
    if not heard:
        problems.append("the old release's daemon heard no station of its Dummy radios (db stations lists none)")
    if problems:
        return problems, []
    return [], [
        f"the station of the release before: {', '.join(f'radio {number} {named(radio)}' for number, radio in sorted(found.items()))}; {len(kept)} settings in its db list and {len(own)} of its radios; "
        f"its database of version {version}; {len(heard)} stations heard besides its own"
    ]


def migration_lines(outputs: Mapping[str, str]) -> list[str]:
    """Return what the new release's first start logged of a migration (the lines under
    `migrated`)."""
    return [line for line in sections(outputs.get("migrate", "")).get("migrated", []) if re.search(MIGRATED, line)]


def check_migrate(outputs: Mapping[str, str]) -> Checked:
    """Check the first start on a station that already has radios: no migration, or one from the old
    doctor's version with one copy taken before it."""
    said = migration_lines(outputs)
    if not said:
        return [], ["the first start of the new release migrated nothing"]
    was = database_version(sections(outputs.get("station", "")).get("old doctor", []))
    begun = [matched for line in said if (matched := MIGRATES.search(line))]
    copies = [line for line in said if re.search(r"a copy of it is in .*premigrate-v[0-9]+", line)]
    problems = []
    if len(begun) != 1:
        problems.append(
            f"the first start of the new release says {len(begun)} times that it brings the database up to date, not once"
        )
    elif int(begun[0].group(1)) != was:
        problems.append(
            f"the first start of the new release migrated a database of version {begun[0].group(1)}, and the old release's doctor named version {was}"
        )
    if len(copies) != 1:
        problems.append(
            "the migration took no copy of the database before it"
            if not copies
            else f"the migration says {len(copies)} times that it took a copy of the database, not once"
        )
    return problems, [
        f"the first start of the new release migrated the database from version {begun[0].group(1)} to {begun[0].group(2)}"
    ] if not problems else []


DROPPED = frozenset({"station/main_radio"})  # settings a later release took away on purpose
# defaults changed on purpose: setting, default before, default after
CHANGED: Mapping[str, tuple[str, str]] = {}
STATUS_TICK = re.compile(r"radio/\d+/status$")  # status tick of the radio the main radio was


def same_settings(was: Mapping[str, tuple[str, str]], now: Mapping[str, tuple[str, str]]) -> list[str]:
    """Return what differs in the old release's settings: gone, changed, or stored and now default.

    A setting only the new release lists is its own; one named in DROPPED or CHANGED is no fault."""
    problems, ticked = [], []
    for key, (value, mark) in was.items():
        after, generic = now.get(key), re.sub(r"^radio/\d+/", "radio/N/", key)
        if after is None and (key in DROPPED or generic in DROPPED):
            continue
        meant = CHANGED.get(key) or CHANGED.get(generic)
        # the new default, stored by the new release or not
        if meant and mark == "default" and value == meant[0] and after is not None and after[0] == meant[1]:
            continue
        if STATUS_TICK.match(key) and (value, mark) == ("false", "default") and after == ("true", "stored"):
            ticked.append(key)
            continue
        if after is None or after[0] != value or (mark == "stored" and after[1] != "stored"):
            where = (
                "; if the new release takes it away on purpose, name it in DROPPED beside same_settings in scripts/check-windows"
                if after is None
                else "; if the new release changes this default on purpose, name it in CHANGED beside same_settings in scripts/check-windows"
                if mark == "default" and after[0] != value
                else ""
            )
            problems.append(f"{key} was {shown((value, mark))} and is {shown(after)} after the update{where}")
    if len(ticked) > 1:
        problems.append(
            f"the update ticked the status for more than one radio ({', '.join(ticked)}): it stands for the one radio the main radio was"
        )
    return problems


def check_radio_data(outputs: Mapping[str, str]) -> Checked:
    """Compare the updated station with what a release with radios reported: radios, names,
    settings, doctor, stations, copies."""
    old, new = sections(outputs.get("station", "")), sections(outputs.get("data", ""))
    problems = same_settings(settings_listed(old.get("old db list", [])), settings_listed(new.get("db list", [])))
    before, after = radios(old.get("old db radios", [])), radios(new.get("db radios", []))
    typed = {number for number, added in enumerate(RADIOS, 1) if added.name}
    notes = []
    for number in sorted(set(before) | set(after)):
        was, now = before.get(number), after.get(number)
        if now is None:
            problems.append(f"db radios has lost radio {number}, {named(before[number])}")
            continue
        if was is None:
            problems.append(f"db radios has a radio {number}, {named(now)}, that the old release did not list")
            continue
        for what, one, other in (
            ("kind", was.kind, now.kind),
            ("type", was.type, now.type),
            ("state", was.state, now.state),
            ("position", was.position, now.position),
        ):
            if one != other:
                problems.append(f"radio {number} had the {what} {one!r} and has {other!r} after the update")
        if was.name != now.name and number in typed:
            problems.append(f"radio {number} had the name {was.name!r} and has {now.name!r} after the update")
        # no name was typed: each release names the radio by its own word for the kind
        elif was.name != now.name:
            notes.append(
                f"radio {number} has no name of its own: the release before called it {was.name!r}, this one calls it {now.name!r}"
            )
    problems += same_settings(settings_listed(old.get("old db radios", [])), settings_listed(new.get("db radios", [])))
    doctor = new.get("doctor", [])
    lines = {(matched.group(1), matched.group(2)) for line in doctor if (matched := DOCTOR_RADIO.match(line))}
    problems += [
        f"doctor has no line `ok    radio {radio.name} ({radio.type}): ...` for radio {number}"
        for number, radio in sorted(after.items())
        if not radio.state.startswith("removed") and (radio.name, radio.type) not in lines
    ]
    problems += doctor_fails(doctor)
    was_version, version = database_version(old.get("old doctor", [])), database_version(doctor)
    copies = [line.split()[0] for line in new.get("db restore", []) if COPY.match(line)]
    migrated = migration_lines(outputs)
    if was_version is None or version is None:
        problems.append(
            f"doctor names no version of the database (the old release's: {was_version or 'none'}, the new one's: {version or 'none'}): whether a copy is due cannot be told"
        )
    elif version < was_version:
        problems.append(
            f"the database is of version {version} after the update and was of version {was_version} before it"
        )
    elif version == was_version:
        if copies:
            problems.append(
                f"db restore lists {' '.join(copies)}, and the database is of version {version} as it was before the update: nothing was to migrate"
            )
        if migrated:
            problems.append(
                f"the first start of the new release said it migrated, and the database is of version {version} as it was before the update"
            )
        notes.append(
            f"the database is of version {version} before and after the update: nothing to migrate, and no copy premigrate-v... was taken"
        )
    else:
        copy_problems, copy_notes = check_copy(new.get("db restore", []))
        problems += copy_problems
        notes += copy_notes
        if len(copies) == 1 and not copies[0].startswith(f"premigrate-v{was_version}-"):
            problems.append(
                f"db restore lists {copies[0]}, and the database of the release before was of version {was_version}"
            )
        if not migrated:
            problems.append(
                f"the database went from version {was_version} to {version}, and the log of the new release's first start says nothing of a migration"
            )
    problems += lost_stations(old, new)
    if problems:
        return problems, []
    return [], [
        f"the radios after the update: {', '.join(f'radio {number} {named(radio)}' for number, radio in sorted(after.items()))}",
        *notes,
    ]


def check_daemon(outputs: Mapping[str, str]) -> Checked:
    """Check that the new daemon heard again the stations the old one heard."""
    call = dict(STATION)["station/call"]
    before = {c for c in station_calls(sections(outputs.get("station", "")).get("old db stations", [])) if c != call}
    heard = {line.strip() for line in sections(outputs.get("daemon", "")).get("heard", []) if line.strip()}
    again = sorted(before & heard)
    if not again:
        return [
            "the new daemon heard none of the stations the old one heard: the Dummy radios did not come through the update"
        ], []
    return [], [f"heard again after the update: {' '.join(again[:8])}{' ...' if len(again) > 8 else ''}"]


Checks = Mapping[str, Callable[[Mapping[str, str]], Checked]]
# from a release with flat keys
UPGRADE_CHECKS: Checks = {"station": check_station, "data": check_data, "daemon": check_daemon}
# from a release with radios
RADIO_CHECKS: Checks = {
    "station": check_radio_station,
    "migrate": check_migrate,
    "data": check_radio_data,
    "daemon": check_daemon,
}


def upgrade_checks(old_version: str) -> Checks:
    """What the proof reads from the steps' output, for the kind of release the old one is."""
    return RADIO_CHECKS if has_radios(old_version) else UPGRADE_CHECKS


def checked(result: StepResult, outputs: Mapping[str, str], checks: Checks = UPGRADE_CHECKS) -> StepResult:
    """Hold a passed step to what the proof reads from its output; problems fail it and go under its
    line and log."""
    check = checks.get(result.name)
    if result.code != 0 or check is None:
        return result
    problems, notes = check(outputs)
    for note in notes:
        say(note)
    if not problems:
        return result
    with result.log.open("a", encoding="utf-8") as log:
        log.write("".join(f"{problem}\n" for problem in problems))
    return StepResult(result.name, 1, result.seconds, result.log, tuple(problems))


def run_parts(
    settings: Settings, paths: Paths, name: str, parts: Sequence[str], timeout_sec: float, log_dir: Path
) -> StepResult:
    """Run a step of several scripts as run_script does, until one fails, with one log under the
    step's name."""
    if len(parts) == 1:
        return run_script(settings, paths, name, parts[0], timeout_sec, log_dir)
    results: list[StepResult] = []
    for index, part in enumerate(parts, 1):
        results.append(run_script(settings, paths, f"{name}-{index}", part, timeout_sec, log_dir))
        if results[-1].code != 0:
            break
    log = log_dir / f"{name}.log"
    log.write_text(
        "".join(result.log.read_text(encoding="utf-8", errors="replace") for result in results), encoding="utf-8"
    )
    for result in results:
        result.log.unlink()
    last = results[-1]
    return StepResult(name, last.code, sum(result.seconds for result in results), log, last.tail)


def execute_upgrade(settings: Settings, old: Path, old_version: str, new: Path, new_version: str) -> int:
    """Run the upgrade proof; each step needs the ones before it, none follows a failed step."""
    paths = windows_paths(settings.user, run_name(time.time()))
    up = upgrade_paths(paths, old.name, new.name)
    log_dir = Path(tempfile.mkdtemp(prefix="neoaprs-check-windows-upgrade-"))
    say(f"the logs are in {log_dir}")
    checks = upgrade_checks(old_version)
    say(
        f"the release before, {old_version}, "
        + (
            "has radios: its station is made with `db radios add`, and the new release must list the same radios"
            if has_radios(old_version)
            else "keeps a radio's settings in flat keys: its station is made with them, and the new release must have made radios of them"
        )
    )
    make_root(settings, paths)
    remote_must(
        settings,
        f"$ErrorActionPreference = 'Stop'; New-Item -ItemType Directory -Force -Path {ps_quote(paths.run)} | Out-Null; exit 0",
        "the folder of the run could not be made",
    )
    for installer, target in ((old, up.old_setup), (new, up.new_setup)):
        say(f"copying {installer.name} to {paths.run}")
        copy_to(settings, installer, target)
    results: list[StepResult] = []
    outputs: dict[str, str] = {}
    total = time.monotonic()
    try:
        for name, parts, timeout_sec in upgrade_steps(paths, old.name, old_version, new.name, new_version):
            result = run_parts(settings, paths, name, parts, timeout_sec, log_dir)
            outputs[name] = result.log.read_text(encoding="utf-8", errors="replace")
            result = checked(result, outputs, checks)
            results.append(result)
            print("\n".join(report_lines(result)), flush=True)
            if result.code != 0:
                break
    finally:
        remove_old_runs(settings, paths)
    print(summary(results, time.monotonic() - total), flush=True)
    return exit_code(results)


# ---- the command ----


INTERRUPTS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)


def interrupted(number: int, frame: FrameType | None) -> None:
    raise KeyboardInterrupt


def parse(
    argv: Sequence[str], split: Callable[[Sequence[str]], tuple[list[str], list[str]]]
) -> tuple[argparse.Namespace, list[str]]:
    own, pytest_args = split(argv)
    parser = argparse.ArgumentParser(
        prog="check-windows",
        usage="scripts/check-windows [--only NAME]... [--snapshot NAME] [--tty] [-- PYTEST-ARGS...]\n       scripts/check-windows --install INSTALLER --snapshot NAME\n       scripts/check-windows --upgrade OLD-INSTALLER NEW-INSTALLER --snapshot NAME",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--only",
        action="append",
        default=[],
        choices=[step.name for step in steps(windows_paths("x", "x"))],
        metavar="NAME",
        help="run only this step (repeatable): sync lock ruff pytest smoke",
    )
    parser.add_argument(
        "--snapshot",
        default="",
        metavar="NAME",
        help="put the machine back to this snapshot before it is started (only while it is powered off)",
    )
    parser.add_argument(
        "--tty", action="store_true", help="run the pytest step through ssh -tt without trying a plain session first"
    )
    parser.add_argument(
        "--install",
        default="",
        metavar="INSTALLER",
        help="the install proof of this NeoAPRS-Setup-VERSION.exe, on the machine put back to --snapshot, instead of the CI's steps",
    )
    parser.add_argument(
        "--upgrade",
        nargs=2,
        default=[],
        metavar=("OLD", "NEW"),
        help="the upgrade proof: the installer of the release before, a station made with it, then this NeoAPRS-Setup-VERSION.exe over it, "
        "on the machine put back to --snapshot, instead of the CI's steps",
    )
    args = parser.parse_args(own)
    if args.install and args.upgrade:
        parser.error("--install and --upgrade are two proofs: one at a time")
    for option, given in (("--install", args.install), ("--upgrade", args.upgrade)):
        if not given:
            continue
        if args.only or pytest_args or args.tty:
            parser.error(f"{option} runs its proof alone: no --only, --tty or arguments for pytest with it")
        if not args.snapshot:
            parser.error(
                f"{option} starts from a clean machine: give --snapshot NAME, the snapshot of the clean Windows"
            )
    if pytest_args and args.only and "pytest" not in args.only:
        parser.error("arguments after -- are for pytest, and --only does not name it")
    if pytest_args and not args.only:
        args.only = ["pytest"]
    return args, pytest_args


def main(argv: Sequence[str] | None = None) -> int:
    packer = load_script("check-in-container")
    args, pytest_args = parse(sys.argv[1:] if argv is None else argv, packer.split_command)
    try:
        settings = read_settings(os.environ)
        for tool in ("ssh", "scp", "VBoxManage", "git"):
            if shutil.which(tool) is None:
                raise NotSetUp(f"{tool} is not installed (the Windows check needs ssh, scp, VBoxManage and git)")
        problems = missing_files(settings)
        if problems:
            raise NotSetUp("; ".join(problems))
        installer = Path(args.install)
        version = installer_version(installer) if args.install else ""
        tornado = tornado_pin((ROOT / "pyproject.toml").read_text(encoding="utf-8")) if args.install else ""
        direwolf = (
            direwolf_banner((ROOT / "neoaprs" / "direwolf.py").read_text(encoding="utf-8")) if args.install else ""
        )
        old, new = (Path(args.upgrade[0]), Path(args.upgrade[1])) if args.upgrade else (Path(), Path())
        old_version, new_version = upgrade_versions(old, new) if args.upgrade else ("", "")
    except NotSetUp as error:
        say(str(error))
        return NOT_SET_UP
    cache = build_cache(os.environ)
    # Pack the tree before touching the machine (install proof: only the smoke scripts; upgrade
    # proof: nothing).
    with tempfile.TemporaryDirectory(prefix="neoaprs-check-windows-tar-") as scratch:
        tar = Path(scratch) / "tree.tar"
        try:
            if args.install:
                pack_kit(ROOT, tar)
            elif not args.upgrade:  # the upgrade proof takes nothing of the tree
                with tar.open("wb") as out:
                    packer.pack(ROOT, out)
        except (packer.NotPacked, OSError) as error:
            say(f"nothing was run: {error}")
            return NOT_SET_UP
        for number in INTERRUPTS:
            signal.signal(number, interrupted)
        started_by_us = False
        try:
            with run_lock(lock_path(os.environ, settings.vm)):
                plan = plan_power(vm_state(settings.vm), args.snapshot, settings.vm)
                if plan.start:
                    started_by_us = True
                    start_vm(settings, plan, args.snapshot)
                wait_for_ssh(settings, SSH_PATIENCE_SEC if plan.start else 60.0)
                if plan.start:
                    wait_until_settled(settings)
                if args.upgrade:
                    return execute_upgrade(settings, old, old_version, new, new_version)
                if args.install:
                    return execute_install(settings, installer, version, tornado, direwolf, tar, cache)
                return execute(settings, chosen_steps(args.only), pytest_args, tar, cache, args.tty)
        except (Refused, Busy) as error:
            say(str(error))
            return NOT_SET_UP
        except KeyboardInterrupt:
            say("interrupted")
            return 130
        finally:
            if started_by_us:
                # a further signal must not cancel the shutdown
                for number in INTERRUPTS:
                    signal.signal(number, signal.SIG_IGN)
                power_off(settings)


if __name__ == "__main__":
    sys.exit(main())

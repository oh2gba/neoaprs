#!/usr/bin/env bash
# The smoke test of the macOS app made by scripts/build-macos-app, as a user would meet it: the disk image opened and the app copied out of it, run on a home and data folders of its own, with no radio and no serial device,
# and nothing leaves the loopback.
#
#   scripts/smoke-macos-app FILE [--python PYTHON] [--no-mercury]
#
# FILE is the .dmg (or an unpacked NeoAPRS.app). It checks, in order: the signature (`codesign --verify --deep --strict`); `--version` through the launcher; the Mercury inside (Contents/Resources/tools/mercury/mercury must
# load the system's frameworks alone and say the version neoaprs/mercury.py pins; --no-mercury for an app built with scripts/build-macos-app --no-mercury); the install kind the Python inside detects (macos-app, arm64);
# scripts/smoke.py against the launcher (a fake KISS TNC on a TCP port, the page and its WebSocket, the stop by SIGTERM); the daemon on its own (no `--port`: it has no radio, the page answers, it ends cleanly); `service
# install` with a HOME and a launchctl of the test's own, whose agent must run the Python inside the bundle; and the desktop app started with no arguments on the offscreen platform, which must start its daemon and the window
# with the web engine, stay up, and end at `app --quit` together with the daemon. PYTHON (default .venv/bin/python, else python3) runs smoke.py and needs Tornado. Exit code 0: all is well; 1: the first thing that was not.
case "${1:-}" in -h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;; esac
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

file="${1:-}"
[ -e "$file" ] || { echo "smoke-macos-app: usage: scripts/smoke-macos-app FILE [--python PYTHON] [--no-mercury]" >&2; exit 2; }
shift
python="$ROOT/.venv/bin/python"
[ -x "$python" ] || python=python3
with_mercury=1
while [ $# -gt 0 ]; do
    case "$1" in
        --python) python="${2:?--python needs a program}"; shift ;;
        --no-mercury) with_mercury=0 ;;
        *) echo "smoke-macos-app: unknown argument $1" >&2; exit 2 ;;
    esac
    shift
done
[ "$(uname -s)" = Darwin ] || { echo "smoke-macos-app: this runs on macOS only" >&2; exit 1; }

export NEOAPRS_UPDATE_CHECK=0           # none of the daemons below asks the version page
say() { echo "smoke-macos-app: $*"; }
fail() { echo "smoke-macos-app: FAILED: $*" >&2; exit 1; }

work="$(mktemp -d)"
pids=()
mounted=""
cleanup() {
    for pid in ${pids[@]+"${pids[@]}"}; do kill "$pid" 2>/dev/null || true; done
    [ -z "$mounted" ] || hdiutil detach "$mounted" -quiet 2>/dev/null || true
    rm -rf "$work"
}
trap cleanup EXIT
# a variable of the shell this is run from could point the program at a data folder or a home of the user's; the data folder of a Mac is under the home, so the home is the test's own
unset NEOAPRS_DATA_DIR NEOAPRS_DEBUG
export HOME="$work/home"
mkdir -p "$HOME"

# the app out of the image (a user drags it to Applications: ditto is that copy), or the folder given
if [ -d "$file" ]; then
    app="$work/NeoAPRS.app"
    ditto "$file" "$app"
else
    say "the disk image opens and holds NeoAPRS.app and a link to Applications"
    mounted="$work/mnt"
    hdiutil attach -nobrowse -readonly -mountpoint "$mounted" "$file" -quiet || fail "the disk image could not be opened"
    [ -d "$mounted/NeoAPRS.app" ] && [ -L "$mounted/Applications" ] || { ls -la "$mounted" >&2; fail "the image does not hold NeoAPRS.app and the Applications link"; }
    app="$work/NeoAPRS.app"
    ditto "$mounted/NeoAPRS.app" "$app"
    hdiutil detach "$mounted" -quiet
    mounted=""
fi
run="$app/Contents/MacOS/NeoAPRS"
res="$app/Contents/Resources"
inner="$res/bin/python3.13"

say "the bundle is signed, every file sealed"
codesign --verify --deep --strict --verbose=2 "$app" || fail "the signature does not verify"
plutil -lint "$app/Contents/Info.plist" > /dev/null || fail "Info.plist is not a plist"
[ -f "$res/NeoAPRS.icns" ] && [ -f "$res/en.lproj/InfoPlist.strings" ] || fail "the icon or the microphone sentence is missing"

say "--version"
"$run" --version | grep -q '^NeoAPRS [0-9]' || fail "--version did not say NeoAPRS and a number"

if [ "$with_mercury" = 1 ]; then
    say "the Mercury inside loads the system's frameworks alone and is the pinned version"
    folder="$res/tools/mercury"
    [ -x "$folder/mercury" ] && [ -f "$folder/LICENSE" ] || fail "the app has no Mercury in Contents/Resources/tools/mercury"
    [ ! -e "$folder/dev" ] || fail "the simulators of Mercury's dev/ folder are in the app"
    wanted="$(sed -n 's/^VERSION = "\([^"]*\)".*/\1/p' "$ROOT/neoaprs/mercury.py")"
    otool -L "$folder/mercury" | tail -n +2 | grep -qv '/System/Library/Frameworks/\|/usr/lib/libSystem\.' && fail "Mercury loads a library that is not the system's: $(otool -L "$folder/mercury" | tail -n +2 | tr -s '\t ' ' ')"
    said="$("$folder/mercury" -V 2>&1 || true)"
    echo "$said" | grep -qF "$wanted" || fail "mercury -V says '$said', not the pinned $wanted"
fi

say "the Python inside knows it is the macOS app on Apple silicon"
"$inner" -I - <<'PY' || fail "the install kind is not macos-app arm64"
import sys
from pathlib import Path
from neoaprs.cli.installkind import detect_here
info = detect_here(Path("/nonexistent"))
assert (info.kind, info.arch) == ("macos-app", "arm64"), info
assert Path(sys.prefix).name == "Resources", sys.prefix
PY

say "scripts/smoke.py against the launcher"
"$python" "$ROOT/scripts/smoke.py" --command "$run"

# The daemons with no radio search no port: on a machine with serial devices they would listen to them all (other programs' ports, boards that reset when opened).
NO_PORTS=/dev/neoaprs-smoke-no-such-port

# wait_for FILE PATTERN SECONDS: until the log has the line
wait_for() {
    local i
    for ((i = 0; i < $3 * 4; i++)); do
        grep -qs -- "$2" "$1" && return 0
        sleep 0.25
    done
    return 1
}

say "the daemon with no radio: the page answers, it ends cleanly"
data="$work/headless"
"$run" db --data "$data" set serial/pattern "$NO_PORTS" > /dev/null
"$run" --data "$data" --web-port 0 > "$work/headless.out" 2>&1 &
pids+=($!)
wait_for "$data/neoaprs.log" "web page at http" 60 || { cat "$work/headless.out"; fail "the daemon did not log its page"; }
url="$(sed -n 's/.*web page at \(http:[^ ]*\).*/\1/p' "$data/neoaprs.log" | tail -n 1)"
[ "$(curl -s -o /dev/null -w '%{http_code}' "$url")" = 200 ] || fail "the page at $url does not answer 200"
kill -TERM "${pids[0]}"
wait "${pids[0]}" || fail "the daemon did not end with exit code 0 after SIGTERM"
pids=()
tail -n 1 "$data/neoaprs.log" | grep -q 'NeoAPRS ended$' || fail "the last line of the log is not 'NeoAPRS ended'"

say "service install writes an agent that runs the Python inside the bundle"
mkdir -p "$work/fake-bin"
printf '#!/bin/sh\nexit 0\n' > "$work/fake-bin/launchctl"
chmod +x "$work/fake-bin/launchctl"
PATH="$work/fake-bin:$PATH" "$run" service install --data "$work/service-data" > "$work/service.out" 2>&1 || { cat "$work/service.out"; fail "service install failed"; }
agent="$HOME/Library/LaunchAgents/eu.oh2gba.neoaprs.plist"
[ -f "$agent" ] || fail "no agent was written at $agent"
plutil -extract ProgramArguments.0 raw -o - "$agent" | grep -qxF "$inner" || { plutil -p "$agent" >&2; fail "the agent does not run $inner"; }

say "the desktop app (no arguments, offscreen) starts its daemon and the window, and ends at --quit"
app_data="$work/app-data"
"$run" db --data "$app_data" set web/port 0 > /dev/null
"$run" db --data "$app_data" set serial/pattern "$NO_PORTS" > /dev/null
export NEOAPRS_DATA_DIR="$app_data"
QT_QPA_PLATFORM=offscreen QTWEBENGINE_CHROMIUM_FLAGS=--disable-gpu "$run" > "$work/app.out" 2>&1 &
shell=$!
pids=("$shell")
wait_for "$app_data/neoaprs-app.log" "the Qt shell runs" 90 || { cat "$work/app.out"; tail -n 20 "$app_data/neoaprs-app.log" >&2 || true; fail "the app did not start its window"; }
grep -q 'window and tray' "$app_data/neoaprs-app.log" || fail "the app chose no window and tray"
url="$(sed -n 's/.*web page at \(http:[^ ]*\).*/\1/p' "$app_data/neoaprs.log" | tail -n 1)"
[ "$(curl -s -o /dev/null -w '%{http_code}' "$url")" = 200 ] || fail "the page at $url does not answer 200"
sleep 5
kill -0 "$shell" 2>/dev/null || { cat "$work/app.out"; fail "the app ended by itself"; }
"$run" app --quit --data "$app_data" || fail "app --quit failed"
wait "$shell" || { cat "$work/app.out"; fail "the app did not end with exit code 0"; }
pids=()
unset NEOAPRS_DATA_DIR
tail -n 1 "$app_data/neoaprs.log" | grep -q 'NeoAPRS ended$' || fail "the daemon of the app did not end cleanly"
say "ok"

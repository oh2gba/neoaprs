#!/usr/bin/env bash
# Builds NeoAPRS-<version>-x86_64.AppImage, the Linux download: one file that holds CPython, the wheel with the locked dependencies of its extra `app` (Qt with its web engine) and the icon.
#
#   scripts/build-appimage [--wheel FILE] [--out DIR]
#
# Without --wheel the wheel is built from this tree (uv build). The file is made in DIR (default dist-appimage/). The tools are fetched once into $NEOAPRS_BUILD_CACHE (default ~/.cache/neoaprs-build), each
# pinned by version and SHA-256 below (the digest GitHub shows for each file of the release; the pin is the trust, not the server): the relocatable CPython of python-build-standalone, appimagetool and the
# AppImage runtime it puts in front of the image. The runtime is static: the computer that runs the file needs FUSE (fusermount and /dev/fuse), not libfuse2. Needs uv, curl and a Linux x86_64 machine;
# the work folder is build/appimage/. How it behaves and what it holds: docs/manual/install.md, "Linux AppImage", and docs/development.md, "The AppImage". scripts/smoke-appimage tries the file.
case "${1:-}" in -h|--help) awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;; esac
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PYTHON_URL="https://github.com/astral-sh/python-build-standalone/releases/download/20261021/cpython-3.13.17%2B20261021-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz"
PYTHON_SHA256="f829adc9d888e76c8801b4799ed444188d35239fcae3a9808a99ec5cb0d8d92c"
TOOL_URL="https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage"
TOOL_SHA256="ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0"
RUNTIME_URL="https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64"
RUNTIME_SHA256="2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d"

wheel=""
out="$ROOT/dist-appimage"
while [ $# -gt 0 ]; do
    case "$1" in
        --wheel) shift; wheel="${1:-}"; [ -f "$wheel" ] || { echo "build-appimage: --wheel needs a wheel file" >&2; exit 2; } ;;
        --out) shift; out="${1:-}"; [ -n "$out" ] || { echo "build-appimage: --out needs a folder" >&2; exit 2; } ;;
        *) echo "build-appimage: unknown argument $1" >&2; exit 2 ;;
    esac
    shift
done
[ "$(uname -s)-$(uname -m)" = Linux-x86_64 ] || { echo "build-appimage: this builds for Linux x86_64 only" >&2; exit 1; }
command -v uv >/dev/null || { echo "build-appimage: uv is not installed" >&2; exit 1; }
command -v curl >/dev/null || { echo "build-appimage: curl is not installed" >&2; exit 1; }

cache="${NEOAPRS_BUILD_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/neoaprs-build}"
mkdir -p "$cache"

# fetch URL SHA256: the file in the cache, downloaded when it is not there or not the pinned one; its path on stdout
fetch() {
    local file="$cache/$(basename "${1//%2B/+}")"
    if [ ! -f "$file" ] || [ "$(sha256sum "$file" | cut -d' ' -f1)" != "$2" ]; then
        curl -fsSL --retry 3 -o "$file.part" "$1"
        [ "$(sha256sum "$file.part" | cut -d' ' -f1)" = "$2" ] || { rm -f "$file.part"; echo "build-appimage: $1 is not the file with SHA-256 $2" >&2; exit 1; }
        mv "$file.part" "$file"
    fi
    echo "$file"
}

if [ -z "$wheel" ]; then
    rm -rf "$ROOT/dist-wheel"
    uv build --wheel --out-dir "$ROOT/dist-wheel"
    wheel="$(ls "$ROOT"/dist-wheel/neoaprs-*.whl)"
fi
version="$(sed -n 's/^VERSION = "\([^"]*\)".*/\1/p' "$ROOT/neoaprs/__init__.py")"
case "$(basename "$wheel")" in neoaprs-"$version"-*.whl) ;; *) echo "build-appimage: $wheel is not the wheel of $version" >&2; exit 1 ;; esac
python_tar="$(fetch "$PYTHON_URL" "$PYTHON_SHA256")"
appimagetool="$(fetch "$TOOL_URL" "$TOOL_SHA256")"
runtime="$(fetch "$RUNTIME_URL" "$RUNTIME_SHA256")"
chmod +x "$appimagetool"

work="$ROOT/build/appimage"
app="$work/AppDir"
rm -rf "$work"
mkdir -p "$app" "$out"

# CPython: the archive holds one folder, python/, laid out as a prefix (bin, lib); it is the AppDir's usr/
tar -xzf "$python_tar" -C "$work"
mv "$work/python" "$app/usr"
python="$app/usr/bin/python3"
"$python" --version

# The locked dependencies of the extra `app` for Linux, then the wheel on top; the programs the installs make have this machine's path in them and are of no use here (AppRun runs `python -m neoaprs`)
(cd "$ROOT" && uv export --frozen --no-dev --no-emit-project --no-hashes --extra app -o "$work/requirements.txt")
uv pip install --python "$python" --break-system-packages --no-config -r "$work/requirements.txt"
uv pip install --python "$python" --break-system-packages --no-config --no-deps "$wheel"
find "$app/usr/bin" -type f ! -name 'python3*' -delete
find "$app/usr/bin" -xtype l -delete

# Size: what the image does not run is taken out
"$python" -I "$ROOT/packaging/appimage/prune.py" "$app/usr"

install -m 755 "$ROOT/packaging/appimage/AppRun" "$app/AppRun"
install -m 644 "$ROOT/packaging/appimage/neoaprs.desktop" "$app/neoaprs.desktop"
# the icon at its largest size (the 256 px frame of the Windows icon is a PNG), for the launcher; .DirIcon is what file managers show for the file
"$python" -I - "$ROOT/neoaprs/desktop/icon.ico" "$app/neoaprs.png" <<'PY'
import struct
import sys
data = open(sys.argv[1], "rb").read()
count = struct.unpack("<H", data[4:6])[0]
frames = [struct.unpack("<BBBBHHII", data[6 + 16 * i:22 + 16 * i]) for i in range(count)]
size, offset = max(frames, key=lambda f: f[6])[6:]
png = data[offset:offset + size]
assert png.startswith(b"\x89PNG"), "the largest frame of the icon is not a PNG"
open(sys.argv[2], "wb").write(png)
PY
ln -s neoaprs.png "$app/.DirIcon"

# bytecode of the image's packages, made now because the mounted image is read-only (unchecked: the image never changes)
"$python" -I -m compileall -q --invalidation-mode unchecked-hash "$app/usr/lib/python3.13" >/dev/null

target="$out/NeoAPRS-$version-x86_64.AppImage"
rm -f "$target"
ARCH=x86_64 APPIMAGE_EXTRACT_AND_RUN=1 "$appimagetool" --no-appstream --runtime-file "$runtime" --comp zstd "$app" "$target"
chmod +x "$target"
echo "build-appimage: $target ($(du -h "$target" | cut -f1); the image holds $(du -sh "$app" | cut -f1))"

#!/usr/bin/env python3
"""The security checks that need a program of their own, as one command: scripts/check runs it as the stage `security`, and with --audit as the stage `audit`.

    scripts/security-check                 the checks that ask nobody: secret-files, tokens, gitleaks, php-lint, psalm, shellcheck, zizmor
    scripts/security-check --all-history   the same, and `tokens` reads every commit there is (the remote's branches too), not only the ones the remote does not have yet
    scripts/security-check --audit         the advisory check alone: osv-scanner asks osv.dev about every package of uv.lock and ui/package-lock.json
    scripts/security-check --only NAME     one of the checks by its name (may be given several times)
    scripts/security-check --update        write scripts/security-baseline.json from what shellcheck and zizmor find today; it is never made larger unless --allow-growth says that is meant

One line per check, `ok` or `FAIL` with its time, and under a failing one what was found (under a passing one what it read, where that says something); exit 1 when any failed.

    secret-files no path with a part named .secrets, or .secrets with anything after it, is tracked by git (a file or a folder), and none lies in the tree where git does not ignore it:
                 such a file holds access tokens. Names only: nothing is opened
    tokens       nothing of the form of the secrets manager's access token is on its way to GitHub. This script looks itself, with no program and no list of exceptions: in every commit
                 of a local branch or tag that the remote does not have (what it changes, a merge's resolution, its message), in the messages of the tags, in the index as it is staged
                 and in every tracked file, read as bytes whatever the file is. It names the commit and the file, never what it found
    gitleaks     no secret of any other kind in the commits of this branch, in their messages, or in the tracked files that are changed or staged (the report hides what it found);
                 .gitleaks.toml lists the made-up values, each with its reason
    php-lint     `php -l` over every tracked *.php of server/
    psalm        Psalm follows what a request sends to where it is used in server/ (server/psalm.xml); only its Tainted* reports count. Where the system's php lacks the XML extensions
                 Psalm needs, it runs in the pinned php image with docker, server/ read-only and no network
    shellcheck   at the level `warning` over the tracked shell scripts of server/, scripts/ and packaging/, against the baseline; no settings file is read, and one that is tracked,
                 or a `disable` comment without its reason, is a finding
    zizmor       the workflows of .github/workflows, offline, from the severity `medium` up, against the baseline; no settings file is read, and one that is tracked is a finding
    audit        osv-scanner over both lock files; osv-scanner.toml lists the advisories set aside, each with its reason and the day it ends

The checks read what git tracks: no file of the developer's own folders in the checkout is opened (zizmor and Psalm are given their one folder, .github/workflows and server/, as it lies). The
programs are the pinned ones scripts/security-tools fetches into the build cache; php is the system's. A program that is not there fails its check and the line says how to get it: a check that could not run is never a pass. The baseline holds what shellcheck and
zizmor are known to find today, each entry with its count and its reason; a finding that is not in it, or one more of a kind that is, fails. How to read a failure and how an entry is added:
docs/security-checks.md. The standard library only."""
import argparse
import base64
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import textwrap
import time
import tomllib
import uuid
from collections import Counter
from collections.abc import Callable, Iterator
from dataclasses import dataclass
from pathlib import Path
from types import ModuleType
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
BASELINE = ROOT / "scripts" / "security-baseline.json"
GUIDE = "docs/security-checks.md"
NEVER_TRACKED = ".secrets"                  # a file or folder whose name begins so holds access tokens (server/deploy.sh reads one); .gitignore names it and git never tracks it
OUR_RULE = "bitwarden-secrets-manager-access-token"                             # the rule of .gitleaks.toml for the access token of the secrets manager
REMOTE = "origin"                           # where scripts/release pushes: a commit that one of its branches has is on GitHub already
GIT_PLAIN = ("-c", "core.quotePath=false", "-c", "diff.noprefix=false", "-c", "diff.mnemonicPrefix=false", "-c", "log.showSignature=false")       # git prints the same whatever the developer's own settings are
GIT_SETTINGS = (("color.ui", "false"), ("color.diff", "false"), ("log.showRoot", "true"))                                                        # what every git is told through its environment, the one gitleaks starts too: with the developer's `color.ui = always` gitleaks finds nothing in the commits, with `log.showRoot = false` nothing in the first one
CHUNK = 1 << 20                             # how much of git's output is read at a time
CHANGED, STAGED, MESSAGES = "changed", "staged", "messages"                     # the folders gitleaks is shown what its reading of the commits does not see
SHELL_FOLDERS = ("server", "scripts", "packaging")
SHEBANG = re.compile(rb"#!\s*/(usr/)?bin/(env\s+)?(ba)?sh\b")
SETTINGS_FILES = {"shellcheck": (".shellcheckrc", "shellcheckrc"), "zizmor": ("zizmor.yml", "zizmor.yaml", ".zizmor.yml", ".zizmor.yaml")}        # where each tool looks for settings that can switch findings off
SETTINGS_OF_THE_SHELL = ("SHELLCHECK_OPTS", "ZIZMOR_CONFIG", "GITLEAKS_CONFIG", "GITLEAKS_CONFIG_TOML")                                          # the same from the environment: no program is handed them
DISABLE = re.compile(rb"^[ \t]*#[ \t]*shellcheck[ \t][^#\n]*?\bdisable=(?P<rules>[^#\s]*)[^#\n]*(?:#(?P<reason>.*))?$", re.MULTILINE)                              # shellcheck's comment that switches rules off, and what follows it on the line
ZIZMOR_SEVERITY = "medium"                  # the lowest severity that counts; what zizmor rates lower (a checkout that leaves its token in the job, a value of the workflow's own in a shell line) is not held here
ZIZMOR_FOUND = range(10, 15)                # zizmor's exit codes for "findings", by the highest severity among them
LOCK_FILES = ("uv.lock", "ui/package-lock.json")
PSALM_EXTENSIONS = ("dom", "simplexml")     # what Psalm needs of php beyond a bare php-cli
PSALM_ARGS = ("--config=server/psalm.xml", "--taint-analysis", "--output-format=json", "--no-cache", "--no-progress", "--threads=1")
PSALM_FOLDER = "/neoaprs"                   # where the container sees the tree: server/ under it, so that Psalm names the files as it does outside
DOCKER_FAILED = 125                         # docker's exit code when it could not start the container at all (the image is not there, the daemon refused)
TIMEOUT_SEC = 600.0

Entries = dict[str, dict[str, Any]]         # of one tool in the baseline: the key of a finding, its count and its reason


class Failed(Exception):
    """A check found something or could not be made; the text is what is printed under its line."""


@dataclass(frozen=True)
class Finding:
    key: str                                # what the baseline counts: the file, the rule and what it is about, never a line number (lines move when someone edits above them)
    place: str
    text: str


def load_tools() -> ModuleType:
    """scripts/security-tools as a module: the pins and the place of each program are written there and nowhere else."""
    sys.dont_write_bytecode = True          # (no __pycache__ beside the scripts)
    loader = importlib.machinery.SourceFileLoader("security_tools", str(Path(__file__).resolve().parent / "security-tools"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ImportError("scripts/security-tools cannot be loaded")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


TOOLS = load_tools()


def tool(name: str) -> str:
    """The pinned program of the tool in the cache; Failed, with the way to get it, when it is not there."""
    path: Path = TOOLS.tool_path(name)
    if not path.is_file():
        raise Failed(f"{name} {TOOLS.TOOLS[name].version} is not in the cache ({path.parent.parent}): scripts/security-tools fetches it")
    return str(path)


def php() -> str:
    found = shutil.which("php")
    if found is None:
        raise Failed("php is not installed: the checks of server/ need the php command and its XML extensions (Debian and Ubuntu: apt install php-cli php-xml)")
    return found


def plain_environment() -> dict[str, str]:
    """The environment every program is run in: without colours, without the variables that hand a tool its settings (a switched-off rule belongs in the baseline, where it has a reason), and with
    git told to print plainly and to show every commit as it is stored, whatever the developer's own settings say: a push sends the commit itself, not what `git replace` shows in its place."""
    kept = {key: value for key, value in os.environ.items() if key not in SETTINGS_OF_THE_SHELL}
    count = kept.get("GIT_CONFIG_COUNT", "")
    first = int(count) if count.isdigit() else 0                                # (settings the shell hands git this way stay, ours come after them and so decide)
    told = {f"GIT_CONFIG_{part}_{first + at}": word for at, setting in enumerate(GIT_SETTINGS) for part, word in zip(("KEY", "VALUE"), setting, strict=True)}
    return kept | told | {"GIT_CONFIG_COUNT": str(first + len(GIT_SETTINGS)), "GIT_NO_REPLACE_OBJECTS": "1", "NO_COLOR": "1"}


def run(command: list[str], feed: str | None = None) -> subprocess.CompletedProcess[str]:
    """The program run in the root of the tree (given `feed` to read, if any), its output kept; Failed when it cannot be started or does not end."""
    try:
        return subprocess.run(command, cwd=ROOT, check=False, text=True, errors="replace", capture_output=True, timeout=TIMEOUT_SEC, env=plain_environment(), input=feed)
    except subprocess.TimeoutExpired:
        raise Failed(f"{Path(command[0]).name} did not end within {TIMEOUT_SEC:.0f} s") from None
    except OSError as error:
        raise Failed(f"{Path(command[0]).name} could not be started: {error}") from None


def said(done: subprocess.CompletedProcess[str]) -> str:
    """Everything the program printed, or that it printed nothing and how it ended."""
    return "\n".join(part.strip() for part in (done.stderr, done.stdout) if part.strip()) or f"{Path(str(done.args[0])).name} ended with {done.returncode} and said nothing"


def json_of(text: str) -> Any:
    """What the program wrote as JSON: all of its output, else its last line that opens a list or an object (a tool may print a remark before it); None when there is none."""
    lines = [line for line in text.splitlines() if line[:1] in ("[", "{")]
    for candidate in (text, *lines[-1:]):
        try:
            return json.loads(candidate)
        except ValueError:
            continue
    return None


def read_toml(name: str) -> dict[str, Any]:
    try:
        return tomllib.loads((ROOT / name).read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise Failed(f"{name} cannot be read: {error}") from None


def listed(*args: str) -> list[str]:
    """What `git ls-files` lists with these arguments, as paths from the root; with none, everything git tracks: the index, so also a file that was added and is not committed yet."""
    done = run(["git", "ls-files", "-z", *args])
    if done.returncode != 0:
        raise Failed(f"git could not list the files of the tree: {said(done)}")
    return [name for name in done.stdout.split("\0") if name]


def tracked(*folders: str) -> list[str]:
    """The files git tracks under the folders that are there to be read."""
    return [name for name in listed("--", *folders) if (ROOT / name).is_file()]


def holds_tokens(name: str) -> bool:
    """Whether the path is a file of access tokens or lies in a folder of them: any part of it begins with `.secrets`, as the two lines of .gitignore have it."""
    return any(part.startswith(NEVER_TRACKED) for part in Path(name).parts)


def changed() -> list[tuple[str, str]]:
    """The tracked files that are not as the last commit has them, each with git's two letters for it (what is staged, and what the file is beside that): what the next commit could take. A file git does
    not track is not listed, whatever it holds: it becomes this list's business when it is added."""
    done = run(["git", "status", "--porcelain", "-z", "--untracked-files=no"])
    if done.returncode != 0:
        raise Failed(f"git could not say what has changed in the tree: {said(done)}")
    states: list[tuple[str, str]] = []
    fields = iter(done.stdout.split("\0"))
    for field in fields:
        if "R" in field[:2] or "C" in field[:2]:
            next(fields, None)              # (a renamed or copied file is followed by the name it came from)
        if field[3:] and not holds_tokens(field[3:]):                           # (a file of access tokens is not shown to a program: the check secret-files speaks of it)
            states.append((field[:2], field[3:]))
    return states


def has_commits() -> bool:
    return run(["git", "rev-parse", "--quiet", "--verify", "HEAD^{commit}"]).returncode == 0


def git(*args: str, feed: bytes | None = None) -> bytes:
    """What that git command prints, as bytes (a file's content and a commit's text need not be UTF-8); Failed when git does not end well."""
    try:
        done = subprocess.run(["git", *GIT_PLAIN, *args], cwd=ROOT, check=False, capture_output=True, timeout=TIMEOUT_SEC, input=feed, env=plain_environment())
    except subprocess.TimeoutExpired:
        raise Failed(f"git {args[0]} did not end within {TIMEOUT_SEC:.0f} s") from None
    except OSError as error:
        raise Failed(f"git could not be started: {error}") from None
    if done.returncode != 0:
        raise Failed(f"git {args[0]} failed: {done.stderr.decode(errors='replace').strip()}")
    return done.stdout


# ---- the baseline: what a tool is known to find today

def read_baseline() -> dict[str, Entries]:
    if not BASELINE.exists():
        return {}
    try:
        loaded: dict[str, Entries] = json.loads(BASELINE.read_text(encoding="utf-8"))
    except ValueError as error:
        raise Failed(f"{BASELINE.relative_to(ROOT)} cannot be read: {error}") from None
    return loaded


def known(entries: Entries, key: str) -> int:
    return int(entries.get(key, {}).get("count", 0))


def over_baseline(findings: list[Finding], entries: Entries) -> list[str]:
    """What the baseline does not cover: a kind of finding it does not have, or more of one than it counts; each with the places it is found at."""
    lines: list[str] = []
    for key, count in sorted(Counter(finding.key for finding in findings).items()):
        if count > known(entries, key):
            lines.append(f"new: {key}" if known(entries, key) == 0 else f"more: {key}: {count} now, the baseline has {known(entries, key)}")
            lines += [f"    {finding.place}: {finding.text}" for finding in findings if finding.key == key]
    return lines


def against_baseline(name: str, findings: list[Finding]) -> str:
    """Failed for a finding over the baseline and for an entry without its reason; else a note when the baseline holds more than is found."""
    entries = read_baseline().get(name, {})
    lines = over_baseline(findings, entries)
    if lines:
        lines.append(f"fix it, or accept it with its reason: scripts/security-check --update --allow-growth, then the reason in {BASELINE.relative_to(ROOT)} ({GUIDE})")
    bare = [key for key, entry in sorted(entries.items()) if not str(entry.get("reason", "")).strip()]
    lines += [f"no reason: the baseline entry '{key}' needs one ({BASELINE.relative_to(ROOT)})" for key in bare]
    if lines:
        raise Failed("\n".join(lines))
    counts = Counter(finding.key for finding in findings)
    slack = any(counts[key] < known(entries, key) for key in entries)
    return "the baseline can be tightened: scripts/security-check --update" if slack else ""


def rebased(findings: list[Finding], entries: Entries) -> Entries:
    """The entries of today's findings: the count as found, the reason as it was written (empty for a new one, which the check then asks for)."""
    counts = Counter(finding.key for finding in findings)
    return {key: {"count": count, "reason": str(entries.get(key, {}).get("reason", ""))} for key, count in sorted(counts.items())}


# ---- the checks: each returns a note for its line (mostly none) and raises Failed

def check_secret_files() -> str:
    """Looks at names only, in the index and among the new files git does not ignore: no such file is opened."""
    held = [f"{name} is tracked by git" for name in listed() if holds_tokens(name)]
    loose = [f"{name} is not ignored by git: the next `git add` of its folder takes it" for name in listed("--others", "--exclude-standard") if holds_tokens(name)]
    if held or loose:
        advice = (f"a file or folder of that name holds access tokens and is never committed: a tracked one is taken out (git rm --cached FILE), and .gitignore names `{NEVER_TRACKED}` and `{NEVER_TRACKED}*`; "
                  f"if a commit has the file already, every token in it is revoked where it is used, first ({GUIDE})")
        raise Failed("\n".join([*held, *loose, advice]))
    return ""


# ---- tokens: the access token of the secrets manager, looked for by this script itself

def spelled(*units: tuple[bytes, bytes]) -> bytes:
    """A pattern of bytes for a text given as its units (what a character may be, and how many of them), with a NUL allowed after every character: the text is then found as UTF-8 and as the UTF-16 that
    a Windows program writes."""
    return b"".join(rb"(?:" + unit + rb"\x00?)" + times for unit, times in units)


HEX, DASH, DOT, WORD = rb"[0-9a-fA-F]", (rb"-", b""), (rb"\.", b""), rb"[0-9A-Za-z]"
KEY = rb"(?:[0-9A-Za-z+/]|\\\x00?/)"        # a character of base64; its `/` also as JSON writes it (`\/`, which PHP's json_encode does unasked)
# The access token of the secrets manager (Bitwarden Secrets Manager): 0.<the token's id, a UUID>.<twenty or more letters and digits>:<a key in base64>. Looser than the real one (thirty, and a key of
# sixteen bytes) on purpose: nothing else in the tree has this form, and a made-up one in a test is put together from its parts.
TOKEN = re.compile(spelled((rb"0", b""), DOT, (HEX, b"{8}"), DASH, (HEX, b"{4}"), DASH, (HEX, b"{4}"), DASH, (HEX, b"{4}"), DASH, (HEX, b"{12}"), DOT, (WORD, b"{20,}"), (rb":", b""),
                           (KEY, b"{16,}"), (rb"=", b"{0,2}")))


def line_of(text: bytes, at: int) -> int:
    """The number of the line that the place `at` of the text is in."""
    return text.count(b"\n", 0, at) + 1


def hidden(text: str) -> str:
    """The text with anything of the token's form taken out: no line this script prints shows one, whichever check wrote the line."""
    return TOKEN.sub(b"(a token, not shown)", text.encode("utf-8", "replace")).decode("utf-8", "replace")


def path_of(header: bytes) -> str:
    """The file a `diff --git a/NAME b/NAME` line is about: the two halves are the same name, since renames are not followed."""
    rest = header.removeprefix(b"diff --git ")
    return rest[:(len(rest) - 1) // 2].decode("utf-8", "replace").strip('"').removeprefix("a/")


def place_at(block: bytes, end: int, commit: str, file: str) -> tuple[str, str]:
    """The commit and the file (none: the commit's own lines, its message among them) that the place `end` of the block stands in, given the two the block began in. A line `commit ...` or `diff --git ...`
    at the left margin is always git's own: the message is indented, and every line of a file's content has its sign before it."""
    start = block.rfind(b"\ncommit ", 0, end)
    if start >= 0:
        commit, file = block[start + 8:start + 18].decode("ascii", "replace"), ""
    diff = block.rfind(b"\ndiff --git ", max(start, 0), end)
    if diff >= 0:
        line_end = block.find(b"\n", diff + 1)
        file = path_of(block[diff + 1:line_end if line_end >= 0 else len(block)])
    return commit, file


def log_blocks(revisions: list[str]) -> Iterator[bytes]:
    """Everything git prints for these commits, in blocks of whole lines, each beginning with the line break before its first line: the commit as it is stored (its author, its message), then what it
    changes against each of its parents (a merge's resolution is a change like any other; said in full, since the short `-m` means what the developer's log.diffMerges says) and, for a commit
    without a parent, everything it holds (--root, whatever log.showRoot says); every file as text (a .pdf, a file .gitattributes calls binary), without the lines around a change."""
    command = ["git", *GIT_PLAIN, "log", "--format=raw", "-p", "--diff-merges=separate", "--root", "-U0", "--text", "--no-textconv", "--no-ext-diff", "--no-color", "--no-renames", "--src-prefix=a/",
               "--dst-prefix=b/", *revisions, "--"]
    deadline, rest = time.monotonic() + TIMEOUT_SEC, b"\n"
    with tempfile.TemporaryFile() as errors, subprocess.Popen(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=errors, env=plain_environment()) as process:
        assert process.stdout is not None
        while chunk := process.stdout.read(CHUNK):
            if time.monotonic() > deadline:
                process.kill()
                raise Failed(f"git log did not end within {TIMEOUT_SEC:.0f} s")
            rest += chunk
            cut = rest.rfind(b"\n")
            if cut > 0:
                yield rest[:cut]
                rest = rest[cut:]
        if process.wait() != 0:
            errors.seek(0)
            raise Failed(f"git log failed: {errors.read().decode(errors='replace').strip()}")
    yield rest


def on_a_removed_line(block: bytes, at: int) -> bool:
    """Whether the place `at` is on a line of a diff that takes something out (a `-` line; the `--- a/NAME` line of a file's header is not one)."""
    line = block[block.rfind(b"\n", 0, at) + 1:]
    return line.startswith(b"-") and not line.startswith((b"--- a/", b"--- /dev/null"))


def tokens_in_commits(revisions: list[str], removed: bool) -> list[str]:
    """The commits among these that carry a token, each with the file it is in or `its message`. A line that takes a token out is read only when `removed` (every commit there is is read then, the one that had
    the token among them): a token on a removed line was in a parent, and a parent that has not been pushed is read itself."""
    found: dict[str, None] = {}
    commit, file = "", ""
    for block in log_blocks(revisions):
        for match in TOKEN.finditer(block):
            if not removed and on_a_removed_line(block, match.start()):
                continue
            at, name = place_at(block, match.start(), commit, file)
            found[f"commit {at}: {name or 'its message'}"] = None
        commit, file = place_at(block, len(block), commit, file)
    return list(found)


def objects(names: list[bytes]) -> list[bytes]:
    """The content of each of these objects of the repository, in their order."""
    if not names:
        return []
    out, at, contents = git("cat-file", "--batch", feed=b"\n".join(names) + b"\n"), 0, []
    for name in names:
        end = out.index(b"\n", at)
        header = out[at:end].split()
        if len(header) != 3:                # (`NAME missing`)
            raise Failed(f"git has no object {name.decode('ascii', 'replace')}")
        size = int(header[2])
        contents.append(out[end + 1:end + 1 + size])
        at = end + size + 2
    return contents


def tokens_in_tags() -> list[str]:
    """A tag with a message of its own is pushed with that message."""
    refs = [line.split(b" ", 2) for line in git("for-each-ref", "--format=%(objecttype) %(objectname) %(refname:short)", "refs/tags").splitlines()]
    tags = [(name, ref.decode("utf-8", "replace")) for kind, name, ref in refs if kind == b"tag"]
    return [f"the tag {ref}: its message" for (_, ref), text in zip(tags, objects([name for name, _ in tags]), strict=True) if TOKEN.search(text)]


def in_the_tree(path: bytes) -> bytes:
    """What the tracked path holds in the folder now: the file's bytes, a link's target (the link is not followed: where it leads is not the tree's), nothing when it is gone."""
    file = ROOT / os.fsdecode(path)
    try:
        if file.is_symlink():
            return os.fsencode(os.readlink(file))
        return file.read_bytes() if file.is_file() else b""
    except OSError as error:
        raise Failed(f"{path.decode('utf-8', 'replace')} cannot be read: {error}") from None


def tokens_staged_and_in_files() -> tuple[list[str], int]:
    """The tracked files that carry a token, as the index has them (what the next commit takes, also when the file itself was changed back since) and as they lie in the folder; and how many files that are."""
    records = [record.partition(b"\t") for record in git("ls-files", "--stage", "-z").split(b"\0") if record]
    entries = [(meta.split()[1], path) for meta, _, path in records if not meta.startswith(b"160000")]          # (a submodule's content is not in this repository)
    lines = [f"the index: {path.decode('utf-8', 'replace')} (as it is staged for the next commit)"
             for (_, path), content in zip(entries, objects([blob for blob, _ in entries]), strict=True) if TOKEN.search(content) or TOKEN.search(path)]
    files = list(dict.fromkeys(path for _, path in entries))
    for path in files:
        content = in_the_tree(path)
        found = TOKEN.search(content)
        if found:
            lines.append(f"{path.decode('utf-8', 'replace')}:{line_of(content, found.start())}")
    return lines, len(files)


def check_tokens(all_history: bool = False) -> str:
    """Fails for anything of the token's form in what a push would send: the commits the remote does not have (all of them when asked), the tags' messages, the index and the tracked files. The
    commits are those of this branch and of every other local branch and tag: `git push` takes whichever it is told, not only the one the gate was run on."""
    here = ["HEAD"] if has_commits() else []
    revisions = [*here, "--all"] if all_history else [*here, "--branches", "--tags", "--not", f"--remotes={REMOTE}"]
    commits = int(git("rev-list", "--count", *revisions, "--"))
    lines = [*(tokens_in_commits(revisions, all_history) if commits else []), *tokens_in_tags()]
    in_files, files = tokens_staged_and_in_files()
    if lines or in_files:
        advice = (f"each line is a place where something of the form of the secrets manager's access token stands; it is not shown. Revoke the token in the secrets manager first: a commit that has it "
                  f"keeps it, whatever the file says now. Then take it out of the file, stage the file again, and make a commit that is not pushed yet anew ({GUIDE})")
        raise Failed("\n".join([*lines, *in_files, advice]))
    which = "every commit of every branch and tag" if all_history else f"the commits of the local branches and tags that {REMOTE} does not have yet"
    return f"read: {which} ({commits}), the tags' messages, the index and the {files} tracked files"


# ---- gitleaks: every other kind of secret

def gitleaks(mode: str, *args: str, feed: str | None = None) -> list[dict[str, Any]]:
    """gitleaks in that mode with .gitleaks.toml as its only rules and allowlist, nothing it finds shown: its report, empty when it found nothing; Failed when it broke."""
    done = run([tool("gitleaks"), mode, "--no-banner", "--no-color", "--redact", "--ignore-gitleaks-allow", "--log-level=warn", "--exit-code=1", "--config=.gitleaks.toml",
                "--report-format=json", "--report-path=-", *args], feed)
    if done.returncode == 0:
        return []
    leaks = json_of(done.stdout)
    if done.returncode != 1 or not isinstance(leaks, list) or not leaks:
        raise Failed(said(done))
    return [leak for leak in leaks if isinstance(leak, dict)]


def made_up_token() -> str:
    """A value of the form of the secrets manager's access token (0.<id>.<thirty letters and digits>:<a key in base64>) that opens nothing; put together here, so that it stands whole in no file."""
    return f"0.{uuid.UUID(int=1)}.{'a1' * 15}:{base64.b64encode(bytes(16)).decode()}"


def token_rule_finds() -> None:
    """Failed unless gitleaks, with our rules and allowlist, finds a made-up token of the secrets manager: a rule that was lost or an allowlist entry that is too wide would let a real one through in silence.
    (The check `tokens` does not lean on this rule; it is gitleaks' second look at the same thing.)"""
    if not any(leak.get("RuleID") == OUR_RULE for leak in gitleaks("stdin", feed=made_up_token() + "\n")):
        raise Failed(f"the rule {OUR_RULE} of .gitleaks.toml does not find a token of that form any more (a made-up one was shown to it): a real one would pass ({GUIDE})")


def lay_messages(folder: Path) -> int:
    """Writes the message of every commit of the branch into the folder, each as a file named by its commit, and says how many: gitleaks reads what a commit changes and not what it says, and a message
    is pushed like the content."""
    if not has_commits():
        return 0
    folder.mkdir()
    laid = 0
    for record in git("log", "--format=%H%n%B%x00", "HEAD", "--").split(b"\0"):
        commit, _, message = record.strip(b"\n").partition(b"\n")
        if commit:
            (folder / commit.decode("ascii")).write_bytes(message + b"\n")
            laid += 1
    return laid


def lay_changed(scratch: Path) -> int:
    """Lays what the next commit could take into the folder and says how many files that are: a link to each changed tracked file as it lies in the tree, and a copy of what is staged of it where that
    is not what the file holds now (a change that was added and then taken out of the file again is still what `git commit` takes)."""
    laid = 0
    for state, name in changed():
        file = ROOT / name
        if file.is_file() and not file.is_symlink():
            link = scratch / CHANGED / name
            link.parent.mkdir(parents=True, exist_ok=True)
            link.symlink_to(file)
            laid += 1
        if state[0] in "AMRC" and state[1] not in " AU":                      # (staged, and the file is something else by now; not a file of a merge that is not resolved, which has nothing staged)
            copy = scratch / STAGED / name
            copy.parent.mkdir(parents=True, exist_ok=True)
            copy.write_bytes(git("cat-file", "blob", f":0:{name}"))
            laid += 1
    return laid


def laid_place(leak: dict[str, Any], scratch: Path) -> str:
    """A finding in the folder of `leaks_beside_the_diffs`, said as what it is in the tree (gitleaks names a link under SymlinkFile and the file it led to under File)."""
    laid = Path(str(leak.get("SymlinkFile") or leak.get("File")))
    try:
        kind, *parts = laid.relative_to(scratch).parts
    except ValueError:
        kind, parts = "", [laid.name]
    name = "/".join(parts)
    if kind == MESSAGES:
        return f"the message of commit {name[:10]}: {leak.get('RuleID')}"
    return f"{name}:{leak.get('StartLine')}: {leak.get('RuleID')}, {'as it is staged for the next commit' if kind == STAGED else 'not committed yet'}"


def leaks_beside_the_diffs() -> list[str]:
    """What gitleaks finds where its reading of the commits does not look: in their messages, and in what is not committed yet (the gate runs before the commit). All of it is shown to it in a folder of
    its own, so that it reads this and nothing else of the tree."""
    with tempfile.TemporaryDirectory(prefix="neoaprs-security-check-") as made:
        scratch = Path(made).resolve()
        if lay_messages(scratch / MESSAGES) + lay_changed(scratch) == 0:
            return []
        return sorted({laid_place(leak, scratch) for leak in gitleaks("dir", "--follow-symlinks", str(scratch))})


def check_gitleaks() -> str:
    if (ROOT / ".gitleaksignore").exists():
        raise Failed(".gitleaksignore is not used here: a value that is no secret gets an entry in .gitleaks.toml with its reason")
    config = read_toml(".gitleaks.toml")
    entries = [*config.get("allowlists", []), *([config["allowlist"]] if "allowlist" in config else [])]
    if any(not str(entry.get("description", "")).strip() for entry in entries):
        raise Failed("an allowlist entry of .gitleaks.toml has no description: the reason why the value is no secret")
    token_rule_finds()
    committed = gitleaks("git", "--log-opts=--diff-merges=first-parent HEAD", ".")                # (a merge is read as what it changes on the branch it was made on: its resolution too)
    lines = sorted({f"{leak.get('File')}:{leak.get('StartLine')}: {leak.get('RuleID')}, in commit {str(leak.get('Commit'))[:10]} of {str(leak.get('Date'))[:10]}" for leak in committed})
    lines += leaks_beside_the_diffs()
    if lines:
        advice = (f"a real secret that a commit has is revoked where it is used, first; one that is not committed yet is taken out of its file and staged again; a private file that was added by mistake "
                  f"is taken out of what git tracks (git rm --cached FILE) and named in .gitignore, never in the allowlist; a made-up value gets an entry in .gitleaks.toml with its reason ({GUIDE})")
        raise Failed("\n".join([*lines, advice]))
    return ""


def check_php_lint() -> str:
    command = php()
    wrong = []
    for name in tracked("server"):
        if name.endswith(".php"):
            done = run([command, "-l", name])
            if done.returncode != 0:
                wrong.append(said(done))
    if wrong:
        raise Failed("\n".join(wrong))
    return ""


def tainted_line(issue: dict[str, Any]) -> str:
    """One of Psalm's reports as lines: where and what, then the way the value took."""
    steps = [step for step in issue.get("taint_trace") or [] if isinstance(step, dict)]
    way = [f"    {step.get('file_name')}:{step.get('line_from')}: {step.get('label')}" for step in steps]
    return "\n".join([f"{issue.get('file_name')}:{issue.get('line_from')}: {issue.get('type')}: {issue.get('message')}", *way])


def psalm_in_a_container(command: str, phar: str, lacking: str) -> subprocess.CompletedProcess[str]:
    """Psalm run by the official php image of this php's minor version, which has the extensions: the image pinned by its digest and never fetched here, server/ and the archive mounted read-only, no
    network. Failed, with the plain sentence, when docker cannot be used or the image is not pinned or not on this machine."""
    docker = shutil.which("docker")
    asked = run([docker, "info", "--format", "{{.ServerVersion}}"]) if docker else None
    if asked is None or asked.returncode != 0:
        why = "docker is not installed" if asked is None else f"docker cannot be used: {said(asked).splitlines()[-1]}"
        raise Failed(f"{lacking}, and {why}: install the extensions (Debian and Ubuntu: apt install php-xml), or let this user run docker, where Psalm runs in a php image")
    minor = run([command, "-r", "echo PHP_MAJOR_VERSION, '.', PHP_MINOR_VERSION;"]).stdout.strip()
    image = TOOLS.PHP_IMAGES.get(minor)
    if not image:
        raise Failed(f"{lacking}, and no php image is pinned for PHP {minor or '?'} (PHP_IMAGES in scripts/security-tools): install the extensions (Debian and Ubuntu: apt install php-xml), or pin the image")
    assert docker is not None
    done = run([docker, "run", "--rm", "--pull=never", "--network=none", "--volume", f"{ROOT / 'server'}:{PSALM_FOLDER}/server:ro", "--volume", f"{phar}:/psalm.phar:ro", "--workdir", PSALM_FOLDER,
                image, "php", "/psalm.phar", *PSALM_ARGS])
    if done.returncode == DOCKER_FAILED:
        raise Failed(f"{said(done)}\ndocker could not run the php image; when it is not on this machine yet: docker pull {image}")
    return done


def check_psalm() -> str:
    command, phar = php(), tool("psalm")
    loaded = {line.strip().lower() for line in run([command, "-m"]).stdout.splitlines()}
    lacking = [extension for extension in PSALM_EXTENSIONS if extension not in loaded]
    if lacking:
        done = psalm_in_a_container(command, phar, f"this php has no {' and no '.join(lacking)} extension, which Psalm needs")
    else:
        done = run([command, phar, *PSALM_ARGS])
    issues = json_of(done.stdout)
    if done.returncode not in (0, 2) or not isinstance(issues, list):         # (2 is "issues found"; anything else is Psalm itself failing)
        raise Failed(said(done))
    tainted = [issue for issue in issues if isinstance(issue, dict) and (issue.get("is_security") or str(issue.get("type", "")).startswith("Tainted"))]
    if tainted:
        advice = f"clean the value before it is used, or tell Psalm where it is cleaned (@psalm-taint-escape with the reason beside it; {GUIDE})"
        raise Failed("\n".join([*map(tainted_line, tainted), advice]))
    return ""


def is_shell(path: Path) -> bool:
    with path.open("rb") as handle:
        return SHEBANG.match(handle.readline(200)) is not None


def settings_files(name: str) -> list[Finding]:
    """A tracked settings file of the tool is a finding of its own. The check does not read it (so it cannot switch a finding off here), but whoever runs the tool by hand gets its word, and what it
    switches off has no count and no reason: that belongs in the baseline, which may also name the file itself, with the reason it is there."""
    return [Finding(f"{file} settings of {name}", file, f"a settings file of {name}: what is switched off is said in the baseline, with its reason") for file in listed() if Path(file).name in SETTINGS_FILES[name]]


def disabled_without_reason(file: str) -> list[Finding]:
    """The `# shellcheck disable=...` comments of the script that do not say why: the reason follows on the same line, after a `#` of its own."""
    text = (ROOT / file).read_bytes()
    bare = [found for found in DISABLE.finditer(text) if not re.search(rb"\w", found.group("reason") or b"")]
    return [Finding(f"{file} disable={found.group('rules').decode('ascii', 'replace')} without its reason", f"{file}:{line_of(text, found.start())}",
                    "a rule of shellcheck is switched off and the line does not say why (# shellcheck disable=SC0000   # the reason)") for found in bare]


def find_shellcheck() -> list[Finding]:
    program = tool("shellcheck")
    files = [name for name in tracked(*SHELL_FOLDERS) if is_shell(ROOT / name)]
    findings = settings_files("shellcheck") + [finding for file in files for finding in disabled_without_reason(file)]
    if not files:
        return findings
    done = run([program, "--norc", "--severity=warning", "--format=json1", *files])
    report = json_of(done.stdout)
    if done.returncode not in (0, 1) or not isinstance(report, dict) or not isinstance(report.get("comments"), list):
        raise Failed(said(done))
    return findings + [Finding(f"{c.get('file')} SC{c.get('code')}", f"{c.get('file')}:{c.get('line')}", f"SC{c.get('code')} ({c.get('level')}): {c.get('message')}") for c in report["comments"]]


def zizmor_finding(record: dict[str, Any]) -> Finding:
    """A finding of zizmor's JSON: the workflow, the rule and the text it points at (the action, the step) are the key; the line is only where to look."""
    places = [place for place in record.get("locations") or [] if isinstance(place, dict)] or [{}]
    main = next((place for place in places if place.get("symbolic", {}).get("kind") == "Primary"), places[0])
    symbolic, concrete = main.get("symbolic", {}), main.get("concrete", {})
    path = str(symbolic.get("key", {}).get("Local", {}).get("verbatim_path", "?"))
    about = " ".join(str(concrete.get("feature", "")).strip().splitlines()[:1]).strip()[:120]
    row = concrete.get("location", {}).get("start_point", {}).get("row")
    line = row + 1 if isinstance(row, int) else "?"
    severity = str(record.get("determinations", {}).get("severity", "")).lower()
    return Finding(f"{path} {record.get('ident')} {about}".strip(), f"{path}:{line}", f"{record.get('ident')} ({severity}): {record.get('desc')}: {symbolic.get('annotation')}")


def find_zizmor() -> list[Finding]:
    program = tool("zizmor")
    findings = settings_files("zizmor")
    if not (ROOT / ".github" / "workflows").is_dir():
        return findings
    done = run([program, "--offline", "--no-progress", "--no-config", "--no-ignores", "--color=never", f"--min-severity={ZIZMOR_SEVERITY}", "--format=json", ".github/workflows"])
    records = json_of(done.stdout)
    if (done.returncode != 0 and done.returncode not in ZIZMOR_FOUND) or not isinstance(records, list):
        raise Failed(said(done))
    return findings + [zizmor_finding(record) for record in records if isinstance(record, dict)]


def check_audit() -> str:
    program = tool("osv-scanner")
    config = read_toml("osv-scanner.toml")
    for table in ("IgnoredVulns", "PackageOverrides"):
        for entry in config.get(table, []):
            if not str(entry.get("reason", "")).strip() or "effectiveUntil" not in entry:
                raise Failed(f"osv-scanner.toml: the entry {entry.get('id') or entry.get('name')} of {table} needs its reason and the day it ends (effectiveUntil)")
    done = run([program, "scan", "source", "--no-resolve", "--config=osv-scanner.toml", *[f"--lockfile={name}" for name in LOCK_FILES]])
    if done.returncode != 0:
        advice = f"move the package to a version that has the fix; an advisory that cannot reach NeoAPRS is set aside in osv-scanner.toml with its reason and an end date ({GUIDE})"
        raise Failed("\n".join([said(done), advice]))
    return said(done)


BASELINED: dict[str, Callable[[], list[Finding]]] = {"shellcheck": find_shellcheck, "zizmor": find_zizmor}
CHECKS: dict[str, Callable[[], str]] = {
    "secret-files": check_secret_files,
    "tokens": check_tokens,
    "gitleaks": check_gitleaks,
    "php-lint": check_php_lint,
    "psalm": check_psalm,
    "shellcheck": lambda: against_baseline("shellcheck", find_shellcheck()),
    "zizmor": lambda: against_baseline("zizmor", find_zizmor()),
}
AUDIT = "audit"


# ---- the runner

def run_check(name: str, check: Callable[[], str]) -> bool:
    """Runs the check and prints its line, with what it found under a failing one (and a note under a passing one that has one); True when it passed."""
    start = time.monotonic()
    try:
        note, passed = check(), True
    except Failed as failure:
        note, passed = str(failure), False
    print(f"{'ok   ' if passed else 'FAIL '} {name:<12} {time.monotonic() - start:6.1f}s", flush=True)
    if note:
        print(textwrap.indent(hidden(note), "      | ", lambda line: True), flush=True)
    return passed


def update(allow_growth: bool) -> int:
    """Writes the baseline from today's findings. Entries that are gone leave it and counts go down; a new entry or a higher count is refused unless growth is allowed, and then waits for its reason."""
    try:
        baseline = read_baseline()
        found = {name: find() for name, find in BASELINED.items()}
    except Failed as failure:
        print(f"security-check: the baseline was not written: {failure}", file=sys.stderr)
        return 1
    grown = [line for name, findings in found.items() for line in over_baseline(findings, baseline.get(name, {}))]
    if grown and not allow_growth:
        print("\n".join([*grown, "the baseline is not made larger; fix the findings (or pass --allow-growth and write the reason of each new entry)"]))
        return 1
    fresh = {name: rebased(findings, baseline.get(name, {})) for name, findings in found.items()}
    BASELINE.write_text(json.dumps(fresh, indent=1) + "\n", encoding="utf-8")
    waiting = [f"{name}: {key}" for name, entries in fresh.items() for key, entry in entries.items() if not entry["reason"].strip()]
    sizes = [f"{name} {sum(entry['count'] for entry in entries.values())} finding(s) in {len(entries)} entries" for name, entries in fresh.items()]
    print(f"baseline written: {', '.join(sizes)}")
    if waiting:
        print("\n".join(["these entries wait for their reason, and the check fails until each has one:", *[f"    {line}" for line in waiting]]))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--all-history", action="store_true", help=f"the check `tokens` reads every commit of every branch and tag, not only the ones {REMOTE} does not have yet")
    parser.add_argument("--audit", action="store_true", help="the advisory check alone (asks osv.dev)")
    parser.add_argument("--only", action="append", choices=list(CHECKS), metavar="NAME", help=f"one of the checks: {', '.join(CHECKS)}")
    parser.add_argument("--update", action="store_true", help="write the baseline of shellcheck and zizmor from today's findings")
    parser.add_argument("--allow-growth", action="store_true", help="with --update: let the baseline take new findings, which then wait for their reason")
    args = parser.parse_args()
    if args.allow_growth and not args.update or sum([args.audit, args.update, bool(args.only)]) > 1 or args.all_history and (args.audit or args.update):
        parser.error("--audit, --only and --update exclude each other, --allow-growth goes with --update, and --all-history with neither --audit nor --update")
    if args.update:
        return update(args.allow_growth)
    checks = CHECKS | {"tokens": lambda: check_tokens(args.all_history)}
    chosen = {AUDIT: check_audit} if args.audit else {name: checks[name] for name in args.only or checks}
    passed = [run_check(name, check) for name, check in chosen.items()]
    return 0 if all(passed) else 1


if __name__ == "__main__":
    sys.exit(main())

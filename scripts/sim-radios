#!/usr/bin/env python3
"""Run a station of six made-up radios (2 FM, 3 HF, 1 LoRa Dummy) on the real program.

Every radio must come up, hear its own made-up world and send what it is asked (Beacon now by
its own rules; a message to each FM and LoRa home station, acked from there). One line per radio.

  scripts/sim-radios                 the station, the checks, a line per radio, then a clean stop
  scripts/sim-radios --keep          the same, and the daemon stays up until Ctrl+C
  scripts/sim-radios --data FOLDER   the data folder (default: a new one under work/sim-radios/)
  scripts/sim-radios --command PROGRAM  the neoaprs to run (default: this Python with -m neoaprs)
  scripts/sim-radios --timeout SEC   how long each wait may take (default 180)

NEOAPRS_NO_DEVICES=1: no device, no Mercury, nothing on the air. Exit code 0 when every radio did
what it should, 1 at the first that did not, 2 for a wrong argument."""
import argparse
import asyncio
import contextlib
import importlib.machinery
import importlib.util
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path
from collections.abc import Callable, Iterator
from types import ModuleType
from typing import Any

ROOT = Path(__file__).resolve().parent.parent


def load_smoke() -> ModuleType:
    """Load scripts/smoke.py: the page's socket, the daemon stop and the end checks."""
    spec = importlib.util.spec_from_file_location("smoke", Path(__file__).resolve().with_name("smoke.py"))
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules["smoke"] = module
    spec.loader.exec_module(module)
    return module


smoke = load_smoke()


def operators_folder(data: Path) -> str:
    """Return why `data` is the operator's own data folder, or "", by scripts/demo-daemon's rule."""
    loader = importlib.machinery.SourceFileLoader("demo_daemon", str(Path(__file__).resolve().with_name("demo-daemon")))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    assert spec is not None
    demo = importlib.util.module_from_spec(spec)
    loader.exec_module(demo)
    return str(demo.operators_folder(data, demo.own_data_folder()))

STATION = {"station/call": "OH2TST", "station/lat": "60.17", "station/lon": "24.94", "beacon/interval_min": "20", "messages/alert": "false"}
# The radios in the order of their boxes.
SIX = (("fm", "dummy"), ("hf", "dummy-hf"), ("fm", "dummy"), ("hf", "dummy-hf"), ("hf", "dummy-hf"), ("lora", "dummy-lora"))
# Ends of the calls of the home station of a Dummy FM world and of the LoRa world, which answer.
HOME = {"fm": "ABC", "lora": "KOT"}
# Stations a radio must have heard before its world counts as heard: FM 12, HF cities 6, LoRa 4.
ENOUGH = {"fm": 8, "hf": 6, "lora": 4}


def say(text: str) -> None:
    print(f"sim-radios: {text}", flush=True)


def start_daemon(program: list[str], data: Path) -> "subprocess.Popen[bytes]":
    """Start the daemon on `data`, its page on a free loopback port, with no devices."""
    data.mkdir(parents=True, exist_ok=True)
    out = (data.parent / f"{data.name}.out").open("wb")
    env = {k: v for k, v in os.environ.items() if k not in ("NEOAPRS_DATA_DIR", "NEOAPRS_DEBUG")}
    env.update({"NEOAPRS_NO_DEVICES": "1", "NEOAPRS_UPDATE_CHECK": "0", "NEOAPRS_SERIAL_PATTERN": "/dev/neoaprs-sim-no-such-port*"})
    flags = subprocess.CREATE_NEW_PROCESS_GROUP if smoke.WINDOWS else 0          # type: ignore[attr-defined, unused-ignore]
    # Its own group or session: the terminal's Ctrl+C reaches only this script, which stops the
    # daemon with one signal; a second signal while it closes would end it at once.
    return subprocess.Popen([*program, "--data", str(data), "--web-port", "0"], stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, env=env, creationflags=flags,
                            start_new_session=not smoke.WINDOWS)


def rows(page: Any) -> dict[str, dict[str, Any]]:
    return page.topics.get(smoke.RADIOS) or {}


async def answer(page: Any, since: int, what: str, done: Any, seconds: float) -> None:
    """Wait for `done(page)` or a refusal of the command sent at `since` (a Failure)."""
    await page.until(what, lambda p: p.refusal(since, "radio_add", "radio_change", "beacon_now", "send_message") is not None or done(p), seconds)
    if refused := page.refusal(since, "radio_add", "radio_change", "beacon_now", "send_message"):
        raise smoke.Failure(f"{what}: refused: {refused.get('text')}")


async def make_six(page: Any, seconds: float) -> list[int]:
    """Make the six radios (reuse live ones, add the rest, switch extras off); return their ids."""
    await page.until("the radios told", lambda p: smoke.RADIOS in p.topics and "config" in p.topics, seconds)
    await page.set_config(STATION, seconds)
    free = {kind: [int(row["id"]) for row in smoke.live_radios(page.topics, kind)] for kind in ("fm", "hf", "lora")}
    ids: list[int] = []
    for kind, type in SIX:
        if free[kind]:
            id = free[kind].pop(0)
            since = await page.send({"cmd": "radio_change", "radio": id, "type": type, "enabled": True})
        else:
            since = await page.send({"cmd": "radio_add", "type": type})
            await answer(page, since, f"a {type} radio added", lambda p, since=since: any(m.get("type") == "radio_added" for m in p.messages[since:]), seconds)
            id = int(next(m for m in page.messages[since:] if m.get("type") == "radio_added")["id"])
        await answer(page, since, f"radio {id} made {type}", lambda p, id=id, type=type: (rows(p).get(str(id)) or {}).get("type") == type and (rows(p).get(str(id)) or {}).get("enabled"), seconds)
        ids.append(id)
    for id in (i for left in free.values() for i in left):
        since = await page.send({"cmd": "radio_change", "radio": id, "enabled": False})
        await answer(page, since, f"radio {id} switched off", lambda p, id=id: not (rows(p).get(str(id)) or {}).get("enabled"), seconds)
    return ids


def heard_by(page: Any) -> dict[int, set[str]]:
    """Return the stations each radio heard, by radio id (from the topic `stations`)."""
    found: dict[int, set[str]] = {}
    for call, row in (page.topics.get("stations") or {}).items():
        for id, heard in (row.get("heard") or {}).items():
            if int((heard or {}).get("count") or 0) > 0:
                found.setdefault(int(id), set()).add(call)
    return found


def out_on(page: Any, id: int, kind: str) -> list[dict[str, Any]]:
    """Return our packets of a kind that went out on a radio, from the topic `packets`."""
    return [row for row in (page.topics.get("packets") or {}).values() if row.get("direction") == "out" and row.get("radio_id") == id and row.get("kind") == kind]


def check_worlds(page: Any, ids: list[int]) -> dict[int, set[str]]:
    heard = heard_by(page)
    kinds = {id: kind for id, (kind, _type) in zip(ids, SIX, strict=True)}
    for id in ids:
        others = set().union(*(heard.get(other, set()) for other in ids if other != id and (kinds[id] != "hf" or kinds[other] != "hf")))
        if shared := heard.get(id, set()) & others:
            raise smoke.Failure(f"radio {id} ({kinds[id]}) heard stations of another radio's world: {', '.join(sorted(shared))}")
    return heard


async def run(args: argparse.Namespace) -> None:
    program = smoke.command_line(args.command)
    done = subprocess.run([*program, "--version"], capture_output=True, text=True, timeout=60)
    if done.returncode != 0 or not done.stdout.startswith("NeoAPRS "):
        raise smoke.Failure(f"--version: exit code {done.returncode}, {done.stdout.strip() or done.stderr.strip()!r}")
    data = Path(args.data) if args.data else ROOT / "work" / "sim-radios" / time.strftime("%Y%m%d-%H%M%S")
    log = data / smoke.LOG
    before = log.stat().st_size if log.exists() else 0
    say(f"{done.stdout.strip()} on {data}")
    daemon = start_daemon(program, data)
    try:
        base = wait_for_page(daemon, log, before, args.timeout)
        page = await smoke.PageSocket.open(base)
        ids = await make_six(page, args.timeout)
        kinds = {id: kind for id, (kind, _type) in zip(ids, SIX, strict=True)}
        await page.until("every radio connected", lambda p: all((rows(p).get(str(id)) or {}).get("state") == "connected" for id in ids), args.timeout)
        await page.until("every radio's world heard", lambda p: all(len(heard_by(p).get(id, ())) >= ENOUGH[kinds[id]] for id in ids), args.timeout)
        heard = check_worlds(page, ids)
        since = await page.send({"cmd": "beacon_now"})
        await answer(page, since, "a beacon on every radio", lambda p: all(out_on(p, id, "position") for id in ids), args.timeout)
        homes = {id: next(call for call in sorted(heard[id]) if call.split("-")[0].endswith(HOME[kinds[id]])) for id in ids if kinds[id] in HOME}
        for call in homes.values():
            await page.send({"cmd": "send_message", "to": call, "text": f"six radios, to {call}"})
        await page.until("each home station's ack", lambda p: all(any(row.get("to_call") == call and row.get("state") == "acked" for row in (p.topics.get("messages") or {}).values()) for call in homes.values()), args.timeout)
        for id in ids:
            row, beacon = rows(page)[str(id)], out_on(page, id, "position")[-1]
            message = [m for m in out_on(page, id, "message") if id in homes and f":{homes[id]}" in m.get("tnc2", "").replace(" ", "")]
            if kinds[id] == "hf" and beacon.get("path"):
                raise smoke.Failure(f"radio {id}: the beacon went out by {beacon.get('path')} on HF, where nothing is repeated")
            if kinds[id] == "lora" and beacon.get("path") != ["WIDE1-1"]:
                raise smoke.Failure(f"radio {id}: the LoRa beacon went out by {beacon.get('path')}, not WIDE1-1")
            if id in homes and not message:
                raise smoke.Failure(f"radio {id}: the message to {homes[id]}, the station only it heard, did not go out on it")
            said = f", the message to {homes[id]} acked" if id in homes else ""
            say(f"radio {id} ({row.get('type')}, {kinds[id]} {row.get('number')}): {row.get('state')}, heard {len(heard[id])} stations, Beacon now by {','.join(beacon.get('path') or []) or 'no path'}{said}")
        others = [id for id in ids if any(m.get("radio_id") == id for m in (page.topics.get("packets") or {}).values() if m.get("direction") == "out" and m.get("kind") == "message") and id not in homes]
        if others:
            raise smoke.Failure(f"a message went out on radios no message was for: {others}")

        def end() -> None:
            page.close()
            smoke.check_the_end(data, smoke.stop_gracefully(daemon, args.timeout))

        if args.keep:
            say(f"the page of the six radios is at {base} (Ctrl+C stops the daemon)")
            await keep_then_stop(daemon, end)
        else:
            end()
    except smoke.Failure as error:
        print(f"sim-radios: FAILED: {error}\n--- the end of the log ---\n{smoke.log_tail(data)}", file=sys.stderr)
        raise
    finally:
        if daemon.poll() is None:
            daemon.kill()
            daemon.wait()


def wait_for_page(daemon: "subprocess.Popen[bytes]", log: Path, offset: int, seconds: float) -> str:
    """Return the page address from the lines the daemon added to its log."""
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if daemon.poll() is not None:
            raise smoke.Failure(f"the daemon ended with exit code {daemon.returncode} before the page was up")
        try:
            with log.open("rb") as file:
                file.seek(offset)
                found = re.search(r"web page at (http://127\.0\.0\.1:\d+/)", file.read().decode("utf-8", errors="replace"))
        except OSError:
            found = None
        if found:
            return found.group(1)
        time.sleep(0.1)
    raise smoke.Failure(f"no 'web page at' line in the log within {seconds:g} s")


@contextlib.contextmanager
def ctrl_c_only_stops(stop: asyncio.Event) -> Iterator[None]:
    """Make Ctrl+C only set `stop` inside the block (also on Windows, where asyncio.run cancels).

    The previous SIGINT handler is restored afterwards."""
    loop = asyncio.get_running_loop()
    previous = signal.getsignal(signal.SIGINT)
    if smoke.WINDOWS:
        signal.signal(signal.SIGINT, lambda *_: loop.call_soon_threadsafe(stop.set))
    else:
        loop.add_signal_handler(signal.SIGINT, stop.set)
    try:
        yield
    finally:
        if not smoke.WINDOWS:
            loop.remove_signal_handler(signal.SIGINT)
        signal.signal(signal.SIGINT, previous)


async def wait_for_interrupt(daemon: "subprocess.Popen[bytes]", stop: asyncio.Event) -> None:
    """Wait until Ctrl+C sets `stop`, or the daemon ends by itself (a Failure)."""
    while not stop.is_set():
        if daemon.poll() is not None:
            raise smoke.Failure(f"the daemon ended by itself with exit code {daemon.returncode}")
        try:
            await asyncio.wait_for(stop.wait(), 1.0)
        except TimeoutError:
            continue
    say("stopping the daemon")


async def keep_then_stop(daemon: "subprocess.Popen[bytes]", stop_daemon: Callable[[], None]) -> None:
    """With --keep: leave the daemon up until Ctrl+C, then stop it with the end checks.

    A second Ctrl+C during the stop is ignored, so the stop is not cut short."""
    stop = asyncio.Event()
    with ctrl_c_only_stops(stop):
        await wait_for_interrupt(daemon, stop)
        stop_daemon()


def main() -> int:
    parser = argparse.ArgumentParser(prog="sim-radios", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--keep", action="store_true", help="leave the daemon up for the page until Ctrl+C")
    parser.add_argument("--data", metavar="FOLDER", help="the data folder (default: a new one under work/sim-radios/)")
    parser.add_argument("--command", metavar="PATH", help="the neoaprs command (default: this Python with -m neoaprs)")
    parser.add_argument("--timeout", type=float, default=180.0, metavar="SEC", help="how long each wait may take; default %(default)s")
    args = parser.parse_args()
    why = operators_folder(Path(args.data)) if args.data else ""
    if why:
        print(f"sim-radios: refused: {why}; give a folder of its own (for example work/sim-radios/mine)", file=sys.stderr)
        return 2
    try:
        asyncio.run(run(args))
    except smoke.Failure:
        return 1
    say("ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())

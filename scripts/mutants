#!/usr/bin/env python3
"""Planted faults for the critical modules: mutmut on each module against its short list of tests
(scripts/mutants.toml), its score against its recorded floor. Not a stage of the gate.

    scripts/mutants kiss tncmode       the modules named (keys of the table, or their paths)
    scripts/mutants --group 2          the modules of one group, as the nightly workflow runs them
    scripts/mutants --all              every module of the table
    --check     exit 1 when a module's score is below its floor
    --record    write each score (rounded down to a tenth) into the table as its new floor
    --workers N mutmut's children (4); --show prints the change of every survivor

Needs `uv sync --frozen --group mutants` once. Each module runs in a copy of the tree's files under
build/mutants/<key>/, made afresh; its summary goes to build/mutants/scores.json. Linux and macOS
(mutmut forks).
"""

import argparse
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TABLE = ROOT / "scripts" / "mutants.toml"
WORK = ROOT / "build" / "mutants"
MUTMUT_ARGS = ["-p", "no:randomly", "-p", "no:cacheprovider"]
MODULE_TIMEOUT_SEC = 3 * 3600


def table() -> dict[str, dict]:
    return tomllib.loads(TABLE.read_text(encoding="utf-8"))["modules"]


def chosen(args: argparse.Namespace, modules: dict[str, dict]) -> list[str]:
    if args.all:
        return list(modules)
    if args.group is not None:
        keys = [key for key, row in modules.items() if row["group"] == args.group]
        if not keys:
            sys.exit(f"mutants: no module is in group {args.group}")
        return keys
    by_path = {row["path"]: key for key, row in modules.items()}
    keys = []
    for name in args.modules:
        key = name if name in modules else by_path.get(name)
        if key is None:
            sys.exit(f"mutants: {name} is not in {TABLE.relative_to(ROOT)} ({', '.join(modules)})")
        keys.append(key)
    if not keys:
        sys.exit("mutants: name a module, --group N or --all")
    return keys


def mutmut_program() -> Path:
    python = Path(os.environ.get("NEOAPRS_PYTHON") or ROOT / ".venv" / "bin" / "python")
    program = python.parent / "mutmut"
    if not program.exists():
        sys.exit("mutants: mutmut is not installed: run `uv sync --frozen --group mutants`")
    return program


def copy_tree(into: Path) -> None:
    """The tree's tracked and new files (what git would commit), without what it ignores."""
    listed = subprocess.run(
        ["git", "-C", str(ROOT), "ls-files", "-co", "--exclude-standard", "-z"], capture_output=True, check=True
    ).stdout.decode()
    if into.exists():
        shutil.rmtree(into)
    for rel in filter(None, listed.split("\0")):
        source = ROOT / rel
        if source.is_file() and not rel.startswith(("ui/", "site/", "server/")):
            target = into / rel
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)


def settings(row: dict) -> str:
    lines = [
        "[mutmut]",
        "source_paths = neoaprs",
        f"only_mutate = {row['path']}",
        "pytest_add_cli_args_test_selection =",
    ]
    lines += [f"    {test}" for test in row["tests"]]
    lines += ["pytest_add_cli_args ="] + [f"    {arg}" for arg in MUTMUT_ARGS]
    return "\n".join(lines) + "\n"


def run_module(key: str, row: dict, program: Path, workers: int, show: bool) -> dict:
    folder = WORK / key
    copy_tree(folder)
    (folder / "setup.cfg").write_text(settings(row), encoding="utf-8")
    env = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
    env.pop("PYTEST_ADDOPTS", None)
    start = time.monotonic()
    log = folder / "mutmut.log"
    with log.open("w") as out:
        ran = subprocess.run(
            [str(program), "run", "--max-children", str(workers)],
            cwd=folder,
            env=env,
            stdout=out,
            stderr=subprocess.STDOUT,
            timeout=MODULE_TIMEOUT_SEC,
        )
    seconds = time.monotonic() - start
    if ran.returncode != 0:
        return {
            "key": key,
            "error": f"mutmut ended with {ran.returncode}: see {log.relative_to(ROOT)}",
            "seconds": seconds,
        }
    subprocess.run([str(program), "export-cicd-stats"], cwd=folder, env=env, capture_output=True, check=True)
    stats = json.loads((folder / "mutants" / "mutmut-cicd-stats.json").read_text())
    results = subprocess.run([str(program), "results"], cwd=folder, env=env, capture_output=True, text=True)
    survivors = [
        line.split(":")[0].strip() for line in results.stdout.splitlines() if line.strip().endswith(": survived")
    ]
    counted = stats["total"] - stats["skipped"]
    caught = stats["killed"] + stats["timeout"]
    score = 100.0 * caught / counted if counted else 0.0
    if show:
        for name in survivors:
            shown = subprocess.run([str(program), "show", name], cwd=folder, env=env, capture_output=True, text=True)
            print(shown.stdout)
    return {
        "key": key,
        "path": row["path"],
        "score": round(score, 2),
        "caught": caught,
        "mutants": counted,
        "survived": stats["survived"],
        "no_tests": stats["no_tests"],
        "survivors": survivors,
        "floor": row["floor"],
        "seconds": round(seconds, 1),
    }


def record(scores: list[dict]) -> None:
    floors = {score["key"]: math.floor(score["score"] * 10) / 10 for score in scores if "score" in score}
    lines, section = TABLE.read_text(encoding="utf-8").split("\n"), None
    for i, line in enumerate(lines):
        if found := re.fullmatch(r"\[modules\.(\w+)\]", line):
            section = found.group(1)
        elif section in floors and line.startswith("floor = "):
            lines[i] = f"floor = {floors[section]:.1f}"
    TABLE.write_text("\n".join(lines), encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("modules", nargs="*")
    parser.add_argument("--group", type=int)
    parser.add_argument("--all", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--record", action="store_true")
    parser.add_argument("--show", action="store_true")
    parser.add_argument("--workers", type=int, default=4)
    args = parser.parse_args()
    modules = table()
    keys = chosen(args, modules)
    program = mutmut_program()
    WORK.mkdir(parents=True, exist_ok=True)
    scores, low = [], []
    for key in keys:
        score = run_module(key, modules[key], program, args.workers, args.show)
        scores.append(score)
        if "error" in score:
            print(f"{key:14} ERROR {score['error']}", flush=True)
            low.append(key)
            continue
        below = score["score"] < score["floor"]
        if below:
            low.append(key)
        print(
            f"{key:14} {score['score']:5.1f} %  {score['caught']}/{score['mutants']} caught, floor {score['floor']:.1f}"
            f"{'  BELOW THE FLOOR' if below else ''}  ({score['seconds']:.0f} s)",
            flush=True,
        )
        for name in score["survivors"]:
            print(f"    survived: {name}")
    (WORK / "scores.json").write_text(json.dumps(scores, indent=2) + "\n", encoding="utf-8")
    if args.record:
        record(scores)
        print(f"floors written to {TABLE.relative_to(ROOT)}")
    if args.check and low:
        print(f"mutants: below the floor or not run: {' '.join(low)}")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

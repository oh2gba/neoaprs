#!/usr/bin/env python3
"""Bench APRS over two real Mercury modems cross-wired through named pipes, with no radio (Linux).

scripts/mercury-bench                 run it: a table of the steps and times, exit 0 if all passed
scripts/mercury-bench --keep          keep the folders (daemon logs, Mercury output), say where"""

import argparse
import asyncio
import os
import random
import shutil
import struct
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from neoaprs.mercuryhelper import find  # noqa: E402  (the daemon package of this checkout)
from tests.support.realmercury import (  # noqa: E402
    RATE,
    SAMPLE_BYTES,
    Failure,
    Page,
    fifo,
    start_daemon,
    start_mercury,
    stop,
    wait_for_page,
    write_settings,
)

# (broadcast, control) of each Mercury: the control port is 200 above the KISS port.
A_PORTS, B_PORTS = (18100, 18300), (18110, 18310)
LONG_TEXT = "x" * 67


def say(text: str) -> None:
    print(f"bench: {text}", flush=True)


TICK_SEC = 0.01
TICK_BYTES = int(RATE * TICK_SEC) * SAMPLE_BYTES


# Noise amplitude under the signal, about -66 dBFS: on digital silence Mercury's busy detector
# has a zero noise floor and reads BUSY for a minute.
NOISE = 1 << 20


def noise(count: int) -> bytes:
    """`count` samples of noise, s32le."""
    return struct.pack(f"<{count}i", *(random.randint(-NOISE, NOISE) for _ in range(count)))  # noqa: S311  (test noise, not a secret)


class Pacer(threading.Thread):
    """The air between the two: one Mercury's playback is passed to the other's capture at 8000
    samples a second, with noise when nothing is played."""

    def __init__(self, played: str, captured: str) -> None:
        super().__init__(name=f"pacer {Path(played).name}", daemon=True)
        self.played, self.captured = played, captured
        self.stopping = threading.Event()
        self.bytes_carried = 0

    def run(self) -> None:
        # Opened without waiting for the player, which opens its side when it starts.
        source = os.open(self.played, os.O_RDONLY | os.O_NONBLOCK)
        # Waits for the capturing Mercury to open its side.
        sink = os.open(self.captured, os.O_WRONLY)
        pending = b""
        next_tick = time.monotonic()
        try:
            while not self.stopping.is_set():
                try:
                    chunk = os.read(source, 1 << 16)
                except BlockingIOError:
                    chunk = b""
                pending += chunk
                out, pending = pending[:TICK_BYTES], pending[TICK_BYTES:]
                os.write(sink, out + noise((TICK_BYTES - len(out)) // SAMPLE_BYTES))
                self.bytes_carried += len(out)
                next_tick += TICK_SEC
                time.sleep(max(0.0, next_tick - time.monotonic()))
        except OSError:
            pass
        finally:
            os.close(source)
            os.close(sink)


async def exchange(a: Page, b: Page, seconds: float) -> list[tuple[str, str]]:
    rows: list[tuple[str, str]] = []
    took = await a.until("the radio connected and Mercury's control port heard", a.ready, seconds)
    await b.until("the radio connected and Mercury's control port heard", b.ready, seconds)
    rows.append(("both daemons connected to their Mercury, control ports heard", f"{took:.1f} s"))
    await a.send({"cmd": "beacon_now"})
    took = await b.until("A's beacon", lambda: b.hears("OH2A"), seconds)
    rows.append(("A's beacon heard by B (one frame on the air)", f"{took:.1f} s"))
    await a.send({"cmd": "send_message", "to": "OH2B", "text": "Moi Pekka, kuuluuko?"})
    took = await a.until("the ack of A's message", lambda: a.acked() >= 1, seconds)
    rows.append(("A's message acked by B (a frame each way)", f"{took:.1f} s"))
    # B's topics are read only while something of B is awaited.
    await b.until("B's modem counting its frame", lambda: int(b.modem().get("frames_keyed") or 0) >= 1, 5.0)
    await a.send({"cmd": "send_message", "to": "OH2B", "text": LONG_TEXT})
    took = await a.until("the ack of the longest message", lambda: a.acked() == 2, seconds)
    rows.append(("the longest message (67 characters) acked: direct, it fits the frame", f"{took:.1f} s"))
    rows.append(("frames A keyed / B keyed", f"{a.modem().get('frames_keyed')} / {b.modem().get('frames_keyed')}"))
    rows.append(("SNR B heard A with / A heard B with", f"{b.modem().get('snr')} / {a.modem().get('snr')} dB"))
    return rows


def run(args: argparse.Namespace) -> int:
    shipped = find()
    binary = args.mercury or (shipped[0] if shipped else "")
    if not binary:
        raise Failure(
            "no Mercury in this checkout: build it with scripts/build-mercury --install, or give --mercury PATH"
        )
    folder = Path(tempfile.mkdtemp(prefix="mercury-bench-"))
    a_out, a_in, b_out, b_in = (fifo(folder, name) for name in ("a-out", "a-in", "b-out", "b-in"))
    processes: list[tuple[str, subprocess.Popen[bytes]]] = []
    pacers = [Pacer(a_out, b_in), Pacer(b_out, a_in)]
    pages = [Page("A"), Page("B")]
    try:
        processes.append(("Mercury A", start_mercury(binary, folder, "a", a_in, a_out, A_PORTS)))
        processes.append(("Mercury B", start_mercury(binary, folder, "b", b_in, b_out, B_PORTS)))
        for pacer in pacers:
            pacer.start()
        say(
            f"two Mercury instances started from {binary}, their audio paced through named pipes at {RATE} samples a second"
        )
        data_a, data_b = folder / "a", folder / "b"
        # Radio 1 is an FM radio that is off, radio 2 the HF radio of --hf-port.
        hf_alone = (("kiss", False), ("mercury", True))
        # A path setting, to see it ignored over HF; no timed beacon.
        write_settings(
            data_a,
            {
                "station/call": "OH2A",
                "station/lat": "60.17",
                "station/lon": "24.94",
                "beacon/interval_min": "0",
                "radio/1/path": "WIDE1-1,WIDE2-1",
                "messages/alert": "false",
            },
            radios=hf_alone,
        )
        write_settings(
            data_b,
            {
                "station/call": "OH2B",
                "station/lat": "61.50",
                "station/lon": "23.80",
                "beacon/interval_min": "0",
                "messages/alert": "false",
            },
            radios=hf_alone,
        )
        daemons = [start_daemon(data_a, A_PORTS), start_daemon(data_b, B_PORTS)]
        processes += [("daemon A", daemons[0]), ("daemon B", daemons[1])]
        bases = [wait_for_page(daemons[0], data_a, args.timeout), wait_for_page(daemons[1], data_b, args.timeout)]
        say(f"two daemons up: {bases[0]} (OH2A) and {bases[1]} (OH2B)")

        async def drive() -> list[tuple[str, str]]:
            for page, base in zip(pages, bases, strict=True):
                await page.open(base)
            try:
                return await exchange(pages[0], pages[1], args.timeout)
            finally:
                for page in pages:
                    page.close()

        rows = asyncio.run(drive())
        width = max(len(what) for what, _ in rows)
        print()
        for what, result in rows:
            print(f"  {what.ljust(width)}  {result}")
        print()
        codes = [stop(daemon, args.timeout) for daemon in daemons]
        if codes != [0, 0]:
            raise Failure(f"the daemons ended with exit codes {codes}, not 0")
        say("both daemons ended with exit code 0")
        return 0
    finally:
        for _, process in reversed(processes):
            stop(process, 5.0)
        for pacer in pacers:
            pacer.stopping.set()
        if args.keep:
            say(
                f"kept {folder}: the daemons' data folders a/ and b/ (neoaprs.log in each) and mercury-a.log, mercury-b.log"
            )
        else:
            shutil.rmtree(folder, ignore_errors=True)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="two Mercury instances over named pipes and two NeoAPRS daemons on them: a beacon, a message and its ack, a refusal"
    )
    parser.add_argument(
        "--mercury",
        metavar="PATH",
        help="the Mercury program (default: the one scripts/build-mercury --install put in the venv)",
    )
    parser.add_argument(
        "--timeout", type=float, default=60.0, metavar="SEC", help="how long each wait may take; default %(default)s"
    )
    parser.add_argument("--keep", action="store_true", help="keep the folders of the run and say where they are")
    args = parser.parse_args()
    if sys.platform == "win32":
        print("bench: named pipes of this kind are Linux's; run it there", file=sys.stderr)
        return 2
    try:
        return run(args)
    except Failure as e:
        print(f"bench: FAILED: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())

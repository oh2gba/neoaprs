#!/usr/bin/env python3
"""Run the suite in a container the size of GitHub's runner, on a copy of this tree.

  scripts/check-in-container                   the commands of the CI's job `python` on Linux in
                                               order, stopping at the first that fails
  scripts/check-in-container --job sim         the commands of the CI's job `sim` instead: the
                                               pinned Mercury built with the runner's compiler, then
                                               the simulation of an HF net
  scripts/check-in-container --starved         the same on half a runner, where the tests that
                                               depend on time show themselves
  scripts/check-in-container -- COMMAND...     this command instead, in the copy of the tree (it
                                               makes its own environment: `uv sync` first, or `uv
                                               run`)
  scripts/check-in-container --image-only      builds the image when it is not there, prints its
                                               name and stops
  scripts/check-in-container --prune           removes the images of other Dockerfiles that no
                                               container uses, and stops

Exit code: the command's, 125 when docker failed, 2 when not set up. Needs docker and git.
"""

import argparse
import contextlib
import fcntl
import hashlib
import io
import json
import os
import re
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
from collections import Counter
from collections.abc import Iterable, Iterator, Sequence
from dataclasses import dataclass
from pathlib import Path
from types import FrameType
from typing import IO

ROOT = Path(__file__).resolve().parent.parent
DOCKERFILE = ROOT / "packaging" / "ci" / "Dockerfile"
RUNNER_FILE = ROOT / "packaging" / "ci" / "runner.json"
SYS_CPU = Path("/sys/devices/system/cpu")
# The system's loader; its --help says which x86-64 levels run here.
LOADER = Path("/lib64/ld-linux-x86-64.so.2")
V3_SUPPORTED = "x86-64-v3 (supported"  # how its --help says v3 runs

IMAGE = "neoaprs-ci"  # the tag is the Dockerfile's digest
WORK = "/home/runner/work"
TREE = "neoaprs"
TRACKED = "tracked"
# Files of access tokens begin like this and are never packed.
NEVER_PACKED = ".secrets"
# The caches all runs share; the last holds Mercury's source archive.
VOLUMES = {
    "neoaprs-ci-uv": "/home/runner/.cache/uv",
    "neoaprs-ci-npm": "/home/runner/.npm",
    "neoaprs-ci-build": "/home/runner/.cache/neoaprs-build",
}
# Label with the threads a container holds, so a concurrent run avoids them.
CPUS_LABEL = "eu.oh2gba.neoaprs.check-cpus"
SHM = "1g"  # docker's 64 MB is too little for Qt
# 125 is what `docker run` itself exits with on failure.
NOT_SET_UP, DOCKER_FAILED = 2, 125
CREATE_PATIENCE_SEC = 60.0


@dataclass(frozen=True)
class Size:
    """How much of the machine a container gets."""

    threads: int
    memory_gb: int


RUNNER = Size(threads=4, memory_gb=16)  # GitHub's Linux runner (public repository)
STARVED = Size(threads=2, memory_gb=7)

# The commands of the job `python` of ci.yml; a test compares them.
CI_COMMANDS = (
    "uv sync --frozen --extra app --extra ble",
    "scripts/check --stage lock",
    "scripts/check --stage ruff",
    "scripts/check --stage mypy",
    "scripts/check --stage architecture",
    "scripts/check --stage pytest",
)

# The commands of the job `sim` of ci.yml.
SIM_COMMANDS = (
    "uv sync --frozen",
    "uv run scripts/build-mercury --install",
    "uv run scripts/mercury-sim --report mercury-sim.json --keep",
)
CI_JOBS = {"python": CI_COMMANDS, "sim": SIM_COMMANDS}

# The environment inside. UV_FROZEN makes `uv lock --check` skip pyproject.toml, so scripts/check
# unsets it in its `lock` stage; UV_LINK_MODE=copy as uv's cache is on another file system.
ENVIRONMENT = {"NEOAPRS_UPDATE_CHECK": "0", "UV_FROZEN": "1", "NEOAPRS_NO_DEVICES": "1", "UV_LINK_MODE": "copy"}

# Runs inside: unpack the tree as a one-commit repository, run each command until one fails.
# GIT_ variables are unset because a test runs this text outside a container too.
INSIDE = f"""set -eu
unset ${{!GIT_*}}
tar -xf -
tree="$PWD/{TREE}"
git init --quiet --initial-branch=master "$tree"
[ ! -s {TRACKED} ] || git -C "$tree" --literal-pathspecs add --force --pathspec-from-file="$PWD/{TRACKED}" --pathspec-file-nul
git -C "$tree" -c user.name=runner -c user.email=runner@localhost -c commit.gpgsign=false commit --quiet --allow-empty --message="The tree as it was on disk"
rm {TRACKED}
cd "$tree"
for line in "$@"; do
    echo "check-in-container: $line" >&2
    started=$SECONDS
    code=0
    bash -c "$line" </dev/null || code=$?
    echo "check-in-container: exit $code after $((SECONDS - started)) s: $line" >&2
    [ "$code" = 0 ] || exit "$code"
done
"""


def say(text: str) -> None:
    print(f"check-in-container: {text}", file=sys.stderr, flush=True)


# ---- the threads a run gets ----


def parse_cpu_list(text: str) -> tuple[int, ...]:
    """Return the thread numbers of the kernel's list ("0,16", "0-3")."""
    threads: list[int] = []
    for part in text.strip().split(","):
        first, _, last = part.partition("-")
        if first.strip():
            threads.extend(range(int(first), int(last or first) + 1))
    return tuple(threads)


def read_cores(folder: Path = SYS_CPU) -> list[tuple[int, ...]]:
    cores = set()
    for file in folder.glob("cpu[0-9]*/topology/thread_siblings_list"):
        with contextlib.suppress(OSError, ValueError):
            cores.add(parse_cpu_list(file.read_text(encoding="ascii")))
    return sorted(core for core in cores if core)


def choose_cpus(cores: Sequence[tuple[int, ...]], threads: int, taken: Iterable[int] = ()) -> list[int]:
    """Return whole cores totalling `threads`, those other runs hold least first."""
    held = Counter(taken)
    chosen: list[int] = []
    for core in sorted(cores, key=lambda siblings: sum(held[thread] for thread in siblings)):
        chosen.extend(core[: threads - len(chosen)])
        if len(chosen) >= threads:
            break
    return chosen


def taken_cpus() -> list[int]:
    done = subprocess.run(
        [
            "docker",
            "ps",
            "--all",
            "--filter",
            f"label={CPUS_LABEL}",
            "--filter",
            "status=created",
            "--filter",
            "status=running",
            "--format",
            f'{{{{.Label "{CPUS_LABEL}"}}}}',
        ],
        capture_output=True,
        text=True,
    )
    threads: list[int] = []
    for line in done.stdout.split() if done.returncode == 0 else []:
        with contextlib.suppress(ValueError):
            threads.extend(parse_cpu_list(line))
    return threads


@contextlib.contextmanager
def start_lock() -> Iterator[None]:
    """Serialise run starts so that two runs cannot choose the same cores."""
    path = Path(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()) / "neoaprs-check-in-container.lock"
    try:
        handle = path.open("a")
    except OSError:
        yield
        return
    with handle:  # closing releases the lock
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


# ---- the tree that goes in ----


class NotPacked(Exception):
    """The reason, in words for the user, why the tree cannot go in."""


def git(root: Path, *args: str) -> subprocess.CompletedProcess[bytes]:
    """Run git on the tree at `root` only; GIT_ variables are dropped."""
    environment = {name: value for name, value in os.environ.items() if not name.startswith("GIT_")}
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, env=environment)


def last_line(output: bytes) -> str:
    return (output.decode(errors="replace").strip().splitlines() or ["git said nothing"])[-1]


def check_repository(root: Path) -> None:
    done = git(root, "rev-parse", "--show-toplevel")
    top = os.fsdecode(done.stdout.removesuffix(b"\n"))
    if done.returncode != 0 or not top or Path(top).resolve() != root.resolve():
        raise NotPacked(
            f"{root} is not the working tree of a git repository (the tree that goes in is the one git lists)"
        )


def listed(root: Path, *flags: str) -> list[str]:
    """Return the listed files that are on disk and hold no tokens; NotPacked if git warns."""
    done = git(root, "ls-files", "-z", *flags)
    if done.returncode != 0 or done.stderr.strip():
        raise NotPacked(f"git could not list the files of {root} ({last_line(done.stderr)})")
    names = sorted({os.fsdecode(name) for name in done.stdout.split(b"\0") if name})
    return [name for name in names if not holds_tokens(name) and on_disk(root, name)]


def on_disk(root: Path, name: str) -> bool:
    try:
        if (root / name).parent.resolve(strict=True) != (root.resolve() / name).parent:
            # A folder of the path is now a link: the file is gone for git.
            return False
        mode = (root / name).lstat().st_mode
    except (FileNotFoundError, NotADirectoryError):
        return False
    except OSError as error:
        raise NotPacked(f"{name} could not be packed ({error.strerror or error})") from error
    return stat.S_ISLNK(mode) or stat.S_ISREG(mode)


def holds_tokens(name: str) -> bool:
    return any(part.startswith(NEVER_PACKED) for part in Path(name).parts)


def packed_files(root: Path) -> list[str]:
    return listed(root, "--cached", "--others", "--exclude-standard")


def tracked_files(root: Path) -> list[str]:
    return listed(root, "--cached")


def plain(member: tarfile.TarInfo) -> tarfile.TarInfo:
    """Strip the owner and give whole-second times (no extended header)."""
    member.uid = member.gid = 0
    member.uname = member.gname = ""
    member.mtime = int(member.mtime)
    return member


def pack(root: Path, out: IO[bytes]) -> None:
    """Write the tar the container unpacks: the tree and a NUL-separated list of tracked files."""
    check_repository(root)
    packed: set[str] = set()
    with tarfile.open(fileobj=out, mode="w|") as archive:
        for name in packed_files(root):
            try:
                archive.add(root / name, arcname=f"{TREE}/{name}", recursive=False, filter=plain)
            except FileNotFoundError:
                continue
            except OSError as error:
                raise NotPacked(f"{name} could not be packed ({error.strerror or error})") from error
            packed.add(name)
        listing = b"".join(os.fsencode(name) + b"\0" for name in tracked_files(root) if name in packed)
        member = tarfile.TarInfo(TRACKED)
        member.size, member.mtime = len(listing), int(time.time())
        archive.addfile(member, io.BytesIO(listing))


# ---- docker ----


def image_tag(dockerfile: Path = DOCKERFILE) -> str:
    return f"{IMAGE}:{hashlib.sha256(dockerfile.read_bytes()).hexdigest()[:12]}"


def docker_build(tag: str) -> list[str]:
    """Return the build command; the Dockerfile is on stdin, so no project file enters."""
    return ["docker", "build", "--tag", tag, "-"]


def docker_run(tag: str, size: Size, cpus: Sequence[int], commands: Sequence[str], cidfile: Path) -> list[str]:
    """Return the `docker run` command: removed on exit, pinned to CPUs and memory, tar on stdin."""
    cpu_set, memory = ",".join(str(cpu) for cpu in cpus), f"{size.memory_gb}g"
    line = [
        "docker",
        "run",
        "--rm",
        "--interactive",
        "--init",
        "--pull",
        "never",
        "--cidfile",
        str(cidfile),
        "--label",
        f"{CPUS_LABEL}={cpu_set}",
        "--cpuset-cpus",
        cpu_set,
        "--memory",
        memory,
        "--memory-swap",
        memory,
        "--shm-size",
        SHM,
        "--workdir",
        WORK,
    ]
    for name, value in ENVIRONMENT.items():
        line += ["--env", f"{name}={value}"]
    for volume, path in VOLUMES.items():
        line += ["--volume", f"{volume}:{path}"]
    return [*line, tag, "bash", "-c", INSIDE, "check-in-container", *commands]


def ensure_image() -> str | None:
    """Return the image name, building it if missing; None if the build failed."""
    tag = image_tag()
    if (
        subprocess.run(
            ["docker", "image", "inspect", tag], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        ).returncode
        != 0
    ):
        say(f"building {tag} from {DOCKERFILE.relative_to(ROOT)}")
        with DOCKERFILE.open("rb") as dockerfile:
            if subprocess.run(docker_build(tag), stdin=dockerfile, stdout=sys.stderr).returncode != 0:
                say("the image could not be built")
                return None
    return tag


class Container:
    """The container of this run; a signal ends it at once, as the shell inside ignores signals."""

    def __init__(self, cidfile: Path) -> None:
        self.cidfile = cidfile
        self.client: subprocess.Popen[bytes] | None = None
        self.stopped_by: int | None = None

    def made(self) -> bool:
        with contextlib.suppress(OSError):
            return bool(self.cidfile.read_text(encoding="ascii").strip())
        return False

    def remove(self) -> None:
        if self.made():
            subprocess.run(
                ["docker", "rm", "--force", self.cidfile.read_text(encoding="ascii").strip()],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        elif self.client is not None and self.client.poll() is None:
            self.client.terminate()

    def stop(self, number: int, frame: FrameType | None) -> None:
        self.stopped_by = number
        self.remove()

    def start(self, line: Sequence[str], tar: IO[bytes]) -> None:
        """Start the client in its own session, so Ctrl+C reaches only this script."""
        for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(number, self.stop)
        self.client = subprocess.Popen(line, stdin=tar, start_new_session=True)
        deadline = time.monotonic() + CREATE_PATIENCE_SEC
        while (
            not self.made() and self.client.poll() is None and self.stopped_by is None and time.monotonic() < deadline
        ):
            time.sleep(0.05)
        if self.stopped_by is not None:
            self.remove()  # a signal that came before the client

    def wait(self) -> int:
        """Return the run's exit code: the command's, or 128 plus the signal number."""
        assert self.client is not None
        code = self.client.wait()
        if self.stopped_by is not None:
            # A container may have been made as the client ended.
            self.remove()
            return 128 + self.stopped_by
        return code if code >= 0 else 128 - code


def run(tag: str, size: Size, cores: Sequence[tuple[int, ...]], commands: Sequence[str], tar: IO[bytes]) -> int:
    with tempfile.TemporaryDirectory(prefix="check-in-container-") as scratch:
        container = Container(Path(scratch) / "container-id")
        with start_lock():
            cpus = choose_cpus(cores, size.threads, taken_cpus())
            say(f"{tag} on threads {','.join(str(cpu) for cpu in cpus)} with {size.memory_gb} GB")
            container.start(docker_run(tag, size, cpus, commands, container.cidfile), tar)
        return container.wait()


# ---- this machine, what the image follows, and the images of other Dockerfiles ----


def runs_v3(loader: Path = LOADER) -> bool:
    """Return whether the system's loader (`ld.so --help`) says x86-64-v3 programs run here."""
    try:
        done = subprocess.run([str(loader), "--help"], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return False
    return V3_SUPPORTED in done.stdout


def follows(file: Path = RUNNER_FILE) -> str:
    try:
        runner = json.loads(file.read_text(encoding="utf-8"))
        facts = runner["facts"]
        return f"follows ubuntu-{facts['os']} (gcc {facts['gcc']}, {facts['march']}, glibc {facts['glibc']}, image {runner['image_version']})"
    except (OSError, ValueError, KeyError, TypeError) as error:
        return f"follows what {file.name} says, which could not be read ({error})"


SIZE_UNITS = {"B": 1, "kB": 1000, "KB": 1000, "MB": 1000**2, "GB": 1000**3, "TB": 1000**4}


def size_bytes(text: str) -> int | None:
    found = re.fullmatch(r"([\d.]+)\s*([kKMGT]?B)", text.strip())
    if found is None:
        return None
    with contextlib.suppress(ValueError):
        return int(float(found.group(1)) * SIZE_UNITS[found.group(2)])
    return None


def other_images(tag: str) -> list[tuple[str, int | None]] | None:
    """Return the images with another tag than `tag`, with sizes; None if docker fails."""
    done = subprocess.run(
        ["docker", "image", "ls", IMAGE, "--format", "{{.Tag}}\t{{.Size}}"], capture_output=True, text=True
    )
    if done.returncode != 0:
        return None
    images = []
    for line in done.stdout.splitlines():
        name, _, size = line.partition("\t")
        if name.strip() and name.strip() not in ("<none>", tag.partition(":")[2]):
            images.append((f"{IMAGE}:{name.strip()}", size_bytes(size)))
    return images


def gigabytes(images: Sequence[tuple[str, int | None]]) -> str:
    sizes = [size for _, size in images if size is not None]
    return f"{sum(sizes) / 1000**3:.1f} GB" + (" and more" if len(sizes) < len(images) else "")


def say_other_images(tag: str) -> None:
    images = other_images(tag)
    if images:
        say(
            f"{len(images)} other {IMAGE} image{'s' if len(images) != 1 else ''} on this machine, {gigabytes(images)} (--prune removes those no container uses)"
        )


def prune(tag: str) -> int:
    images = other_images(tag)
    if images is None:
        say("docker could not list its images")
        return DOCKER_FAILED
    removed, kept = [], []
    for image in images:
        done = subprocess.run(["docker", "image", "rm", image[0]], capture_output=True, text=True)
        (removed if done.returncode == 0 else kept).append(image)
    say(
        f"removed {len(removed)} image{'s' if len(removed) != 1 else ''} of other Dockerfiles ({gigabytes(removed)})"
        + (f"; kept {len(kept)} that a container uses: {', '.join(name for name, _ in kept)}" if kept else "")
    )
    return 0


# ---- the command ----


def split_command(argv: Sequence[str]) -> tuple[list[str], list[str]]:
    if "--" not in argv:
        return list(argv), []
    at = list(argv).index("--")
    return list(argv[:at]), list(argv[at + 1 :])


def main(argv: Sequence[str] | None = None) -> int:
    own, command = split_command(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(
        prog="check-in-container",
        usage="scripts/check-in-container [--job python|sim] [--starved] [--image-only] [--prune] [-- COMMAND...]",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--job", choices=sorted(CI_JOBS), default="python", help="the CI job whose commands are run (python by default)"
    )
    parser.add_argument("--starved", action="store_true", help="half a runner: two threads of one core and 7 GB")
    parser.add_argument(
        "--image-only", action="store_true", help="build the image when it is missing, print its name and stop"
    )
    parser.add_argument(
        "--prune", action="store_true", help="remove the images of other Dockerfiles that no container uses, and stop"
    )
    args = parser.parse_args(own)
    for tool in ("docker", "git"):
        if shutil.which(tool) is None:
            say(f"{tool} is not installed")
            return NOT_SET_UP
    if args.prune:
        return prune(image_tag())
    if not runs_v3():
        say("this computer's processor lacks x86-64-v3, which the runner's programs need")
        return NOT_SET_UP
    if args.image_only:
        say(follows())
        tag = ensure_image()
        if tag is not None:
            print(tag)
        return DOCKER_FAILED if tag is None else 0
    # Pack the tree before asking docker anything, so tree errors come first.
    with tempfile.TemporaryFile(prefix="check-in-container-") as tar:
        try:
            pack(ROOT, tar)
        except NotPacked as error:
            say(f"nothing was run: {error}")
            return NOT_SET_UP
        tar.seek(0)
        say(follows())
        tag = ensure_image()
        if tag is None:
            return DOCKER_FAILED
        say_other_images(tag)
        cores = read_cores()
        if not cores:
            say(
                f"the cores of this machine are not listed in {SYS_CPU}: without them the container would get every thread"
            )
            return NOT_SET_UP
        return run(
            tag,
            STARVED if args.starved else RUNNER,
            cores,
            [shlex.join(command)] if command else list(CI_JOBS[args.job]),
            tar,
        )


if __name__ == "__main__":
    try:
        sys.exit(main())
    # Ctrl+C while the image is built.
    except KeyboardInterrupt:
        sys.exit(128 + signal.SIGINT)

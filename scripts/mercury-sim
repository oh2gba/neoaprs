#!/usr/bin/env python3
"""The simulation of an HF net: N real Mercury instances on one computer joined by one simulated channel (tests/support/hfchannel.py: every station hears the sum of the others with noise at a chosen signal-to-noise ratio,
a keyed station hears nothing, two keyed at once collide), a NeoAPRS daemon on each with a data folder of its own, and a scenario driven through the pages' sockets and checked against what an HF net must do:
every station's beacon heard by every other, the longest message around the ring acked by each, two stations keyed at the same moment losing both frames and a message between them going through
after it, an ack lost on its way back (the sender's retry, the receiver's second ack, the message kept once), a station whose Mercury dies and comes back, a daemon stopped and started again with a message on its
way (the message goes on from the database), a weak link, a poor fading channel at 0 dB (the Watterson channel of CCIR 520-2: some beacons lost, a message through on its retries, and how long the busy detector took
to learn the new noise), the first stations with the FM radio too (a KISS hub is their FM air: a message to a station heard on FM goes on FM, one to a station heard on HF alone over HF, and that one still going over HF while the FM radio is away), and the first station gating
what it hears to a fake APRS-IS. Nothing is keyed, nothing leaves the loopback. The daemon may be the checkout's or an installed one
(`--daemon /usr/bin/neoaprs` after the .deb, `--daemon ./NeoAPRS.AppImage`), and the Mercury the one the checkout carries (scripts/build-mercury --install) or any (`--mercury`), so that the same scenario can be run by hand
against what ships. For a developer, by hand, and for the `sim` job of the CI workflow (the checkout's daemon with the pinned Mercury built from source); Linux only (named pipes, Mercury's fifo backend).

  scripts/mercury-sim [--stations N] [--fm N] [--snr DB] [--fading PRESET] [--seed S] [--first-port N] [--timeout SEC] [--keep] [--mercury PATH] [--daemon CMD] [--report FILE]

The report is a table of what happened and the times, the channel's counts (blocks, collisions, what each station sent and heard), and exit 0 when every expectation held; --report writes the same as JSON. The
default run (five stations, two of them on FM too) takes about five minutes on a developer's machine and about the same on a CI runner (the simulation waits on the air, not on the CPU: a Mercury instance and a
daemon each take a few percent of a core); `--fading poor --snr 6` runs the whole scenario on a fading channel, where the expectations may well not hold and the exit code says so. Two runs at once need
different --first-port values (ten ports a station from there).
"""
import argparse
import asyncio
import functools
import json
import math
import operator
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from neoaprs.mercury import BUSY_HOLD_MAX_SEC  # noqa: E402  (the daemon package, from the checkout the simulation is in)
from neoaprs.mercuryhelper import find  # noqa: E402
from tests.support.hfchannel import PRESETS, Channel  # noqa: E402
from tests.support.realmercury import AprsIs, Failure, FmHub, Page, default_daemon, fifo, start_daemon, start_mercury, stop, wait_for_page, write_settings  # noqa: E402

FIRST_PORT = 18100               # station i has the KISS port FIRST_PORT + 10 i and the control port 200 above it (the daemon expects that distance of a Mercury it did not start)
WEAK_LINK_DB = -27.0             # the gain of the weak link: at the channel's default 30 dB this leaves 3 dB, where DATAC3 still decodes every frame on a flat channel (scripts/mercury-measure decode: all frames down to -2 dB, none at -6)
LONG_TEXT = "x" * 67             # the longest message there is: with its number and the addressee it is 98 bytes direct, under the frame's 123
LATE_BLOCKS_MAX_PER_MILLE = 5.0  # the share of the channel's 20 ms blocks that may start a block late or more: a busy machine stalls the thread for a block now and then (a quiet machine has none or one in 18,000; a GitHub runner was seen at 1.6 per mille and passed at under 1 twice), and a frame survives a late block, which only delays it; a second's stall would be fifty
REFUSAL_SEC = 0.5                # how long a command is given to be refused before it counts as taken (the daemon answers a refusal at once)
FADED_BEACONS = 6                # beacons sent over the poor channel at 0 dB: codec2's table has DATAC3 deliver 74 of 100 single frames there, so some of these are lost and some heard


def say(text: str) -> None:
    print(f"sim: {text}", flush=True)


def more_acked(page: Page, before: int) -> Callable[[], bool]:
    return lambda: page.acked() > before


class Net:
    """The stations of the run: their Mercury processes, daemons, pages and the channel between them."""

    def __init__(self, args: argparse.Namespace, folder: Path, binary: str, daemon: list[str]) -> None:
        self.args, self.folder, self.binary, self.daemon_command = args, folder, binary, daemon
        self.names = [f"SIM{i + 1}" for i in range(args.stations)]
        self.ports = {name: (args.first_port + 10 * i, args.first_port + 10 * i + 200) for i, name in enumerate(self.names)}
        self.channel = Channel(snr_db=args.snr, seed=args.seed)
        self.fm_port = 0
        self.mercuries: dict[str, subprocess.Popen[bytes]] = {}
        self.daemons: dict[str, subprocess.Popen[bytes]] = {}
        self.pages = {name: Page(name) for name in self.names}
        for page in self.pages.values():
            page.on_error = lambda name, error: say(f"{name}'s daemon refused: {json.dumps(error)}")
        self.rows: list[tuple[str, str]] = []
        self.failed: list[str] = []
        self.fifos: dict[str, tuple[str, str]] = {}
        self.channel_started = False

    def start_mercuries(self) -> None:
        for name in self.names:
            rx, tx = fifo(self.folder, f"{name}-rx"), fifo(self.folder, f"{name}-tx")
            self.fifos[name] = (rx, tx)
            self.channel.add(name, rx, tx)
            self.mercuries[name] = start_mercury(self.binary, self.folder, name.lower(), rx, tx, self.ports[name])
        if self.args.fading:
            self.channel.set_fading(self.args.fading, seed=self.args.seed)
        self.channel.start()
        self.channel_started = True

    def restart_mercury(self, name: str) -> None:
        rx, tx = self.fifos[name]
        self.mercuries[name] = start_mercury(self.binary, self.folder, name.lower() + "-again", rx, tx, self.ports[name])

    def start_daemons(self, igate_server: str, fm_port: int = 0) -> dict[str, str]:
        bases: dict[str, str] = {}
        self.fm_port = fm_port
        for i, name in enumerate(self.names):
            data = self.folder / name.lower()
            on_fm = i < self.args.fm                      # (the first stations have the FM radio too: the KISS hub is their TNC)
            settings = {"station/call": name, "station/lat": f"{60.0 + 0.1 * i:.2f}", "station/lon": f"{24.0 + 0.1 * i:.2f}", "hf/enabled": "true", "fm/enabled": "true" if on_fm else "false",
                        "beacon/interval_min": "0", "station/comment": f"sim station {i + 1}", "messages/alert": "false", **({"tnc/profile": "kiss-tcp"} if on_fm else {})}
            if i == 0:
                settings.update({"igate/enabled": "true", "igate/server": igate_server, "igate/password": "12345"})
            write_settings(data, settings, self.daemon_command)
            self.daemons[name] = start_daemon(data, self.ports[name], self.daemon_command, fm_port if on_fm else 0)
        for name in self.names:
            bases[name] = wait_for_page(self.daemons[name], self.folder / name.lower(), self.args.timeout)
        return bases

    def row(self, what: str, result: str, ok: bool = True) -> None:
        self.rows.append((what, result + ("" if ok else "   <- not as expected")))
        if not ok:
            self.failed.append(what)

    async def when_free(self, page: Page) -> None:
        """Waits until the station's radio takes a frame now: the daemon refuses `beacon_now` and `send_message` while Mercury keys the radio or hears a signal (the one carrier sense of the plane), as a real operator
        sees the busy lamp. A BUSY that lasts holds nothing after the modem's cap (the detector's noise floor learns a step slowly), so the wait is that long at most and the send then goes to the daemon's judgement."""
        try:
            await page.until("the radio free", page.free, BUSY_HOLD_MAX_SEC + 5.0)
        except Failure:
            pass

    async def everyone(self, what: str, condition: Any, seconds: float, since: float | None = None, but: str = "") -> float:
        """Waits for the condition on every station but `but`; the longest it took (from `since`, the loop time of a send, or from now)."""
        took = 0.0
        for name, page in self.pages.items():
            if name != but:
                took = max(took, await page.until(what, functools.partial(condition, page), seconds, since))
        return took

    def attempts_of(self, page: Page, text: str) -> int:
        """How many times the message of this station's own with this text has been transmitted."""
        return max((int(m.get("attempts") or 0) for m in page.messages().values() if m.get("direction") == "out" and m.get("text") == text), default=0)

    def copies_of(self, page: Page, text: str) -> int:
        """How many messages with this text the station has received (one, however many times it came)."""
        return sum(1 for m in page.messages().values() if m.get("direction") == "in" and m.get("text") == text)

    async def restart_daemon(self, name: str) -> float:
        """Stops the station's daemon as the system would and starts it again on the same data folder, with a fresh page on it; the seconds until its radio is back."""
        started = time.monotonic()
        stop(self.daemons[name], self.args.timeout)
        self.pages[name].close()
        data = self.folder / name.lower()
        offset = len((data / "neoaprs.log").read_bytes())                          # (the new run's page line comes after the old one's)
        on_fm = self.names.index(name) < self.args.fm
        self.daemons[name] = start_daemon(data, self.ports[name], self.daemon_command, self.fm_port if on_fm else 0)
        base = wait_for_page(self.daemons[name], data, self.args.timeout, offset)
        page = self.pages[name] = Page(name)
        page.on_error = lambda who, error: say(f"{who}'s daemon refused: {json.dumps(error)}")
        await page.open(base)
        await page.until("the radio back after the restart", page.ready, self.args.timeout)
        return time.monotonic() - started

    async def send_taken(self, page: Page, command: dict[str, Any], seconds: float | None = None) -> float:
        """Sends the command when the station's radio is free, and again when the daemon refuses it all the same (the channel went busy, or a frame of the station's own went out, between the look and the send:
        `beacon_now` and `send_message` are refused while the radio is held), until it is taken or `seconds` have passed; a refusal for any other reason is a Failure. The loop time of the send that was taken,
        for the waits that measure from it."""
        seconds = self.args.timeout * 2 if seconds is None else seconds
        loop = asyncio.get_running_loop()
        started = loop.time()
        while True:
            await self.when_free(page)
            errors = len(page.errors)
            sent = loop.time()
            await page.send(command)
            while loop.time() - sent < REFUSAL_SEC and len(page.errors) == errors:
                await asyncio.sleep(0.05)
            if len(page.errors) == errors:
                return sent
            refusal = json.dumps(page.errors[-1])
            if "busy" not in refusal and "transmitting" not in refusal:
                raise Failure(f"{page.name}: {command['cmd']} was refused: {refusal}")
            if loop.time() - started > seconds:
                raise Failure(f"{page.name}: {command['cmd']} was refused for {seconds:g} s: {refusal}")
            await asyncio.sleep(0.5)

    async def key_together(self, a: Page, b: Page) -> None:
        """Both stations key at the same moment: `beacon_now` to both at once, sent again when either was refused (its radio was held at that moment), up to three times."""
        for _ in range(3):
            await self.when_free(a)
            await self.when_free(b)
            errors = len(a.errors) + len(b.errors)
            await asyncio.gather(a.send({"cmd": "beacon_now"}), b.send({"cmd": "beacon_now"}))
            await asyncio.sleep(REFUSAL_SEC)
            if len(a.errors) + len(b.errors) == errors:
                return
        raise Failure(f"{a.name} and {b.name} could not be keyed together: {json.dumps((a.errors + b.errors)[-1])}")

    async def fm_radio_away(self, hub: FmHub) -> None:
        """With both radios on and the FM radio away (a TNC unplugged, out of power or out of range at night), a message to a station heard on HF alone must still go: what holds a frame is the radio of the frame,
        not the FM radio. The hub stops listening and drops every line; the first station's message goes over HF without waiting for the FM radio's back-off; the hub listens again and the radios come back."""
        timeout = self.args.timeout
        page, far, text = self.pages[self.names[0]], self.names[-1], "while the FM radio is away"
        await page.until(f"{page.name}'s FM radio connected", page.fm_connected, timeout)
        hub.hang_up()
        gone = await page.until(f"{page.name}'s daemon noticing its FM radio is gone", lambda: not page.fm_connected(), timeout)
        self.row(f"the FM air gone: {page.name}'s daemon says its FM radio is not connected after", f"{gone:.1f} s")
        n = page.acked()
        sent = await self.send_taken(page, {"cmd": "send_message", "to": far, "text": text})
        try:
            took = await page.until(f"the ack of the message to {far} with the FM radio away", lambda: page.acked() > n, timeout * 2, since=sent)
            attempts = self.attempts_of(page, text)
            self.row(f"a message to {far}, heard on HF alone, sent while the FM radio is away: went over HF and was acked on attempt {attempts} after", f"{took:.1f} s (the FM radio's absence must not hold it)", attempts <= 2)
        except Failure as e:
            self.row(f"a message to {far}, heard on HF alone, sent while the FM radio is away: not acked within", f"{timeout * 2:.0f} s after {self.attempts_of(page, text)} attempts ({e})", False)
        await hub.start()
        back = await page.until(f"{page.name}'s FM radio back on the hub", page.fm_connected, timeout * 2)
        self.row(f"the FM air back: {page.name}'s FM radio connected again after", f"{back:.1f} s")

    async def drive(self, bases: dict[str, str], aprsis: AprsIs, hub: FmHub) -> None:
        timeout = self.args.timeout
        names = self.names
        for name, page in self.pages.items():
            await page.open(bases[name])
        took = await self.everyone("the radio connected and Mercury's control port heard", lambda p: p.ready(), timeout)
        self.row(f"{len(names)} daemons connected to their Mercury, control ports heard", f"{took:.1f} s")
        # 1. every station's beacon heard by every other: one frame each, in turn, so that nothing collides here
        slowest = 0.0
        for name, page in self.pages.items():
            sent = await self.send_taken(page, {"cmd": "beacon_now"})
            slowest = max(slowest, await self.everyone(f"{name}'s beacon", operator.methodcaller("hears", name), timeout, since=sent, but=name))
        collisions = self.channel.report()["totals"]["collisions"]
        self.row(f"every beacon heard by every other station ({len(names) * (len(names) - 1)} hearings), slowest", f"{slowest:.1f} s", collisions == 0)
        self.row("collisions while the beacons went one at a time", str(collisions), collisions == 0)
        # 2. the longest message around the ring: each station to the next, acked (a station on FM too messages its FM neighbour on FM: the ring crosses both airs)
        acked_times: list[float] = []
        for i, name in enumerate(names):
            to = names[(i + 1) % len(names)]
            page = self.pages[name]
            before = page.acked()
            sent = await self.send_taken(page, {"cmd": "send_message", "to": to, "text": LONG_TEXT})
            acked_times.append(await page.until(f"the ack of {name}'s message to {to}", more_acked(page, before), timeout, since=sent))
        self.row(f"the longest message (67 characters) around the ring, acked by each of {len(names)} ({len(names)} frames each way), slowest", f"{max(acked_times):.1f} s")
        # 3. two stations heard on HF alone keyed at the same moment: both frames lost (no carrier sense can see a frame that has not started), then a message between them goes through
        a, b, c = names[-2], names[-1], names[0]
        before = self.channel.report()["totals"]["collisions"]
        await self.key_together(self.pages[a], self.pages[b])
        await self.pages[c].drain(8.0)
        collided = self.channel.report()["totals"]["collisions"] - before
        self.row(f"{a} and {b} keyed at the same moment: blocks in collision", str(collided), collided > 0)
        page = self.pages[a]
        n = page.acked()
        sent = await self.send_taken(page, {"cmd": "send_message", "to": b, "text": "after the collision"})
        took = await page.until(f"the ack of {a}'s message to {b} after the collision", lambda: page.acked() > n, timeout * 2, since=sent)
        self.row(f"a message {a} -> {b} over HF right after it, acked on attempt {self.attempts_of(page, 'after the collision')} after", f"{took:.1f} s")
        # 4. an ack lost on its way back: the receiver hears the message and acks it into the void; the sender tries again after the first wait, the receiver acks again and keeps the message once
        sender, far = names[0], names[-1]
        a_page, b_page = self.pages[sender], self.pages[far]
        self.channel.set_link(far, sender, gain_db=-math.inf, symmetric=False)                 # (the sender hears nothing of the far station)
        n = a_page.acked()
        keyed_before = int(b_page.modem().get("frames_keyed") or 0)
        sent = await self.send_taken(a_page, {"cmd": "send_message", "to": far, "text": "lost ack"})
        await b_page.until(f"{far} receiving the message", lambda: self.copies_of(b_page, "lost ack") >= 1, timeout)
        await b_page.until(f"{far}'s ack keyed", lambda: int(b_page.modem().get("frames_keyed") or 0) > keyed_before, timeout)
        await a_page.drain(6.0)
        self.channel.set_link(far, sender, gain_db=0.0, symmetric=False)
        acked_before_retry = a_page.acked() > n
        took = await a_page.until("the ack of the message after the retry", lambda: a_page.acked() > n, timeout * 2)
        attempts, copies = self.attempts_of(a_page, "lost ack"), self.copies_of(b_page, "lost ack")
        self.row(f"an ack lost on its way back: {sender}'s message to {far} acked on attempt {attempts} after", f"{took:.1f} s", attempts == 2 and not acked_before_retry)
        self.row(f"{far} kept the message once though it came twice", f"{copies} copy", copies == 1)
        # 5. a station whose Mercury dies and comes back: the daemon says so, waits, and is back on the air when Mercury is
        lost = names[-1]
        self.mercuries[lost].kill()
        self.mercuries[lost].wait()
        page = self.pages[lost]
        took = await page.until(f"{lost}'s radio noticing its Mercury is gone", lambda: (page.topics.get("hf") or {}).get("state") != "connected", timeout)
        self.row(f"{lost}'s Mercury killed: its daemon says the radio is gone after", f"{took:.1f} s")
        sender_page = self.pages[names[0]]
        n = sender_page.acked()
        sent = await self.send_taken(sender_page, {"cmd": "send_message", "to": lost, "text": "are you there?"})
        await asyncio.sleep(3.0)
        self.restart_mercury(lost)
        took = await page.until(f"{lost}'s radio back on its Mercury", lambda: page.ready(), timeout)
        self.row(f"{lost}'s Mercury started again: its daemon back on the air after", f"{took:.1f} s")
        took = await sender_page.until(f"the ack of the message sent while {lost} was gone", lambda: sender_page.acked() > n, timeout * 3, since=sent)
        self.row(f"the message sent to {lost} while it was gone, acked on attempt {self.attempts_of(sender_page, 'are you there?')} after", f"{took:.1f} s")
        # 6. a daemon stopped and started again with a message on its way: the message is in its database and goes on from there (the ack that came while it was down is lost; the retry is acked)
        sender, far = names[0], names[-1]
        page = self.pages[sender]
        n = page.acked()
        await self.send_taken(page, {"cmd": "send_message", "to": far, "text": "across a restart"})
        await page.until("the first attempt out", lambda: self.attempts_of(page, "across a restart") >= 1, timeout)
        restart_took = await self.restart_daemon(sender)
        page = self.pages[sender]
        took = await page.until("the ack after the restart", lambda: page.acked() > n, timeout * 3)
        attempts = self.attempts_of(page, "across a restart")
        self.row(f"{sender}'s daemon stopped and started again with a message on its way: back on the air after", f"{restart_took:.1f} s")
        copies = self.copies_of(self.pages[far], "across a restart")
        self.row(f"the message went on from the database and was acked on attempt {attempts}, after", f"{took:.1f} s")
        self.row(f"{far} kept the message once though the restart may have sent it twice", f"{copies} copy", copies == 1)
        # 7. a weak link: the far station hears the first at WEAK_LINK_DB below the others
        sender_page = self.pages[names[0]]
        self.channel.set_link(names[0], far, gain_db=WEAK_LINK_DB, symmetric=False)
        n = sender_page.acked()
        started = time.monotonic()
        sent = await self.send_taken(sender_page, {"cmd": "send_message", "to": far, "text": "over the weak link"})
        try:
            took = await sender_page.until("the ack over the weak link", lambda: sender_page.acked() > n, timeout * 2, since=sent)
            self.row(f"a message over a link {WEAK_LINK_DB:g} dB down (about {self.args.snr + WEAK_LINK_DB:g} dB SNR), acked on attempt {self.attempts_of(sender_page, 'over the weak link')} after", f"{took:.1f} s")
        except Failure:
            self.row(f"a message over a link {WEAK_LINK_DB:g} dB down (about {self.args.snr + WEAK_LINK_DB:g} dB SNR): not acked within", f"{time.monotonic() - started:.0f} s (reported, not required)")
        self.channel.set_link(names[0], far, gain_db=0.0, symmetric=False)
        # 8. a poor channel at 0 dB: every link fades (CCIR 520-2 poor: two paths, 2 ms apart, 1 Hz of Doppler spread) and the noise is at the signal's level; some beacons are lost, a message gets through on its
        #    retries, and the busy detectors, whose noise floor rises slowly, hold the radios for a while (the modem's hold cap lets a frame go after a minute at most)
        if not self.args.fading:
            faded, far = names[-2], names[-1]
            page = self.pages[faded]
            self.channel.set_fading("poor", seed=self.args.seed)
            self.channel.snr_db = 0.0
            heard_before = {name: int((p.stations().get(faded) or {}).get("heard_hf") or 0) for name, p in self.pages.items() if name != faded}
            held_from = time.monotonic()
            await self.send_taken(page, {"cmd": "beacon_now"})
            held = time.monotonic() - held_from
            self.row("the noise raised by 30 dB and every link fading: the busy detector held the radio for", f"{held:.0f} s before the first beacon went (the modem lets a frame go after a minute at most)")
            for _ in range(FADED_BEACONS - 1):
                await asyncio.sleep(5.5)
                await self.send_taken(page, {"cmd": "beacon_now"})
            await asyncio.sleep(6.0)
            chances = FADED_BEACONS * (len(names) - 1)
            heard = sum(int((p.stations().get(faded) or {}).get("heard_hf") or 0) - heard_before[name] for name, p in self.pages.items() if name != faded)
            self.row(f"a poor channel at 0 dB SNR: {faded}'s {FADED_BEACONS} beacons heard by the {len(names) - 1} other stations", f"{heard} of {chances} ({100 * heard / chances:.0f} %; codec2's table: 74 of 100 frames)", 0 < heard < chances)
            n = page.acked()
            sent = await self.send_taken(page, {"cmd": "send_message", "to": far, "text": "through the fading"})
            started = time.monotonic()
            try:
                took = await page.until("the ack through the fading", lambda: page.acked() > n, timeout * 4, since=sent)
                self.row(f"a message {faded} -> {far} through it, acked on attempt {self.attempts_of(page, 'through the fading')} after", f"{took:.1f} s")
            except Failure:
                self.row(f"a message {faded} -> {far} through it: not acked within", f"{time.monotonic() - started:.0f} s after {self.attempts_of(page, 'through the fading')} attempts (reported, not required)")
            self.channel.set_fading(None)
            self.channel.snr_db = self.args.snr
            await asyncio.sleep(3.0)
        # 9. the FM side: a station heard on FM is messaged on FM, one heard on HF alone over HF (the hub is the FM air of the first `--fm` stations)
        if self.args.fm >= 2:
            fm_a, fm_b, hf_only = self.pages[names[0]], self.pages[names[1]], names[-1]
            for page in (fm_a, fm_b):
                await self.send_taken(page, {"cmd": "beacon_now"})                         # (both radios: the other FM station hears it on FM too)
            await fm_a.until(f"{names[1]} heard on FM", lambda: (fm_a.stations().get(names[1]) or {}).get("heard_fm", 0) > 0, timeout)
            await fm_a.until(f"{hf_only} heard on HF alone", lambda: (fm_a.stations().get(hf_only) or {}).get("heard_hf", 0) > 0, timeout)
            n = fm_a.acked()
            sent = await self.send_taken(fm_a, {"cmd": "send_message", "to": names[1], "text": "near you on FM"})
            took = await fm_a.until("the ack on FM", lambda: fm_a.acked() > n, timeout, since=sent)
            self.row(f"a message to {names[1]}, heard on both radios, went on FM and was acked after", f"{took:.1f} s", hub.heard(b"near you on FM"))
            sent = await self.send_taken(fm_a, {"cmd": "send_message", "to": hf_only, "text": "far from you over HF"})
            took = await fm_a.until("the ack over HF", lambda: fm_a.acked() > n + 1, timeout * 2, since=sent)
            self.row(f"a message to {hf_only}, heard on HF alone, went over HF (nothing of it on the FM air) and was acked after", f"{took:.1f} s (the pace keeps 10 s between two attempts of ours, on either radio)", not hub.heard(b"far from you over HF"))
            # 10. the FM radio silent while HF talks: the first station loses its FM radio, and a message to the station heard on HF alone must still go
            await self.fm_radio_away(hub)
        # 11. the iGate: the first station gated the others' beacons
        gated = {line.split(">", 1)[0] for line in aprsis.packets}
        others = set(names[1:])
        self.row(f"the iGate on {names[0]} gated the beacons of", f"{len(gated & others)} of {len(others)} stations", others <= gated)
        for page in self.pages.values():
            page.close()


def table(rows: list[tuple[str, str]]) -> None:
    width = max(len(what) for what, _ in rows)
    print()
    for what, result in rows:
        print(f"  {what.ljust(width)}  {result}")
    print()


def run(args: argparse.Namespace) -> int:
    shipped = find()
    binary = args.mercury or (shipped[0] if shipped else "")
    if not binary:
        raise Failure("no Mercury in this checkout: build it with scripts/build-mercury --install, or give --mercury PATH")
    daemon = shlex.split(args.daemon) if args.daemon else default_daemon()
    folder = Path(tempfile.mkdtemp(prefix="mercury-sim-"))
    net = Net(args, folder, binary, daemon)
    started = time.monotonic()
    try:
        net.start_mercuries()
        say(f"{args.stations} Mercury instances started from {binary}, joined by one channel at {args.snr:g} dB SNR{f', every link fading ({args.fading})' if args.fading else ''} (seed {args.seed})")

        async def whole() -> None:
            aprsis, hub = AprsIs(), FmHub()
            await aprsis.start()
            await hub.start()
            try:
                bases = net.start_daemons(aprsis.address, hub.port)
                say(f"{args.stations} daemons up ({' '.join(daemon)}), the first {args.fm} on the FM hub too: " + ", ".join(f"{n} {b}" for n, b in bases.items()))
                await net.drive(bases, aprsis, hub)
            finally:
                aprsis.close()
                hub.close()

        asyncio.run(whole())
        report = net.channel.report()
        totals = report["totals"]
        net.row("channel blocks / blocks in collision", f"{totals['blocks']} / {totals['collisions']}")
        late, blocks = totals["late_blocks"], max(1, totals["blocks"])
        net.row("channel blocks that started a whole block late or more", f"{late} of {blocks} ({1000 * late / blocks:.2f} per mille; at most {LATE_BLOCKS_MAX_PER_MILLE:g}, a busy machine stalls the pace now and then)", 1000 * late <= LATE_BLOCKS_MAX_PER_MILLE * blocks)
        for name, counts in report["stations"].items():
            net.row(f"{name}: blocks sent / heard / overlapped / dropped", f"{counts['blocks_sent']} / {counts['blocks_heard']} / {counts['overlapped_blocks']} / {counts['dropped']}")
        codes = {name: stop(d, args.timeout) for name, d in net.daemons.items()}
        net.row("daemons ended with exit code 0", ", ".join(f"{n} {c}" for n, c in codes.items()), all(c == 0 for c in codes.values()))
        table(net.rows)
        if args.report:
            Path(args.report).write_text(json.dumps({"rows": net.rows, "channel": report, "failed": net.failed, "stations": args.stations, "snr_db": args.snr, "fading": args.fading, "seed": args.seed, "seconds": round(time.monotonic() - started, 1)}, indent=1), encoding="utf-8")
        if net.failed:
            raise Failure(f"{len(net.failed)} expectation(s) not met: " + "; ".join(net.failed))
        say(f"every expectation held in {time.monotonic() - started:.0f} s")
        return 0
    finally:
        for process in [*net.daemons.values(), *net.mercuries.values()]:
            stop(process, 5.0)
        if net.channel_started:
            net.channel.stop()
        if args.keep:
            say(f"kept {folder}: a data folder per station (neoaprs.log in each) and the Mercury logs")
        else:
            shutil.rmtree(folder, ignore_errors=True)


def main() -> int:
    parser = argparse.ArgumentParser(description="N real Mercury instances on one simulated HF channel, a NeoAPRS daemon on each, a scenario checked against what the net must do")
    parser.add_argument("--stations", type=int, default=5, metavar="N", help="how many stations; default %(default)s, at least 3")
    parser.add_argument("--snr", type=float, default=30.0, metavar="DB", help="the signal-to-noise ratio in 3 kHz of a station at full gain; default %(default)s")
    parser.add_argument("--fading", choices=tuple(PRESETS), help="run the whole scenario on this Watterson channel (the expectations may not hold there; the poor channel at 0 dB is a step of every run anyway)")
    parser.add_argument("--seed", type=int, default=1, metavar="S", help="the seed of the channel's noise and fading; default %(default)s")
    parser.add_argument("--first-port", type=int, default=FIRST_PORT, metavar="N", help="the KISS port of the first station (ten ports a station from there); default %(default)s")
    parser.add_argument("--fm", type=int, default=2, metavar="N", help="how many of the stations (the first ones) have the FM radio too, on a KISS hub that is their FM air; default %(default)s, 0 for HF alone")
    parser.add_argument("--timeout", type=float, default=60.0, metavar="SEC", help="how long one wait may take; default %(default)s")
    parser.add_argument("--keep", action="store_true", help="keep the folders of the run and say where they are")
    parser.add_argument("--mercury", metavar="PATH", help="the Mercury program (default: the one scripts/build-mercury --install put in the venv)")
    parser.add_argument("--daemon", metavar="CMD", help="the daemon to run (default: this Python's `-m neoaprs`); e.g. /usr/bin/neoaprs after the .deb")
    parser.add_argument("--report", metavar="FILE", help="write the report as JSON here too")
    args = parser.parse_args()
    if sys.platform == "win32":
        print("sim: named pipes of this kind are Linux's; run it there", file=sys.stderr)
        return 2
    if args.stations < 3:
        print("sim: at least 3 stations (a third hears the two that collide)", file=sys.stderr)
        return 2
    args.fm = max(0, min(args.fm, args.stations - 1))                 # (the last station is the one heard on HF alone)
    try:
        return run(args)
    except Failure as e:
        print(f"sim: FAILED: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    sys.exit(main())

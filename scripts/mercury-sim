#!/usr/bin/env python3
"""The simulation of an HF net: N real Mercury instances on one computer joined by one simulated channel (tests/support/hfchannel.py: every station hears the sum of the others with noise at a chosen signal-to-noise ratio,
a keyed station hears nothing, two keyed at once collide), a NeoAPRS daemon on each with a data folder of its own, and a scenario driven through the pages' sockets and checked against what an HF net must do:
every station's beacon heard by every other, a message around the ring acked by each, two stations keyed at the same moment losing both frames and a message between them going through on the retry, a station
whose Mercury dies and comes back, a weak link, the first stations with the FM radio too (a KISS hub is their FM air: a message to a station heard on FM goes on FM, one to a station heard on HF alone over HF), and the
first station gating what it hears to a fake APRS-IS. Nothing is keyed, nothing leaves the loopback. The daemon may be the checkout's or an installed one
(`--daemon /usr/bin/neoaprs` after the .deb, `--daemon ./NeoAPRS.AppImage`), and the Mercury the one the checkout carries (scripts/build-mercury --install) or any (`--mercury`), so that the same scenario runs
against what ships. For a developer, by hand, and the release workflow against its artifacts; Linux only (named pipes, Mercury's fifo backend).

  scripts/mercury-sim [--stations N] [--fm N] [--snr DB] [--seed S] [--timeout SEC] [--keep] [--mercury PATH] [--daemon CMD] [--report FILE]

The report is a table of what happened and the times, the channel's counts (blocks, collisions, what each station sent and heard), and exit 0 when every expectation held; --report writes the same as JSON.
"""
import argparse
import asyncio
import functools
import json
import operator
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from neoaprs.mercuryhelper import find  # noqa: E402  (the daemon package, from the checkout the simulation is in)
from tests.support.hfchannel import Channel  # noqa: E402
from tests.support.realmercury import AprsIs, Failure, FmHub, Page, default_daemon, fifo, start_daemon, start_mercury, stop, wait_for_page, write_settings  # noqa: E402

FIRST_PORT = 18100               # station i has the KISS port FIRST_PORT + 10 i and the control port 200 above it (the daemon expects that distance of a Mercury it did not start)
WEAK_LINK_DB = -25.0             # the gain of the weak link: at the channel's default 30 dB this leaves 5 dB, where DATAC3 still decodes but not every time
TEXT = "Moi, kuuluuko? 73"


def say(text: str) -> None:
    print(f"sim: {text}", flush=True)


def more_acked(page: Page, before: int) -> Callable[[], bool]:
    return lambda: page.acked() > before


class Net:
    """The stations of the run: their Mercury processes, daemons, pages and the channel between them."""

    def __init__(self, args: argparse.Namespace, folder: Path, binary: str, daemon: list[str]) -> None:
        self.args, self.folder, self.binary, self.daemon_command = args, folder, binary, daemon
        self.names = [f"SIM{i + 1}" for i in range(args.stations)]
        self.ports = {name: (FIRST_PORT + 10 * i, FIRST_PORT + 10 * i + 200) for i, name in enumerate(self.names)}
        self.channel = Channel(snr_db=args.snr, seed=args.seed)
        self.mercuries: dict[str, subprocess.Popen[bytes]] = {}
        self.daemons: dict[str, subprocess.Popen[bytes]] = {}
        self.pages = {name: Page(name) for name in self.names}
        for page in self.pages.values():
            page.on_error = lambda name, error: say(f"{name}'s daemon refused: {json.dumps(error)}")
        self.rows: list[tuple[str, str]] = []
        self.failed: list[str] = []
        self.fifos: dict[str, tuple[str, str]] = {}
        self.channel_started = False

    def start_mercuries(self) -> None:
        for name in self.names:
            rx, tx = fifo(self.folder, f"{name}-rx"), fifo(self.folder, f"{name}-tx")
            self.fifos[name] = (rx, tx)
            self.channel.add(name, rx, tx)
            self.mercuries[name] = start_mercury(self.binary, self.folder, name.lower(), rx, tx, self.ports[name])
        self.channel.start()
        self.channel_started = True

    def restart_mercury(self, name: str) -> None:
        rx, tx = self.fifos[name]
        self.mercuries[name] = start_mercury(self.binary, self.folder, name.lower() + "-again", rx, tx, self.ports[name])

    def start_daemons(self, igate_server: str, fm_port: int = 0) -> dict[str, str]:
        bases: dict[str, str] = {}
        for i, name in enumerate(self.names):
            data = self.folder / name.lower()
            on_fm = i < self.args.fm                      # (the first stations have the FM radio too: the KISS hub is their TNC)
            settings = {"station/call": name, "station/lat": f"{60.0 + 0.1 * i:.2f}", "station/lon": f"{24.0 + 0.1 * i:.2f}", "hf/enabled": "true", "fm/enabled": "true" if on_fm else "false",
                        "beacon/interval_min": "0", "station/comment": f"sim station {i + 1}", "messages/alert": "false", **({"tnc/profile": "kiss-tcp"} if on_fm else {})}
            if i == 0:
                settings.update({"igate/enabled": "true", "igate/server": igate_server, "igate/password": "12345"})
            write_settings(data, settings, self.daemon_command)
            self.daemons[name] = start_daemon(data, self.ports[name], self.daemon_command, fm_port if on_fm else 0)
        for name in self.names:
            bases[name] = wait_for_page(self.daemons[name], self.folder / name.lower(), self.args.timeout)
        return bases

    def row(self, what: str, result: str, ok: bool = True) -> None:
        self.rows.append((what, result + ("" if ok else "   <- not as expected")))
        if not ok:
            self.failed.append(what)

    async def when_free(self, page: Page) -> None:
        """Waits until the station's radio takes a frame now: the daemon refuses `beacon_now` and `send_message` while Mercury keys the radio or hears a signal (the one carrier sense of the plane), as a real operator sees the busy lamp."""
        await page.until("the radio free", page.free, self.args.timeout * 2)

    async def everyone(self, what: str, condition: Any, seconds: float, but: str = "") -> float:
        """Waits for the condition on every station but `but`; the longest it took."""
        took = 0.0
        for name, page in self.pages.items():
            if name != but:
                took = max(took, await page.until(what, functools.partial(condition, page), seconds))
        return took

    async def drive(self, bases: dict[str, str], aprsis: AprsIs, hub: FmHub) -> None:
        timeout = self.args.timeout
        for name, page in self.pages.items():
            await page.open(bases[name])
        took = await self.everyone("the radio connected and Mercury's control port heard", lambda p: p.ready(), timeout)
        self.row(f"{len(self.names)} daemons connected to their Mercury, control ports heard", f"{took:.1f} s")
        # 1. every station's beacon heard by every other: one frame each, in turn, so that nothing collides here
        slowest = 0.0
        for name, page in self.pages.items():
            await self.when_free(page)
            await page.send({"cmd": "beacon_now"})
            slowest = max(slowest, await self.everyone(f"{name}'s beacon", operator.methodcaller("hears", name), timeout, but=name))
        collisions = self.channel.report()["totals"]["collisions"]
        self.row(f"every beacon heard by every other station ({len(self.names) * (len(self.names) - 1)} hearings), slowest", f"{slowest:.1f} s", collisions == 0)
        self.row("collisions while the beacons went one at a time", str(collisions), collisions == 0)
        # 2. a message around the ring: each station to the next, acked
        acked_times: list[float] = []
        for i, name in enumerate(self.names):
            to = self.names[(i + 1) % len(self.names)]
            page = self.pages[name]
            before = page.acked()
            await self.when_free(page)
            await page.send({"cmd": "send_message", "to": to, "text": TEXT})
            acked_times.append(await page.until(f"the ack of {name}'s message to {to}", more_acked(page, before), timeout))
        self.row(f"a message around the ring acked by each of {len(self.names)} ({len(self.names)} frames each way), slowest", f"{max(acked_times):.1f} s")
        # 3. two stations keyed at the same moment: both frames lost (no carrier sense can see a frame that has not started), then a message between them goes through on the retry
        a, b, c = self.names[0], self.names[1], self.names[-1]
        before = self.channel.report()["totals"]["collisions"]
        heard_before = {n: len(p.stations()) for n, p in self.pages.items()}
        await self.when_free(self.pages[a])
        await self.when_free(self.pages[b])
        await asyncio.gather(self.pages[a].send({"cmd": "beacon_now"}), self.pages[b].send({"cmd": "beacon_now"}))
        await self.pages[c].drain(8.0)
        collided = self.channel.report()["totals"]["collisions"] - before
        self.row(f"{a} and {b} keyed at the same moment: blocks in collision", str(collided), collided > 0)
        page = self.pages[a]
        n = page.acked()
        await self.when_free(page)
        await page.send({"cmd": "send_message", "to": b, "text": "after the collision"})
        took = await page.until(f"the ack of {a}'s message to {b} after the collision", lambda: page.acked() > n, timeout * 2)
        attempts = max((int(m.get("attempts") or m.get("attempt") or 1) for m in page.messages().values() if m.get("direction") == "out"), default=1)
        self.row(f"a message {a} -> {b} right after it, acked (attempts of the busiest message: {attempts})", f"{took:.1f} s")
        del heard_before
        # 4. a station whose Mercury dies and comes back: the daemon says so, waits, and is back on the air when Mercury is
        lost = self.names[-1]
        self.mercuries[lost].kill()
        self.mercuries[lost].wait()
        page = self.pages[lost]
        took = await page.until(f"{lost}'s radio noticing its Mercury is gone", lambda: (page.topics.get("tnc") or {}).get("state") != "connected", timeout)
        self.row(f"{lost}'s Mercury killed: its daemon says the radio is gone after", f"{took:.1f} s")
        sender = self.pages[self.names[0]]
        n = sender.acked()
        await self.when_free(sender)
        await sender.send({"cmd": "send_message", "to": lost, "text": "are you there?"})
        await asyncio.sleep(3.0)
        self.restart_mercury(lost)
        took = await page.until(f"{lost}'s radio back on its Mercury", lambda: page.ready(), timeout)
        self.row(f"{lost}'s Mercury started again: its daemon back on the air after", f"{took:.1f} s")
        took = await sender.until(f"the ack of the message sent while {lost} was gone", lambda: sender.acked() > n, timeout * 3)
        self.row(f"the message sent to {lost} while it was gone, acked on a retry after", f"{took:.1f} s")
        # 5. a weak link: the last station hears the first at WEAK_LINK_DB below the others
        self.channel.set_link(self.names[0], lost, gain_db=WEAK_LINK_DB, symmetric=False)
        n = sender.acked()
        started = time.monotonic()
        await self.when_free(sender)
        await sender.send({"cmd": "send_message", "to": lost, "text": "over the weak link"})
        try:
            took = await sender.until("the ack over the weak link", lambda: sender.acked() > n, timeout * 2)
            self.row(f"a message over a link {WEAK_LINK_DB:g} dB down (about {self.args.snr + WEAK_LINK_DB:g} dB SNR), acked after", f"{took:.1f} s")
        except Failure:
            self.row(f"a message over a link {WEAK_LINK_DB:g} dB down (about {self.args.snr + WEAK_LINK_DB:g} dB SNR): not acked within", f"{time.monotonic() - started:.0f} s (reported, not required)")
        self.channel.set_link(self.names[0], lost, gain_db=0.0, symmetric=False)
        # 6. the FM side: a station heard on FM is messaged on FM, one heard on HF alone over HF (the hub is the FM air of the first `--fm` stations)
        if self.args.fm >= 2:
            fm_a, fm_b, hf_only = self.pages[self.names[0]], self.pages[self.names[1]], self.names[-1]
            for page in (fm_a, fm_b):
                await page.send({"cmd": "beacon_now"})                      # (both radios: the other FM station hears it on FM too)
            await fm_a.until(f"{self.names[1]} heard on FM", lambda: (fm_a.stations().get(self.names[1]) or {}).get("heard_fm", 0) > 0, timeout)
            await fm_a.until(f"{hf_only} heard on HF alone", lambda: (fm_a.stations().get(hf_only) or {}).get("heard_hf", 0) > 0, timeout)
            n = fm_a.acked()
            await self.when_free(fm_a)
            await fm_a.send({"cmd": "send_message", "to": self.names[1], "text": "near you on FM"})
            took = await fm_a.until("the ack on FM", lambda: fm_a.acked() > n, timeout)
            self.row(f"a message to {self.names[1]}, heard on both radios, went on FM and was acked after", f"{took:.1f} s", hub.heard(b"near you on FM"))
            await self.when_free(fm_a)
            await fm_a.send({"cmd": "send_message", "to": hf_only, "text": "far from you over HF"})
            took = await fm_a.until("the ack over HF", lambda: fm_a.acked() > n + 1, timeout * 2)
            self.row(f"a message to {hf_only}, heard on HF alone, went over HF (nothing of it on the FM air) and was acked after", f"{took:.1f} s", not hub.heard(b"far from you over HF"))
        # 7. the iGate: the first station gated the others' beacons
        gated = {line.split(">", 1)[0] for line in aprsis.packets}
        others = set(self.names[1:])
        self.row(f"the iGate on {self.names[0]} gated the beacons of", f"{len(gated & others)} of {len(others)} stations", others <= gated)
        for page in self.pages.values():
            page.close()


def table(rows: list[tuple[str, str]]) -> None:
    width = max(len(what) for what, _ in rows)
    print()
    for what, result in rows:
        print(f"  {what.ljust(width)}  {result}")
    print()


def run(args: argparse.Namespace) -> int:
    shipped = find()
    binary = args.mercury or (shipped[0] if shipped else "")
    if not binary:
        raise Failure("no Mercury in this checkout: build it with scripts/build-mercury --install, or give --mercury PATH")
    daemon = shlex.split(args.daemon) if args.daemon else default_daemon()
    folder = Path(tempfile.mkdtemp(prefix="mercury-sim-"))
    net = Net(args, folder, binary, daemon)
    started = time.monotonic()
    try:
        net.start_mercuries()
        say(f"{args.stations} Mercury instances started from {binary}, joined by one channel at {args.snr:g} dB SNR (seed {args.seed})")

        async def whole() -> None:
            aprsis, hub = AprsIs(), FmHub()
            await aprsis.start()
            await hub.start()
            try:
                bases = net.start_daemons(aprsis.address, hub.port)
                say(f"{args.stations} daemons up ({' '.join(daemon)}), the first {args.fm} on the FM hub too: " + ", ".join(f"{n} {b}" for n, b in bases.items()))
                await net.drive(bases, aprsis, hub)
            finally:
                aprsis.close()
                hub.close()

        asyncio.run(whole())
        report = net.channel.report()
        totals = report["totals"]
        net.row("channel blocks / blocks in collision / late blocks", f"{totals['blocks']} / {totals['collisions']} / {totals['late_blocks']}", totals["late_blocks"] == 0)
        for name, counts in report["stations"].items():
            net.row(f"{name}: blocks sent / heard / overlapped / dropped", f"{counts['blocks_sent']} / {counts['blocks_heard']} / {counts['overlapped_blocks']} / {counts['dropped']}")
        codes = {name: stop(d, args.timeout) for name, d in net.daemons.items()}
        net.row("daemons ended with exit code 0", ", ".join(f"{n} {c}" for n, c in codes.items()), all(c == 0 for c in codes.values()))
        table(net.rows)
        if args.report:
            Path(args.report).write_text(json.dumps({"rows": net.rows, "channel": report, "failed": net.failed, "stations": args.stations, "snr_db": args.snr, "seed": args.seed, "seconds": round(time.monotonic() - started, 1)}, indent=1), encoding="utf-8")
        if net.failed:
            raise Failure(f"{len(net.failed)} expectation(s) not met: " + "; ".join(net.failed))
        say(f"every expectation held in {time.monotonic() - started:.0f} s")
        return 0
    finally:
        for process in [*net.daemons.values(), *net.mercuries.values()]:
            stop(process, 5.0)
        if net.channel_started:
            net.channel.stop()
        if args.keep:
            say(f"kept {folder}: a data folder per station (neoaprs.log in each) and the Mercury logs")
        else:
            shutil.rmtree(folder, ignore_errors=True)


def main() -> int:
    parser = argparse.ArgumentParser(description="N real Mercury instances on one simulated HF channel, a NeoAPRS daemon on each, a scenario checked against what the net must do")
    parser.add_argument("--stations", type=int, default=5, metavar="N", help="how many stations; default %(default)s, at least 3")
    parser.add_argument("--snr", type=float, default=30.0, metavar="DB", help="the signal-to-noise ratio in 3 kHz of a station at full gain; default %(default)s")
    parser.add_argument("--seed", type=int, default=1, metavar="S", help="the seed of the channel's noise; default %(default)s")
    parser.add_argument("--fm", type=int, default=2, metavar="N", help="how many of the stations (the first ones) have the FM radio too, on a KISS hub that is their FM air; default %(default)s, 0 for HF alone")
    parser.add_argument("--timeout", type=float, default=60.0, metavar="SEC", help="how long one wait may take; default %(default)s")
    parser.add_argument("--keep", action="store_true", help="keep the folders of the run and say where they are")
    parser.add_argument("--mercury", metavar="PATH", help="the Mercury program (default: the one scripts/build-mercury --install put in the venv)")
    parser.add_argument("--daemon", metavar="CMD", help="the daemon to run (default: this Python's `-m neoaprs`); e.g. /usr/bin/neoaprs after the .deb")
    parser.add_argument("--report", metavar="FILE", help="write the report as JSON here too")
    args = parser.parse_args()
    if sys.platform == "win32":
        print("sim: named pipes of this kind are Linux's; run it there", file=sys.stderr)
        return 2
    if args.stations < 3:
        print("sim: at least 3 stations (a third hears the two that collide)", file=sys.stderr)
        return 2
    args.fm = max(0, min(args.fm, args.stations - 1))                 # (the last station is the one heard on HF alone)
    try:
        return run(args)
    except Failure as e:
        print(f"sim: FAILED: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    os.environ.setdefault("PYTHONUNBUFFERED", "1")
    sys.exit(main())

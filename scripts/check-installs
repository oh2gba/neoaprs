#!/usr/bin/env python3
"""Try the clean installs of a release in Docker before a tag.

The wheel, the .deb (clean Debian and Ubuntu), the AppImage, and an upgrade from the last release
to this build, each in a container with nothing of NeoAPRS.

  scripts/check-installs                        every check below, one line each with its time; the
                                                output of a check that failed follows its line
  scripts/check-installs --only deb-debian      only the checks named (wheel, deb-debian,
                                                deb-ubuntu, appimage, upgrade; several may be given)
  scripts/check-installs --no-mercury           the packages are built without Mercury (the .deb and
                                                the AppImage are the file of a developer who has
                                                none): faster, and the Mercury checks are not made
  scripts/check-installs --work FOLDER          where the files are built and the logs are kept
                                                (default build/installs)
  scripts/check-installs --update-from SOURCE   the upgrade alone, from SOURCE instead of the pinned
                                                release: a .deb file, or a commit of this repository
                                                (a hash, a tag, a branch), whose .deb is built here
                                                without Mercury from `git archive` of it (kept in
                                                the work folder for the next run); with --only, the
                                                upgrade must be among the checks
  scripts/check-installs --pin VERSION          writes packaging/ci/old-release.json for that
                                                release: its .deb is fetched from the project's
                                                release page and its SHA-256 is written once it
                                                equals the one in the
                                                release's SHA256SUMS (needs the network; run it
                                                after a release, so that the upgrade starts from the
                                                newest one)

The files come from the build scripts the release workflow runs, on this tree. `--only appimage-web`
runs the trial AppImage of the web window in each container of WEB_CASES.

Exit code 0 when every check passed, 1 when one failed or could not run, 2 when docker or uv is
missing or does not answer, or an argument is wrong. Needs Linux, docker, uv, curl, dpkg-deb, and
for Mercury gcc, make and libasound2-dev.
"""
import argparse
import hashlib
import json
import os
import shlex
import re
import shutil
import subprocess
import sys
import tarfile
import time
import urllib.request
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CONTAINER = ROOT / "scripts" / "check-in-container"
PIN = ROOT / "packaging" / "ci" / "old-release.json"
CHECKS = ("wheel", "deb-debian", "deb-ubuntu", "appimage", "upgrade")
TRIAL_CHECKS = ("appimage-web",)                                          # run only when named with --only
# Ubuntu by its index digest; tag and digest move together.
DEBIAN, UBUNTU = "debian:bookworm-slim", "ubuntu:24.04@sha256:2198e4c65076e9cb0b3d695219df667c0e3b0072da64ca3c2648aca17dcecaf5"
# The address neoaprs/updateasset.py uses.
RELEASES = "https://github.com/oh2gba/neoaprs/releases/download"
MAX_DOWNLOAD = 200_000_000
# A container starts a line with this for a part of its check that cannot be tried on this system.
SKIPPED = "SKIPPED: "
# Lines of the log of a failed check shown in the report.
TAIL_LINES = 40
ENVIRONMENT = ("--env", "NEOAPRS_UPDATE_CHECK=0", "--env", "NEOAPRS_NO_DEVICES=1")
FIXTURE = Path("tests") / "fixtures" / "kiss" / "thd7-2026-10-21.bin"
# What the containers run, in the folder `probe`.
PROBE_FILES = (Path("scripts") / "smoke.py", Path("scripts") / "install-probe.py", Path("scripts") / "smoke-appimage", Path("neoaprs") / "mercury.py", FIXTURE)
WEB_PROBE_FILES = (Path("scripts") / "smoke-appimage-web", Path("scripts") / "webkit-probe.py")

# What runs inside a container: the built files are mounted read-only at /work, and VERSION,
# MERCURY_VERSION and the like arrive as variables.
WHEEL = """set -eu
venv="$(mktemp -d)/venv"
uv venv --python 3.13 "$venv"
uv pip install --python "$venv/bin/python" /work/dist/*.whl
"$venv/bin/python" /work/probe/scripts/smoke.py --command "$venv/bin/neoaprs"
"""

APPIMAGE = """set -eu
venv="$(mktemp -d)/venv"
uv venv --python 3.13 "$venv"
uv pip install --python "$venv/bin/python" /work/dist/*.whl
/work/probe/scripts/smoke-appimage /work/dist-appimage/NeoAPRS-*.AppImage --python "$venv/bin/python" $SMOKE_APPIMAGE_ARGS
"""

# The web-window trial: what a desktop has (GTK 3, an X server, a session bus, Mesa) plus the
# case's WebKitGTK. {install} is the system's installer, {packages} the case's.
APT = "export DEBIAN_FRONTEND=noninteractive; apt-get update -qq && apt-get install -y -qq --no-install-recommends xvfb xauth dbus curl ca-certificates gir1.2-gtk-3.0 libgirepository-1.0-1 {packages} > /dev/null"
DNF = "dnf install -y -q xorg-x11-server-Xvfb dbus-daemon dbus-tools curl gtk3 gobject-introspection {packages} > /dev/null"
WEB_GL = {"apt": "libgl1-mesa-dri", "dnf": "mesa-dri-drivers"}
# Image, installer, WebKitGTK packages, expected outcome.
WEB_CASES = (
    ("debian:bookworm", "apt", "libwebkit2gtk-4.1-0", "window"), ("debian:trixie", "apt", "libwebkit2gtk-4.1-0", "window"),
    ("ubuntu:22.04", "apt", "libwebkit2gtk-4.1-0", "window"), ("ubuntu:24.04", "apt", "libwebkit2gtk-4.1-0", "window"), ("ubuntu:26.04", "apt", "libwebkit2gtk-4.1-0", "window"),
    ("fedora:latest", "dnf", "webkit2gtk4.1", "window"),
    # The 4.0 API only, as Ubuntu 22.04's desktop has it.
    ("ubuntu:22.04", "apt", "libwebkit2gtk-4.0-37 gir1.2-webkit2-4.0", "window"),
    ("debian:bookworm", "apt", "", "tray"), ("debian:trixie", "apt", "", "tray"), ("ubuntu:22.04", "apt", "", "tray"), ("ubuntu:24.04", "apt", "", "tray"), ("ubuntu:26.04", "apt", "", "tray"),
    ("fedora:latest", "dnf", "", "tray"),
)
WEB = """set -eu
{install}
bash /work/probe/scripts/smoke-appimage-web /work/dist-appimage-web/NeoAPRS-*-web-x86_64.AppImage --expect {expect}{probe}
"""


def web_script(installer: str, packages: str, expect: str) -> str:
    """Return the script of one trial case: install the packages, then run the smoke test."""
    wanted = " ".join(filter(None, [packages, WEB_GL[installer] if expect == "window" else ""]))
    return WEB.format(install=(APT if installer == "apt" else DNF).format(packages=wanted), expect=expect, probe=" --probe" if expect == "window" else "")


# The .deb as the release workflow's job `deb` checks it: install, command and Python, the daemon
# against a fake TNC, Mercury and its libraries, a service install, a reinstall, and removal.
DEB = """set -eu
apt-get update -qq
apt-get install -y -qq /work/dist-deb/neoaprs_${VERSION}_amd64.deb
[ "$(neoaprs --version)" = "NeoAPRS $VERSION" ]
[ "$(readlink -f /usr/bin/neoaprs)" = /opt/neoaprs/bin/neoaprs ]
[ -f /usr/share/doc/neoaprs/copyright ]
/opt/neoaprs/bin/python3 -I -c 'import sys; assert sys.version_info[:2] == (3, 13), sys.version'
/opt/neoaprs/bin/python3 -I - amd64 <<'PY'
import sys
from pathlib import Path
from neoaprs.cli.installkind import detect_here
info = detect_here(Path("/nonexistent"))
assert (info.kind, info.arch) == ("deb", sys.argv[1]), info
PY
/opt/neoaprs/bin/python3 -I /work/probe/scripts/smoke.py --command /usr/bin/neoaprs
if [ -n "${MERCURY_VERSION:-}" ]; then
    # (a `!` does not stop a script under set -e: the checks are ifs)
    if dpkg -s libasound2 > /dev/null 2>&1 || dpkg -s libasound2t64 > /dev/null 2>&1; then echo "the ALSA library is installed here: the proof proves nothing"; exit 1; fi
    bundled=/opt/neoaprs/tools/mercury
    ldd "$bundled/mercury" 2>&1 | tee /tmp/ldd.txt
    fits=yes
    if grep -q 'not found' /tmp/ldd.txt; then
        # (a library that is missing fails; a glibc older than the one the modem was linked against, which the modem built on this machine meets, is a part that cannot be tried here)
        if grep 'not found' /tmp/ldd.txt | grep -qv 'version `GLIBC'; then echo "a library of mercury is missing"; exit 1; fi
        fits=no
        echo "SKIPPED: Mercury was not run: the one built here needs $(grep -o 'GLIBC_[0-9.]*' /tmp/ldd.txt | sort -uV | tail -n 1), newer than this system has; the release workflow's job deb proves it"
    fi
    if [ "$fits" = yes ]; then
        grep -q "$bundled/lib/libasound.so.2" /tmp/ldd.txt
        export ALSA_CONFIG_PATH="$bundled/share/alsa/alsa.conf"
        said="$("$bundled/mercury" -V 2>&1 || true)"
        echo "mercury -V: $said"
        echo "$said" | grep -qF "$MERCURY_VERSION"
        status=0
        "$bundled/mercury" -z > /tmp/z.txt 2>&1 || status=$?
        cat /tmp/z.txt
        if [ "$status" -ge 126 ] || grep -q 'error while loading' /tmp/z.txt; then echo "mercury -z did not run (exit $status)"; exit 1; fi
    fi
    [ -f "$bundled/LICENSE" ] && [ ! -e "$bundled/dev" ]
fi
mkdir -p /tmp/home /tmp/fakebin
printf '#!/bin/sh\\nexit 0\\n' > /tmp/fakebin/systemctl
cp /tmp/fakebin/systemctl /tmp/fakebin/loginctl
chmod +x /tmp/fakebin/systemctl /tmp/fakebin/loginctl
HOME=/tmp/home XDG_CONFIG_HOME=/tmp/home/.config PATH="/tmp/fakebin:$PATH" neoaprs service install --data /tmp/servicedata
grep -n '^ExecStart=/opt/neoaprs/bin/python3 -m neoaprs ' /tmp/home/.config/systemd/user/neoaprs.service
mkdir -p /tmp/keep
echo data > /tmp/keep/neoaprs.sqlite
apt-get install -y --reinstall /work/dist-deb/neoaprs_${VERSION}_amd64.deb 2>&1 | tee /tmp/upgrade.log
grep -q 'keeps the old version until it is restarted' /tmp/upgrade.log
neoaprs --version
apt-get remove -y neoaprs
if [ -e /opt/neoaprs ] || [ -e /usr/bin/neoaprs ] || dpkg -s neoaprs 2>/dev/null | grep -q 'Status: install ok installed'; then echo "the package is not gone"; exit 1; fi
[ "$(cat /tmp/keep/neoaprs.sqlite)" = data ]
"""

# What the upgraded database must be once this build's daemon has run on it (argv: file, old
# version, this version): this version, with the FM radio and the Dummy HF radio enabled.
DATABASE_CHECK = """import sqlite3, sys
path, before, wanted = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
version = db.execute("PRAGMA user_version").fetchone()[0]
if version != wanted:
    sys.exit(f"the database is of version {version}, not this build's {wanted}: the new daemon did not bring it up to date")
radios = sorted(db.execute("SELECT kind, type FROM radio WHERE enabled = 1 AND removed_at IS NULL"))
if "fm" not in {kind for kind, _ in radios} or ("hf", "dummy-hf") not in radios:
    sys.exit(f"the radios of the old daemon are not both there, enabled: {radios}")
print(f"the database went from version {before} to {version}, with the radios {', '.join(kind + ' ' + type for kind, type in radios)}")
"""

# The upgrade: install the old build, seed its daemon (scripts/install-probe.py), install this
# build over it, and verify. OLD_VERSION is empty for a .deb of --update-from.
UPGRADE = """set -eu
apt-get update -qq
apt-get install -y -qq "/old/$OLD_FILE"
[ -n "$OLD_VERSION" ] || OLD_VERSION="$(dpkg-deb -f "/old/$OLD_FILE" Version | tr '~' '-')"
[ "$(neoaprs --version)" = "NeoAPRS $OLD_VERSION" ]
mkdir -p /tmp/upgrade
/opt/neoaprs/bin/python3 -I /work/probe/scripts/install-probe.py seed --command /usr/bin/neoaprs --data /tmp/upgrade/data --out /tmp/upgrade/seen.json
before="$(/opt/neoaprs/bin/python3 -I -c 'import sqlite3, sys; print(sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True).execute("PRAGMA user_version").fetchone()[0])' /tmp/upgrade/data/neoaprs.sqlite)"
again=""
[ "$OLD_VERSION" != "$VERSION" ] || again=--reinstall
apt-get install -y -qq $again /work/dist-deb/neoaprs_${VERSION}_amd64.deb
[ "$(neoaprs --version)" = "NeoAPRS $VERSION" ]
dpkg-deb -e /work/dist-deb/neoaprs_${VERSION}_amd64.deb /tmp/upgrade/control
(cd / && grep -v '  usr/share/doc/' /tmp/upgrade/control/md5sums | md5sum --quiet -c -)          # (but the documents: the Docker images' dpkg leaves /usr/share/doc out, the copyright file aside)
echo "every file of this build is the one installed (its documents aside: the image keeps none)"
/opt/neoaprs/bin/python3 -I /work/probe/scripts/install-probe.py verify --command /usr/bin/neoaprs --data /tmp/upgrade/data --in /tmp/upgrade/seen.json --version "$VERSION"
/opt/neoaprs/bin/python3 -I - /tmp/upgrade/data/neoaprs.sqlite "$before" "$NEW_SCHEMA" <<'PY'
""" + DATABASE_CHECK + """PY
"""


def say(text: str) -> None:
    print(f"check-installs: {text}", file=sys.stderr, flush=True)


def tree_value(path: str, name: str) -> str:
    """Return a pin of the tree as text, e.g. `VERSION` of neoaprs/__init__.py."""
    for line in (ROOT / path).read_text(encoding="utf-8").splitlines():
        if line.startswith(f"{name} = "):
            return line.split('"')[1]
    raise SystemExit(f"check-installs: {path} has no {name}")


def tree_schema() -> int:
    """Return the database version this tree reaches: the steps in MIGRATIONS, read as text."""
    for line in (ROOT / "neoaprs" / "migrations.py").read_text(encoding="utf-8").splitlines():
        if line.startswith("MIGRATIONS:"):
            return len(re.findall(r"\b_v\d+\b", line.split("=", 1)[1]))
    raise SystemExit("check-installs: neoaprs/migrations.py has no MIGRATIONS")


# ---- the old release ----

class NotPinned(Exception):
    """The reason, in words for the user, why the old release cannot be used."""


def load_pin(pin: Path = PIN) -> dict[str, str]:
    try:
        data = json.loads(pin.read_text(encoding="utf-8"))
        version, url, digest = data["version"], data["amd64"]["url"], data["amd64"]["sha256"]
    except (OSError, ValueError, KeyError, TypeError) as error:
        raise NotPinned(f"{pin.relative_to(ROOT) if pin.is_relative_to(ROOT) else pin} cannot be read ({error}): scripts/check-installs --pin VERSION writes it") from None
    if len(digest) != 64 or any(each not in "0123456789abcdef" for each in digest):
        raise NotPinned(f"the old release {version} is not pinned by its SHA-256 yet: scripts/check-installs --pin {version} (needs the network) writes the pin")
    return {"version": version, "url": url, "sha256": digest, "file": Path(url).name}


def cache_folder() -> Path:
    return Path(os.environ.get("NEOAPRS_BUILD_CACHE") or Path.home() / ".cache" / "neoaprs-build") / "old-releases"


def download(url: str, target: Path) -> str:
    """Fetch `url` into `target` (https, at most MAX_DOWNLOAD bytes); return its SHA-256."""
    if not url.startswith("https://"):
        raise NotPinned(f"{url} is not an https address")
    digest, size = hashlib.sha256(), 0
    target.parent.mkdir(parents=True, exist_ok=True)
    partial = target.with_name(target.name + ".part")
    with urllib.request.urlopen(url, timeout=120) as answer, partial.open("wb") as out:       # noqa: S310  (https only, checked above)
        while chunk := answer.read(1 << 20):
            size += len(chunk)
            if size > MAX_DOWNLOAD:
                raise NotPinned(f"{url} is over {MAX_DOWNLOAD} bytes")
            digest.update(chunk)
            out.write(chunk)
    partial.replace(target)
    return digest.hexdigest()


def old_release(pin: dict[str, str]) -> Path:
    """Return the old .deb from the build cache, fetching it; it must match the pinned digest."""
    target = cache_folder() / pin["file"]
    if target.is_file() and hashlib.sha256(target.read_bytes()).hexdigest() == pin["sha256"]:
        return target
    say(f"fetching {pin['url']}")
    try:
        found = download(pin["url"], target)
    except OSError as error:
        raise NotPinned(f"{pin['url']} could not be fetched ({error})") from None
    if found != pin["sha256"]:
        target.unlink(missing_ok=True)
        raise NotPinned(f"{pin['file']} has the SHA-256 {found}, not the {pin['sha256']} that is pinned: the file was thrown away")
    return target


def write_pin(version: str) -> int:
    """Fetch a release's .deb and SHA256SUMS and pin the file once the digests agree."""
    name = f"neoaprs_{version}_amd64.deb"
    url = f"{RELEASES}/v{version}/{name}"
    try:
        found = download(url, cache_folder() / name)
        sums = cache_folder() / f"SHA256SUMS-{version}"
        download(f"{RELEASES}/v{version}/SHA256SUMS", sums)
    except (OSError, NotPinned) as error:
        say(f"nothing was pinned: {error}")
        return 1
    listed = {parts[1].lstrip("*"): parts[0] for line in sums.read_text(encoding="utf-8").splitlines() if len(parts := line.split()) == 2}
    if listed.get(name) != found:
        say(f"nothing was pinned: {name} has the SHA-256 {found}, the release's SHA256SUMS says {listed.get(name)}")
        return 1
    PIN.write_text(json.dumps({"version": version, "amd64": {"url": url, "sha256": found}}, indent=2) + "\n", encoding="utf-8")
    say(f"{PIN.relative_to(ROOT)} pins {name} at {found}")
    return 0


def old_build(source: str, work: Path) -> Path:
    """Return the .deb for --update-from: the file named, or one built from a commit's `git
    archive`."""
    if source.endswith(".deb"):
        file = Path(source).expanduser().resolve()
        if not file.is_file():
            raise NotPinned(f"--update-from {source}: there is no such file")
        return file
    found = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--verify", "--quiet", f"{source}^{{commit}}"], capture_output=True, text=True, check=False)
    if found.returncode != 0 or not found.stdout.strip():
        raise NotPinned(f"--update-from {source}: neither a .deb file nor a commit of this repository")
    commit = found.stdout.strip()
    folder = work / "update-from" / commit[:12]
    if debs := sorted((folder / "dist-deb").glob("neoaprs_*_amd64.deb")):
        return debs[-1]
    shutil.rmtree(folder, ignore_errors=True)
    tree = folder / "tree"
    tree.mkdir(parents=True)
    say(f"the tree of {commit[:12]} from git archive")
    with subprocess.Popen(["git", "-C", str(ROOT), "archive", "--format=tar", commit], stdout=subprocess.PIPE) as archive:
        assert archive.stdout is not None
        with tarfile.open(fileobj=archive.stdout, mode="r|") as tar:
            tar.extractall(tree, filter="data")
    if archive.returncode != 0:
        raise NotPinned(f"git archive of {commit[:12]} failed (exit {archive.returncode})")
    for name, command in (("update-from-wheel", ["uv", "build", "--wheel", "--out-dir", str(folder / "dist")]), ("update-from-deb", None)):
        if command is None:
            wheel = str(next(iter(sorted((folder / "dist").glob("neoaprs-*.whl"))), ""))
            command = ["scripts/build-deb", "--arch", "amd64", "--wheel", wheel, "--no-mercury", "--out", str(folder / "dist-deb")]
        if (reason := build_step(work, name, command, cwd=tree)) is not None:
            raise NotPinned(reason)
    if debs := sorted((folder / "dist-deb").glob("neoaprs_*_amd64.deb")):
        return debs[-1]
    raise NotPinned(f"the build of {commit[:12]} made no .deb in {folder / 'dist-deb'}")


# ---- the files that are tried ----

@dataclass
class Built:
    """What the build gave: the work folder, and why each file that failed could not be made."""
    work: Path
    failed: dict[str, str]


def build_step(work: Path, name: str, command: Sequence[str], cwd: Path = ROOT) -> str | None:
    """Run one build command with its output in the log of `name`; return None or why it failed."""
    log = work / "logs" / f"build-{name}.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    say(f"building {name}: {shlex.join(command)}")
    with log.open("wb") as out:
        done = subprocess.run(command, cwd=cwd, stdout=out, stderr=subprocess.STDOUT, check=False)
    return None if done.returncode == 0 else f"the build of {name} failed (exit {done.returncode}); its log is {log}"


def build(work: Path, wanted: set[str], with_mercury: bool) -> Built:
    """Build the wheel, Mercury, the .deb and the AppImage the checks need, each folder anew.

    `failed` names what could not be built; a file needing a failed one gets that reason."""
    built = Built(work, {})
    folders = {name: work / name for name in ("dist", "mercury", "dist-deb", "dist-appimage", "dist-gi", "dist-appimage-web")}
    deb, appimage = bool(wanted & {"deb-debian", "deb-ubuntu", "upgrade"}), "appimage" in wanted
    for folder in folders.values():
        shutil.rmtree(folder, ignore_errors=True)

    def attempt(name: str, command: list[str]) -> bool:
        reason = build_step(work, name, command)
        if reason is not None:
            built.failed[name] = reason
        return reason is None

    if not attempt("wheel", ["uv", "build", "--wheel", "--out-dir", str(folders["dist"])]):
        built.failed.update({"deb": built.failed["wheel"], "appimage": built.failed["wheel"], "appimage-web": built.failed["wheel"]})
        return built
    wheel = str(next(iter(sorted(folders["dist"].glob("neoaprs-*.whl"))), ""))
    mercury = ["--no-mercury"]
    if with_mercury and (deb or appimage):
        if attempt("mercury", ["scripts/build-mercury", "--tar", "--out", str(folders["mercury"])]):
            tars = sorted(folders["mercury"].glob("mercury-*-linux-x86_64.tar.gz"))
            mercury = ["--mercury", str(tars[-1])] if tars else mercury
            if not tars:
                built.failed["mercury"] = "scripts/build-mercury made no mercury-*-linux-x86_64.tar.gz"
        if "mercury" in built.failed:
            built.failed.update({"deb": built.failed["mercury"], "appimage": built.failed["mercury"], "appimage-web": built.failed["mercury"]})
            return built
    if deb:
        attempt("deb", ["scripts/build-deb", "--arch", "amd64", "--wheel", wheel, *mercury, "--out", str(folders["dist-deb"]), "--no-direwolf"])
    if appimage:
        attempt("appimage", ["scripts/build-appimage", "--wheel", wheel, *mercury, "--out", str(folders["dist-appimage"]), "--no-direwolf"])
    if "appimage-web" in wanted:
        if attempt("gi", ["scripts/build-gi", "--docker", "--out", str(folders["dist-gi"])]):
            tars = sorted(folders["dist-gi"].glob("gi-*-linux-x86_64.tar.gz"))
            if tars:
                attempt("appimage-web", ["scripts/build-appimage", "--wheel", wheel, "--no-mercury", "--no-direwolf", "--window", "web", "--gi", str(tars[-1]), "--out", str(folders["dist-appimage-web"])])
            else:
                built.failed["appimage-web"] = "scripts/build-gi made no gi-*-linux-x86_64.tar.gz"
        else:
            built.failed["appimage-web"] = built.failed["gi"]
    return built


def make_probe(work: Path, web: bool = False) -> None:
    """Copy the scripts the containers run into `probe`, keeping the tree layout smoke.py
    expects."""
    shutil.rmtree(work / "probe", ignore_errors=True)
    for name in (*PROBE_FILES, *(WEB_PROBE_FILES if web else ())):
        (work / "probe" / name).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(ROOT / name, work / "probe" / name)


# ---- the containers ----

def docker_run(image: str, script: str, work: Path, mounts: Sequence[tuple[Path, str]] = (), environment: Sequence[tuple[str, str]] = (), shm: bool = False) -> list[str]:
    """Return the `docker run` command: read-only mounts, no port, no device, `script` run by sh."""
    line = ["docker", "run", "--rm", "--init", *ENVIRONMENT, "--volume", f"{work}:/work:ro"]
    for folder, target in mounts:
        line += ["--volume", f"{folder}:{target}:ro"]
    for name, value in environment:
        line += ["--env", f"{name}={value}"]
    if shm:
        line += ["--shm-size", "1g", "--env", "QTWEBENGINE_CHROMIUM_FLAGS=--no-sandbox --disable-gpu"]
    return [*line, image, "sh", "-c", script]


def runner_image() -> str:
    """Return the image of scripts/check-in-container, building it if missing."""
    done = subprocess.run([sys.executable, str(CONTAINER), "--image-only"], capture_output=True, text=True, check=False)
    if done.returncode != 0:
        raise NotPinned(f"the image of scripts/check-in-container could not be made: {done.stderr.strip().splitlines()[-1:] or ['no message']}")
    return done.stdout.strip()


def command_of(name: str, work: Path, with_mercury: bool, update_from: str | None = None) -> list[str]:
    """Return the docker command of the check `name`; NotPinned if its starting point is missing."""
    version, mercury = tree_value("neoaprs/__init__.py", "VERSION"), tree_value("neoaprs/mercury.py", "VERSION")
    deb_environment = [("VERSION", version), ("MERCURY_VERSION", mercury if with_mercury else "")]
    if name == "wheel":
        return docker_run(runner_image(), WHEEL, work)
    if name == "appimage":
        return docker_run(runner_image(), APPIMAGE, work, environment=[("SMOKE_APPIMAGE_ARGS", "--no-direwolf" if with_mercury else "--no-mercury --no-direwolf")], shm=True)
    if name == "deb-debian":
        return docker_run(DEBIAN, DEB, work, environment=deb_environment)
    if name == "deb-ubuntu":
        return docker_run(UBUNTU, DEB, work, environment=deb_environment)
    if update_from is not None:
        old, old_version = old_build(update_from, work), ""
    else:
        pin = load_pin()
        old, old_version = old_release(pin), pin["version"]
    return docker_run(UBUNTU, UPGRADE, work, mounts=[(old.parent, "/old")], environment=[("OLD_FILE", old.name), ("OLD_VERSION", old_version), ("VERSION", version), ("NEW_SCHEMA", str(tree_schema()))])


@dataclass
class Result:
    name: str
    ok: bool
    seconds: float
    output: str
    # The part of a passed check that could not be tried here.
    skipped: str = ""


def run_web(work: Path, built: Built) -> Result:
    """Run each case of WEB_CASES in its own container, keeping each log."""
    started = time.monotonic()
    if "appimage-web" in built.failed:
        return Result("appimage-web", False, 0.0, built.failed["appimage-web"])
    lines: list[str] = []
    ok = True
    for number, (image, installer, packages, expect) in enumerate(WEB_CASES, 1):
        log = work / "logs" / f"appimage-web-{number:02d}.log"
        with log.open("wb") as out:
            done = subprocess.run(docker_run(image, web_script(installer, packages, expect), work), stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, check=False)
        said = log.read_text(encoding="utf-8", errors="replace").splitlines()
        lines.append(f"{'ok  ' if done.returncode == 0 else 'FAIL'} {image} {packages or 'no WebKitGTK'}: the {expect} ({log.name})")
        lines.extend(f"    {line}" for line in said if line.startswith("{") or done.returncode != 0 and line in said[-TAIL_LINES:])
        ok = ok and done.returncode == 0
    return Result("appimage-web", ok, time.monotonic() - started, "\n".join(lines))


def run_check(name: str, work: Path, built: Built, with_mercury: bool, update_from: str | None = None) -> Result:
    if name == "appimage-web":
        return run_web(work, built)
    started = time.monotonic()
    need = {"wheel": "wheel", "appimage": "appimage"}.get(name, "deb")
    if need in built.failed:
        return Result(name, False, 0.0, built.failed[need])
    try:
        command = command_of(name, work, with_mercury, update_from)
    except NotPinned as error:
        return Result(name, False, time.monotonic() - started, str(error))
    log = work / "logs" / f"{name}.log"
    with log.open("wb") as out:
        done = subprocess.run(command, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, check=False)
    lines = log.read_text(encoding="utf-8", errors="replace").splitlines()
    skipped = next((line[len(SKIPPED):] for line in lines if line.startswith(SKIPPED)), "") if done.returncode == 0 else ""
    return Result(name, done.returncode == 0, time.monotonic() - started, "\n".join(lines[-TAIL_LINES:]) if done.returncode else "", skipped)


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="check-installs", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--only", action="append", choices=CHECKS + TRIAL_CHECKS, help="one check (may be given several times); appimage-web only when named")
    parser.add_argument("--no-mercury", action="store_true", help="build the packages without Mercury")
    parser.add_argument("--work", type=Path, default=ROOT / "build" / "installs", help="the folder of the built files and the logs")
    parser.add_argument("--pin", metavar="VERSION", help="write packaging/ci/old-release.json for that release")
    parser.add_argument("--update-from", metavar="SOURCE", help="the upgrade from a .deb file or a commit of this repository instead of the pinned release")
    args = parser.parse_args(argv)
    if args.update_from is not None and args.only and "upgrade" not in args.only:
        parser.error("--update-from is where the upgrade starts: add --only upgrade, or leave --only out")
    if args.pin is not None:
        return write_pin(args.pin)
    for tool in ("docker", "uv"):
        if shutil.which(tool) is None:
            say(f"{tool} is not installed")
            return 2
    if subprocess.run(["docker", "info"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode != 0:
        say("docker does not answer (is the daemon running, and may this user use it?): nothing was built")
        return 2
    wanted = set(args.only or (["upgrade"] if args.update_from is not None else CHECKS))
    work = args.work.resolve()
    (work / "logs").mkdir(parents=True, exist_ok=True)
    built = build(work, wanted, not args.no_mercury)
    make_probe(work, "appimage-web" in wanted)
    results = [run_check(name, work, built, not args.no_mercury, args.update_from) for name in CHECKS + TRIAL_CHECKS if name in wanted]
    for result in results:
        print(f"{'ok  ' if result.ok else 'FAIL'}  {result.name:<11} {result.seconds:6.1f}s")
        if result.skipped:
            print(f"      | skipped: {result.skipped}")
        if not result.ok or result.name in TRIAL_CHECKS:
            print("\n".join(f"      | {line}" for line in result.output.splitlines()))
    failed = [result.name for result in results if not result.ok]
    partly = [result.name for result in results if result.skipped]
    print(f"failed: {' '.join(failed)}" if failed else "all green" + (f", but a part of {' '.join(partly)} was skipped" if partly else ""))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())

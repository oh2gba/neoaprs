#!/usr/bin/env python3
"""Start this checkout's daemon on a data folder for trying the page, with no devices.

It opens no serial port, Bluetooth device or sound card and connects to nothing but this computer
(neoaprs/nodevices.py); the Dummy radios, loopback and page stay.

  scripts/demo-daemon --data DIR [--web-port PORT] [--traffic] [--satellites] [--any-port]
--traffic runs scripts/demotraffic.py as the layers' services, --satellites writes made-up satellites
into the folder, --any-port takes ports the system hands out. Ctrl+C or a TERM stops both."""

import argparse
import os
import re
import signal
import subprocess
import sys
from collections.abc import Callable, Mapping
from datetime import UTC, datetime
from typing import Any
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from neoaprs.paths import default_data_dir  # noqa: E402

sys.path.insert(0, str(ROOT / "scripts"))
import demosatellites  # noqa: E402

WEB_PORT = 7390
# Makes the radio search find no serial device.
NO_PORT = "/nonexistent/neoaprs-demo-no-such-port*"
TRAFFIC = ROOT / "scripts" / "demotraffic.py"
# Where demotraffic.py says it listens.
LISTENING = re.compile(r"listening on (127\.0\.0\.1:\d+)")


def environment(base: Mapping[str, str]) -> dict[str, str]:
    """Return the caller's environment without NEOAPRS_ variables, plus the demo switches."""
    env = {key: value for key, value in base.items() if not key.startswith("NEOAPRS_")}
    env["NEOAPRS_NO_DEVICES"] = "1"
    env["NEOAPRS_UPDATE_CHECK"] = "0"  # (and with no NEOAPRS_PSKREPORTER nothing goes to PSK Reporter)
    env["NEOAPRS_SERIAL_PATTERN"] = NO_PORT
    return env


def operators_folder(data: Path, own: Path) -> str:
    """Return why `data` is the operator's own data folder, or ""."""
    folder = data.expanduser().resolve()
    if folder == own.expanduser().resolve():
        return f"{folder} is the data folder of NeoAPRS on this computer"
    if folder.name == "data" and (folder.parent / "pyproject.toml").is_file() and (folder.parent / "neoaprs").is_dir():
        return f"{folder} is the data folder of the checkout {folder.parent}"
    return ""


def python() -> str:
    """The checkout's own Python (its .venv), else the one that runs this script."""
    for candidate in (ROOT / ".venv" / "bin" / "python", ROOT / ".venv" / "Scripts" / "python.exe"):
        if candidate.is_file():
            return str(candidate)
    return sys.executable


def own_data_folder() -> Path:
    """Return the system's data folder of NeoAPRS, ignoring NEOAPRS_DATA_DIR."""
    saved = os.environ.pop("NEOAPRS_DATA_DIR", None)
    try:
        return default_data_dir()
    finally:
        if saved is not None:
            os.environ["NEOAPRS_DATA_DIR"] = saved


def start_traffic(start: Callable[..., Any], any_port: bool = False) -> tuple[Any, str]:
    """Start demotraffic.py and wait for its first line; return it and its address, (None, "") if it ended."""
    ports = ["--port", "0", "--ais-port", "0"] if any_port else []
    process = start([python(), str(TRAFFIC), *ports], cwd=ROOT, stdout=subprocess.PIPE, text=True)
    found = LISTENING.search(process.stdout.readline()) if process.stdout is not None else None
    if found is None:
        process.wait()
        return None, ""
    return process, f"http://{found.group(1)}"


def run_daemon(command: list[str], cwd: Path, env: dict[str, str]) -> int:
    """Run the daemon to its end; a TERM to this script is passed on to it, so that it stops as it should."""
    process = subprocess.Popen(command, cwd=cwd, env=env)
    previous = signal.signal(signal.SIGTERM, lambda *_: process.terminate())
    try:
        return process.wait()
    except KeyboardInterrupt:
        process.wait()  # (Ctrl+C reached the daemon too)
        raise
    finally:
        signal.signal(signal.SIGTERM, previous)


def main(
    argv: list[str] | None = None,
    run: Callable[..., int] = run_daemon,
    start: Callable[..., Any] = subprocess.Popen,
) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--data", required=True, type=Path, help="the data folder (never the operator's own)")
    parser.add_argument("--web-port", type=int, default=WEB_PORT, help=f"the page's port (default {WEB_PORT})")
    parser.add_argument(
        "--traffic", action="store_true", help="made-up aircraft for the map's layers (scripts/demotraffic.py)"
    )
    parser.add_argument(
        "--satellites", action="store_true", help="made-up satellites for the map (scripts/demosatellites.py)"
    )
    parser.add_argument(
        "--any-port", action="store_true", help="the page and the traffic on ports the system hands out"
    )
    args = parser.parse_args(argv)
    why = operators_folder(args.data, own_data_folder())
    if why:
        print(f"demo-daemon: refused: {why}; give a folder of its own (for example work/demo)", file=sys.stderr)
        return 2
    command = [
        python(),
        "-m",
        "neoaprs",
        "--data",
        str(args.data.expanduser().resolve()),
        "--web-port",
        str(0 if args.any_port else args.web_port),
    ]
    env = environment(os.environ)
    traffic = None
    if args.traffic:
        traffic, address = start_traffic(start, args.any_port)
        if traffic is None:
            print(
                "demo-daemon: refused: the made-up traffic could not be started (its line above says why)",
                file=sys.stderr,
            )
            return 2
        env["NEOAPRS_LAYERS_URL"] = address
    if args.satellites:
        args.data.mkdir(parents=True, exist_ok=True)
        demosatellites.put(args.data.expanduser(), datetime.now(UTC))
    print("demo-daemon: " + " ".join(command), file=sys.stderr)
    try:
        return run(command, cwd=ROOT, env=env)
    except KeyboardInterrupt:
        return 130
    finally:
        if traffic is not None:
            traffic.terminate()
            traffic.wait()


if __name__ == "__main__":
    sys.exit(main())

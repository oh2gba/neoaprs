{
  "name": "neoaprs-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The page of NeoAPRS: Vue 3 + TypeScript, built with Vite into ../neoaprs/page",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dup": "jscpd",
    "knip": "knip",
    "protocol": "../.venv/bin/python ../scripts/gen-protocol.py"
  },
  "dependencies": {
    "maplibre-gl": "6.14.0",
    "pmtiles": "4.5.0",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "18.19.130",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/coverage-v8": "2.1.8",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-vue": "9.33.0",
    "globals": "17.13.0",
    "happy-dom": "15.11.7",
    "jscpd": "3.5.10",
    "knip": "5.88.1",
    "prettier": "3.9.10",
    "typescript": "5.6.3",
    "typescript-eslint": "8.71.1",
    "vite": "6.4.4",
    "vitest": "2.1.8",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "2.1.10"
  }
}
